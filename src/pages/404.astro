---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";
---
<BaseLayout title={`Page introuvable - ${siteConfig.shortName}`} noindex={true}>
  <div class="ui5-page">
    <section class="ui5-section">
      <div class="ui5-card ui5-empty ui5-404">
        <span class="ui5-empty__icon" aria-hidden="true">?</span>
        <h1>404 — Page introuvable</h1>
        <p>Cette page n’existe pas ou a été déplacée.</p>
        <div class="ui5-filter-row">
          <a class="ui5-button ui5-button--primary" href="/">Retour à l’accueil</a>
          <a class="ui5-button" href="/#global-search">Rechercher</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
