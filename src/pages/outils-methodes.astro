---
import BaseLayout from "../layouts/BaseLayout.astro";

const spaces = [
  { mark: "C", title: "Collège", href: "/outils-methodes/college", description: "Méthodes de calcul, conversions, formules et outils adaptés au collège.", label: "Voir les outils collège" },
  { mark: "L", title: "Lycée", href: "/outils-methodes/lycee", description: "Méthodes numériques, Python, mathématiques utiles et ressources de lycée.", label: "Voir les outils lycée" },
  { mark: "T", title: "Transverses", href: "/outils-methodes/transverses", description: "Ressources utilisables dans plusieurs niveaux, du collège au lycée.", label: "Voir les ressources transverses" },
];
---

<BaseLayout
  title="Outils & méthodes"
  description="Espace central pour les outils et méthodes, séparés entre collège, lycée et ressources transverses."
  canonical="/outils-methodes"
  resourceType="tool"
  subject="transversal"
>
  <div class="ui5-page">
    <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">/</span><strong>Outils et méthodes</strong>
    </nav>

    <header class="ui5-page-header">
      <div class="ui5-page-header__copy">
        <p class="ui5-kicker">Ressources de travail</p>
        <h1 class="ui5-title">Outils et méthodes</h1>
        <p class="ui5-lead">Les méthodes expliquent comment faire ; les outils permettent de calculer, vérifier, tracer ou manipuler.</p>
      </div>
      <p class="ui5-page-header__aside">{spaces.length} espaces de ressources</p>
    </header>

    <section class="ui5-section" aria-labelledby="tools-spaces-title">
      <div class="ui5-section-head">
        <h2 id="tools-spaces-title">Choisir un espace</h2>
        <p>Entre par ton niveau ou par une ressource transverse.</p>
      </div>
      <div class="ui5-grid ui5-grid--2">
        {spaces.map((space) => (
          <a class="ui5-card ui5-resource-card" href={space.href}>
            <span class="ui5-level-card__badge" aria-hidden="true">{space.mark}</span>
            <h3>{space.title}</h3>
            <p>{space.description}</p>
            <span class="ui5-card__cta">{space.label} →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="ui5-section">
      <div class="ui5-card ui5-tools-row">
        <div>
          <h2>Kit scientifique</h2>
          <p>Conversions, calculs, graphiques, mesures et méthodes de Physique-Chimie.</p>
        </div>
        <a class="ui5-button ui5-button--primary" href="/outils-methodes/kit-scientifique">Ouvrir le kit</a>
      </div>
    </section>
  </div>
</BaseLayout>
