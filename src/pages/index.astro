---
import "../ui-v5/react-GlobalSearch.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import GlobalSearch from "../components/search/GlobalSearch";
import { labApps } from "../data/laboratoire/apps";
import { getGlobalSearchCatalogue } from "../data/globalSearchResources";

const allFlash = import.meta.glob("/src/data/chapters/**/flashcards.json", { eager: true });
const { resources, publishedMathLevels, publishedMathChapters } = getGlobalSearchCatalogue();

const mathChapterCount = publishedMathChapters.length;
const publishedMathLevelLabels = publishedMathLevels.map((level) => level.label);
const mathCoverageText = publishedMathLevelLabels.length === 0
  ? "Les contenus de mathématiques seront publiés progressivement."
  : publishedMathLevelLabels.length === 1
    ? `${mathChapterCount} chapitres actuellement publiés en ${publishedMathLevelLabels[0]}.`
    : `${mathChapterCount} chapitres actuellement publiés pour ${publishedMathLevelLabels.slice(0, -1).join(", ")} et ${publishedMathLevelLabels[publishedMathLevelLabels.length - 1]}.`;

const publishedLevelCount = new Set(resources.map((resource) => `${resource.subject}:${resource.cycle}:${resource.levelLabel}`)).size;
const labCount = labApps.filter((app) => app.status === "migrated").length;
const hasFlashcards = Object.keys(allFlash).length > 0;

const subjects = [
  {
    mark: "∑",
    title: "Mathématiques",
    text: mathCoverageText,
    href: "/mathematiques",
    subject: "mathematiques",
  },
  {
    mark: "PC",
    title: "Physique-Chimie",
    text: "Cours et ressources du collège au lycée, avec l’Enseignement scientifique et le laboratoire.",
    href: "/physique-chimie",
    subject: "physique-chimie",
  },
];

const learningSteps = [
  ["1", "Comprendre", "Cours et schémas"],
  ["2", "S’entraîner", "Exercices progressifs"],
  ["3", "Tester", "Quiz et feedback"],
  ["4", "Réviser", hasFlashcards ? "Flashcards et mémorisation" : "Reprises ciblées"],
  ["5", "Expérimenter", "Simulations et laboratoire"],
];
---

<BaseLayout
  title="Révisions Maths & Physique-Chimie - cours, exercices, quiz et laboratoires"
  description="Cours, exercices, quiz, flashcards et laboratoires en Mathématiques, Physique-Chimie et Enseignement scientifique."
  subject="transversal"
>
  <div class="ui5-page ui5-home">
    <header class="ui5-home-hero">
      <div>
        <p class="ui5-kicker">Mathématiques · Physique-Chimie</p>
        <h1 class="ui5-title">Comprendre, s’entraîner et réviser</h1>
        <p class="ui5-lead">Une seule interface pour travailler les sciences et les mathématiques du collège au lycée, avec des contenus organisés par programme.</p>
        <div class="ui5-home-hero__actions">
          <a class="ui5-button ui5-button--primary" href="#matieres">Choisir une matière</a>
          <a class="ui5-button" href="#global-search">Rechercher un chapitre</a>
        </div>
      </div>
      <dl class="ui5-home-hero__stats">
        <div><dt>{resources.length}</dt><dd>chapitres publiés</dd></div>
        <div><dt>{publishedLevelCount}</dt><dd>niveaux couverts</dd></div>
        <div><dt>{labCount}</dt><dd>laboratoires et outils</dd></div>
      </dl>
    </header>

    <section id="global-search" class="ui5-section ui5-home-search" aria-label="Recherche globale">
      <div class="ui5-section-head">
        <h2>Rechercher</h2>
        <p>Cherche un chapitre, une notion ou un thème dans les contenus publiés.</p>
      </div>
      <GlobalSearch client:load resourceUrl="/search-index.json" resourceCount={resources.length} />
    </section>

    <section id="matieres" class="ui5-section" aria-labelledby="subjects-title">
      <div class="ui5-section-head">
        <h2 id="subjects-title">Choisir une matière</h2>
        <p>Deux portes d’entrée, le même fonctionnement.</p>
      </div>
      <div class="ui5-grid ui5-grid--2">
        {subjects.map((subject) => (
          <a class="ui5-card ui5-subject-card" data-subject={subject.subject} href={subject.href}>
            <span class="ui5-subject-card__mark" aria-hidden="true">{subject.mark}</span>
            <strong>{subject.title}</strong>
            <span>{subject.text}</span>
            <em>Explorer →</em>
          </a>
        ))}
      </div>
    </section>

    <section class="ui5-section" aria-labelledby="method-title">
      <div class="ui5-section-head">
        <h2 id="method-title">Un parcours de travail constant</h2>
        <p>Tu retrouves la même logique dans chaque chapitre.</p>
      </div>
      <ol class="ui5-learning-steps">
        {learningSteps.map(([number,title,text]) => (
          <li>
            <span>{number}</span>
            <div><strong>{title}</strong><small>{text}</small></div>
          </li>
        ))}
      </ol>
    </section>
  </div>
</BaseLayout>
