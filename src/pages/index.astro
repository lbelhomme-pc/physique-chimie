---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlobalSearch, { type GlobalSearchResource } from "../components/search/GlobalSearch";
import { getLevelDisplayLabel } from "../utils/levels";
import { getMatiereLabel } from "../data/levels";
import { getPublishedMathematicsLevels } from "../data/contentRoutes";
import { chapterEntryFromGlob } from "../data/mathematiques/content";
import { getMathematicsLevelsByCycle } from "../data/mathematiques/levels";
import { labApps } from "../data/laboratoire/apps";

const allMeta = import.meta.glob("/src/data/chapters/**/meta.json", { eager: true });
const allFlash = import.meta.glob("/src/data/chapters/**/flashcards.json", { eager: true });
const allMathMeta = import.meta.glob("/src/data/mathematiques/chapters/**/meta.json", { eager: true });

const resources: GlobalSearchResource[] = [];

for (const [path, mod] of Object.entries(allMeta)) {
  const [cycle, niveau, matiere, slug] = path
    .replace("/src/data/chapters/", "")
    .replace("/meta.json", "")
    .split("/");
  if ((cycle !== "college" && cycle !== "lycee") || !niveau || !matiere || !slug) continue;
  const data = (mod as any).default ?? mod;
  const matiereLabel = getMatiereLabel(matiere);
  const isScientificEducation =
    data.disciplineIdentity === "enseignement-scientifique" ||
    niveau.includes("ens-scientifique");
  resources.push({
    id: data.canonicalId ?? `physique-chimie:${cycle}:${niveau}:${matiere}:${slug}`,
    title: data.title ?? slug,
    description: data.description,
    path: `/${cycle}/${niveau}/${matiere}/${slug}`,
    slug,
    keywords: data.keywords ?? data.tags ?? [],
    cycle,
    levelLabel: getLevelDisplayLabel(niveau),
    subject: "physique-chimie",
    subjectLabel: isScientificEducation ? "Physique-Chimie — Enseignement scientifique" : "Physique-Chimie",
    matiereLabel,
    resourceType: "chapter",
    accessTier: data.access?.tier ?? "free",
  });
}

const mathChapters = Object.entries(allMathMeta)
  .map(([path, mod]) => chapterEntryFromGlob(path, mod))
  .filter((chapter): chapter is NonNullable<typeof chapter> => Boolean(chapter));

const publishedMathLevels = [
  ...getPublishedMathematicsLevels(getMathematicsLevelsByCycle("college"), mathChapters),
  ...getPublishedMathematicsLevels(getMathematicsLevelsByCycle("lycee"), mathChapters),
];
const publishedMathLevelKeys = new Set(publishedMathLevels.map((level) => `${level.cycle}:${level.slug}`));
const publishedMathChapters = mathChapters.filter((chapter) =>
  publishedMathLevelKeys.has(`${chapter.cycle}:${chapter.niveau}`),
);

for (const chapter of publishedMathChapters) {
  resources.push({
    id: `mathematiques:${chapter.cycle}:${chapter.niveau}:${chapter.slug}`,
    title: chapter.title,
    description: chapter.description,
    path: chapter.path,
    slug: chapter.slug,
    keywords: chapter.tags ?? [],
    cycle: chapter.cycle,
    levelLabel: getLevelDisplayLabel(chapter.niveau),
    subject: "mathematiques",
    subjectLabel: "Mathématiques",
    resourceType: "chapter",
    accessTier: "free",
  });
}

const mathChapterCount = publishedMathChapters.length;
const publishedMathLevelLabels = publishedMathLevels.map((level) => level.label);
const mathCoverageText = publishedMathLevelLabels.length === 0
  ? "Les contenus de mathématiques seront publiés progressivement."
  : publishedMathLevelLabels.length === 1
    ? `${mathChapterCount} chapitres actuellement publiés en ${publishedMathLevelLabels[0]}.`
    : `${mathChapterCount} chapitres actuellement publiés pour ${publishedMathLevelLabels.slice(0, -1).join(", ")} et ${publishedMathLevelLabels[publishedMathLevelLabels.length - 1]}.`;

const publishedLevelCount = new Set(resources.map((resource) => `${resource.subject}:${resource.cycle}:${resource.levelLabel}`)).size;
const labCount = labApps.filter((app) => app.status === "migrated").length;
const hasFlashcards = Object.keys(allFlash).length > 0;

const subjectCards = [
  {
    title: "Mathématiques",
    text: mathCoverageText,
    href: "/mathematiques",
    tone: "maths",
    icon: "atom",
  },
  {
    title: "Physique-Chimie",
    text: "Cours et ressources publiés du collège au lycée, avec un espace dédié à l’Enseignement scientifique.",
    href: "/physique-chimie",
    tone: "pc",
    icon: "flask",
  },
];

const methodSteps = [
  { title: "Comprendre", text: "Cours et schémas", icon: "book" },
  { title: "S'entraîner", text: "Exercices progressifs et corrigés", icon: "target" },
  { title: "Tester", text: "Quiz pour valider ses acquis", icon: "spark" },
  { title: "Réviser", text: hasFlashcards ? "Flashcards et mémos de révision" : "Mémos et reprises ciblées", icon: "clipboard" },
  { title: "Expérimenter", text: "Simulations et labo interactifs", icon: "flask" },
];

---

<BaseLayout
  title="Cours Physique-Maths - cours, exercices, quiz et laboratoires"
  description="Cours, exercices, quiz et laboratoires en Physique-Chimie, Enseignement scientifique et Mathématiques, selon les niveaux actuellement publiés."
  subject="transversal"
>
  <div class="home-v3">
    <section class="hero-reference" aria-labelledby="home-title">
      <div class="hero-reference__copy">
        <h1 id="home-title" class="sr-only">
          <span>Comprendre, s'entraîner, réviser et expérimenter</span>
        </h1>
        <p>
          Des ressources en mathématiques, physique-chimie et enseignement scientifique. Les niveaux affichés correspondent aux contenus effectivement publiés.
        </p>
        <div class="hero-reference__actions" aria-label="Actions principales">
          <a class="btn btn--primary" href="#plateforme">Choisir une matière</a>
          <a class="btn btn--secondary" href="#recherche">Rechercher un chapitre</a>
        </div>
      </div>

      <div class="hero-reference__visual">
        <picture>
          <source srcset="/images/accueil-v3-hero-sciences-2026-07-27.webp" type="image/webp" />
          <img
            src="/images/accueil-v3-hero-sciences-2026-07-27.png"
            alt="Bureau d'étude avec ordinateur, verrerie de chimie, schémas mathématiques et montage électrique scolaire."
            width="1600"
            height="762"
            loading="eager"
            decoding="async"
          />
        </picture>
        <div class="hero-reference__glow"></div>
        <div class="hero-reference__formula hero-reference__formula--one">U = R × I</div>
        <div class="hero-reference__formula hero-reference__formula--two">f(x)</div>
      </div>

    </section>

    <section id="recherche" class="search-reference" aria-label="Recherche globale">
      <GlobalSearch client:load resources={resources} />
    </section>

    <section id="plateforme" class="subjects-reference" aria-labelledby="subjects-title">
      <div class="section-title">
        <h2 id="subjects-title">Deux matières, une seule expérience</h2>
        <p>Les cartes ci-dessous reflètent uniquement les contenus actuellement publiés.</p>
      </div>
      <div class="subject-cards" data-subject-switcher>
        {subjectCards.map((card) => (
          <a class={`subject-card subject-card--${card.tone}`} href={card.href} data-subject-card={card.tone === "maths" ? "mathematiques" : "physique-chimie"}>
            <span class={`big-icon line-icon line-icon--${card.icon}`} aria-hidden="true"></span>
            <strong>{card.title}</strong>
            <small>{card.text}</small>
            <em>Explorer →</em>
          </a>
        ))}
      </div>
    </section>

    <section class="method-reference" aria-labelledby="method-title">
      <div class="section-title">
        <h2 id="method-title">Un parcours pour apprendre et réviser</h2>
        <p>Cours, exercices, quiz, flashcards et simulations selon les ressources disponibles.</p>
      </div>
      <div class="method-steps">
        {methodSteps.map((step) => (
          <article>
            <span class={`step-icon line-icon line-icon--${step.icon}`} aria-hidden="true"></span>
            <div>
              <strong>{step.title}</strong>
              <small>{step.text}</small>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="stats-reference" aria-labelledby="stats-title">
      <div>
        <h2 id="stats-title">Ce qui est actuellement publié</h2>
        <p>Les compteurs ci-dessous sont calculés à partir des ressources actuellement disponibles sur le site.</p>
      </div>
      <dl>
        <div>
          <dt>{resources.length}</dt>
          <dd>chapitres publiés</dd>
        </div>
        <div>
          <dt>{publishedLevelCount}</dt>
          <dd>niveaux couverts</dd>
        </div>
        <div>
          <dt>{labCount}</dt>
          <dd>laboratoires et outils</dd>
        </div>
      </dl>
    </section>

    <section id="blog" class="sr-only" aria-label="Blog">
      Blog à venir.
    </section>
  </div>
</BaseLayout>

<style>
  :global(body) {
    background: #ffffff;
  }

  :global(.page-container:has(.home-v3)) {
    max-width: none;
    padding: 0;
  }

  .home-v3 {
    --ref-blue: #0f5bff;
    --ref-navy: #00184d;
    --ref-text: #061849;
    --ref-muted: #52617c;
    --ref-border: #d9e6fb;
    --ref-panel: #f7fbff;
    background: #fff;
    color: var(--ref-text);
    font-family: "Plus Jakarta Sans", Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    min-width: 0;
  }

  .hero-reference {
    background:
      linear-gradient(90deg, #ffffff 0%, #ffffff 36%, rgba(223, 239, 255, 0.88) 62%, rgba(207, 231, 255, 0.94) 100%);
    border-bottom: 1px solid #dce8f8;
    display: grid;
    grid-template-columns: minmax(320px, 0.88fr) minmax(420px, 1.12fr);
    min-height: 520px;
    overflow: hidden;
    padding: 4.35rem max(3rem, calc((100vw - 1180px) / 2)) 3.6rem;
    position: relative;
  }

  .hero-reference__copy {
    align-self: center;
    display: grid;
    gap: 1.6rem;
    max-width: 520px;
    position: relative;
    z-index: 2;
  }

  .hero-reference h1 {
    color: var(--ref-navy);
    display: grid;
    font-size: clamp(3.2rem, 5.2vw, 5rem);
    font-weight: 950;
    letter-spacing: 0;
    line-height: 0.98;
    margin: 0;
  }

  .hero-reference h1 span:last-child {
    color: var(--ref-blue);
  }

  .hero-reference p {
    color: var(--ref-text);
    font-size: 1.08rem;
    font-weight: 650;
    line-height: 1.58;
    margin: 0;
    max-width: 49ch;
  }

  .hero-reference__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .btn {
    align-items: center;
    border-radius: 999px;
    display: inline-flex;
    font-size: 0.9rem;
    font-weight: 850;
    justify-content: center;
    min-height: 46px;
    padding: 0 1.7rem;
    text-decoration: none;
  }

  .btn--primary {
    background: var(--ref-blue);
    box-shadow: 0 16px 34px rgba(15, 91, 255, 0.24);
    color: #fff;
  }

  .btn--secondary {
    background: #fff;
    border: 1.5px solid var(--ref-blue);
    color: var(--ref-blue);
  }

  .hero-reference__visual {
    inset: 0 0 0 36%;
    overflow: hidden;
    position: absolute;
    z-index: 0;
  }

  .hero-reference__visual img {
    height: 100%;
    object-fit: cover;
    object-position: center right;
    opacity: 0.96;
    width: 100%;
  }

  .hero-reference__visual picture {
    display: block;
    height: 100%;
    width: 100%;
  }

  .hero-reference__visual::before,
  .hero-reference__visual::after {
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 999px;
    content: "";
    position: absolute;
  }

  .hero-reference__visual::before {
    height: 125px;
    right: 8%;
    top: 14%;
    width: 125px;
  }

  .hero-reference__visual::after {
    border-radius: 12px;
    height: 92px;
    right: 34%;
    top: 15%;
    width: 118px;
  }

  .hero-reference__glow {
    background: radial-gradient(circle, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0) 66%);
    height: 130%;
    left: -18%;
    position: absolute;
    top: -15%;
    width: 52%;
  }

  .hero-reference__formula {
    border: 1px solid rgba(255, 255, 255, 0.6);
    color: rgba(255, 255, 255, 0.86);
    font-weight: 850;
    padding: 0.45rem 0.65rem;
    position: absolute;
  }

  .hero-reference__formula--one {
    right: 18%;
    top: 22%;
  }

  .hero-reference__formula--two {
    right: 48%;
    top: 30%;
  }

  .line-icon {
    --icon-color: var(--ref-blue);
    border: 2px solid currentColor;
    color: var(--icon-color);
    display: inline-grid;
    height: 30px;
    place-items: center;
    width: 30px;
  }

  .line-icon::before {
    font-size: 0.92rem;
    font-weight: 950;
    line-height: 1;
  }

  .line-icon--book::before { content: "□"; }
  .line-icon--target::before { content: "✓"; }
  .line-icon--spark::before { content: "✦"; }
  .line-icon--flask::before { content: "⚗"; }
  .line-icon--clipboard::before { content: "▤"; }
  .line-icon--atom::before { content: "∞"; }

  .subjects-reference,
  .method-reference,
  .stats-reference {
    margin: 0 auto;
    max-width: 1080px;
  }

  .subjects-reference {
    padding: 5.6rem 2rem 2.4rem;
  }

  .search-reference {
    background: #f4f8ff;
    border-bottom: 1px solid #dce8f8;
    margin: 0;
    max-width: none;
    padding: 4rem max(1.5rem, calc((100vw - 1080px) / 2));
  }

  .section-title {
    display: grid;
    gap: 0.35rem;
    justify-items: center;
    text-align: center;
  }

  .section-title h2 {
    color: var(--ref-navy);
    font-size: clamp(1.45rem, 2.2vw, 2rem);
    font-weight: 950;
    letter-spacing: 0;
    line-height: 1.1;
    margin: 0;
  }

  .section-title p {
    color: var(--ref-muted);
    font-size: 0.95rem;
    font-weight: 650;
    margin: 0;
  }

  .subject-cards {
    display: grid;
    gap: 3.2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 2.8rem;
  }

  .subject-card {
    align-items: center;
    background: linear-gradient(135deg, #f7faff, #ffffff);
    border: 1px solid var(--ref-border);
    border-radius: 16px;
    color: var(--ref-text);
    display: grid;
    justify-items: center;
    min-height: 190px;
    padding: 2rem;
    text-align: center;
    text-decoration: none;
  }

  .subject-card--maths { --card-color: #135dff; background: linear-gradient(135deg, #f2f6ff, #ffffff); }
  .subject-card--pc { --card-color: #6947e8; background: linear-gradient(135deg, #f7f2ff, #ffffff); }

  .big-icon {
    --icon-color: var(--card-color);
    border: 0;
    font-size: 2.25rem;
    height: 42px;
    width: 42px;
  }

  .big-icon::before {
    font-size: 2rem;
  }

  .subject-card strong {
    color: var(--card-color);
    font-size: 1.2rem;
    font-weight: 950;
    line-height: 1.1;
  }

  .subject-card small {
    color: #40506c;
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.45;
    max-width: 32ch;
  }

  .subject-card em {
    color: var(--card-color);
    font-size: 0.78rem;
    font-style: normal;
    font-weight: 900;
  }

  .method-reference {
    padding: 1.4rem 2rem 3.2rem;
  }

  .method-steps {
    align-items: center;
    display: grid;
    gap: 1.1rem;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: 2rem;
  }

  .method-steps article {
    align-items: center;
    display: grid;
    gap: 0.65rem;
    grid-template-columns: auto minmax(0, 1fr);
    position: relative;
  }

  .method-steps article:not(:last-child)::after {
    color: #0f5bff;
    content: "›";
    font-size: 1.7rem;
    font-weight: 800;
    position: absolute;
    right: -0.7rem;
  }

  .step-icon {
    background: #edf4ff;
    border: 0;
    border-radius: 999px;
    height: 54px;
    width: 54px;
  }

  .method-steps article:nth-child(2) .step-icon { --icon-color: #16b98d; background: #eafaf4; }
  .method-steps article:nth-child(3) .step-icon { --icon-color: #6d4cff; background: #f0edff; }
  .method-steps article:nth-child(4) .step-icon { --icon-color: #f05c3c; background: #fff0eb; }

  .method-steps strong {
    color: var(--ref-navy);
    display: block;
    font-size: 0.9rem;
    font-weight: 950;
  }

  .method-steps small {
    color: #40506c;
    display: block;
    font-size: 0.75rem;
    font-weight: 650;
    line-height: 1.25;
  }

  .stats-reference {
    align-items: center;
    background: linear-gradient(100deg, #f8fbff, #ffffff);
    border: 1px solid #cdddf6;
    border-radius: 16px;
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr) auto;
    margin-bottom: 2.4rem;
    padding: 2rem 2.4rem;
  }

  .stats-reference h2 {
    color: var(--ref-navy);
    font-size: 1.45rem;
    font-weight: 950;
    line-height: 1.15;
    margin: 0 0 0.7rem;
    max-width: 26ch;
  }

  .stats-reference p {
    color: var(--ref-muted);
    font-size: 0.9rem;
    font-weight: 650;
    line-height: 1.5;
    margin: 0;
    max-width: 52ch;
  }

  .stats-reference dl {
    display: grid;
    gap: 3rem;
    grid-template-columns: repeat(3, auto);
    margin: 0;
  }

  .stats-reference dt {
    color: var(--ref-blue);
    font-size: 2rem;
    font-weight: 950;
    line-height: 1;
  }

  .stats-reference dd {
    color: var(--ref-text);
    font-size: 0.78rem;
    font-weight: 850;
    margin: 0.35rem 0 0;
  }

  .sr-only {
    clip: rect(0, 0, 0, 0);
    border: 0;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  @media (max-width: 980px) {
    .hero-reference {
      grid-template-columns: 1fr;
      padding: 3rem 1.5rem 5rem;
    }

    .hero-reference__visual {
      inset: 0;
      opacity: 0.28;
    }

    .hero-reference__copy {
      max-width: 620px;
    }

    .subject-cards,
    .method-steps,
    .stats-reference,
    .stats-reference dl {
      grid-template-columns: 1fr;
    }

    .subject-cards {
      gap: 1rem;
    }

    .method-steps article:not(:last-child)::after {
      display: none;
    }

    .stats-reference dl {
      gap: 1.2rem;
    }
  }

  @media (max-width: 560px) {
    .hero-reference {
      min-height: 0;
      padding: 2.4rem 1rem 5.5rem;
    }

    .hero-reference h1 {
      font-size: clamp(2.7rem, 14vw, 3.5rem);
    }

    .hero-reference p {
      font-size: 0.98rem;
    }

    .hero-reference__actions,
    .btn {
      width: 100%;
    }

    .subjects-reference,
    .method-reference {
      padding-inline: 1rem;
    }

    .search-reference {
      padding: 2.5rem 1rem;
    }

    .stats-reference {
      border-radius: 0;
      margin-bottom: 0;
      padding: 1.5rem;
    }
  }
</style>