---
import LabAppLayout from "../../components/laboratoire/LabAppLayout.astro";
import GenericLabSimulator from "../../components/laboratoire/GenericLabSimulator.astro";
import RadioactiveDecaySimulator from "../../components/laboratoire/RadioactiveDecaySimulator.astro";
import TitrationPhSimulator from "../../components/laboratoire/TitrationPhSimulator.astro";
import { labApps } from "../../data/laboratoire/apps";
import { genericLabConfigs } from "../../data/laboratoire/genericConfigs";

export function getStaticPaths() {
  const dynamicApps = labApps.filter((app) => app.renderer !== "explicit-page");
  return dynamicApps.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

const { app } = Astro.props;
const usesDedicatedTitrationPhSimulator = app.renderer === "dedicated-component" && app.simKind === "titration-ph";
const usesDedicatedRadioactiveDecaySimulator = app.renderer === "dedicated-component" && app.simKind === "decay";
const config = genericLabConfigs[app.slug];

if (!usesDedicatedTitrationPhSimulator && !usesDedicatedRadioactiveDecaySimulator && !config) {
  throw new Error(`Configuration manquante pour la simulation "${app.slug}".`);
}
---

<LabAppLayout
  slug={app.slug}
  title={app.title}
  description={app.objective}
  icon={app.icon}
  level={app.level}
  concept={app.concept}
  objective={app.objective}
  legacyPath={app.legacyPath}
>
  {usesDedicatedTitrationPhSimulator
    ? <TitrationPhSimulator />
    : usesDedicatedRadioactiveDecaySimulator
      ? <RadioactiveDecaySimulator />
      : config && <GenericLabSimulator app={app} config={config} />}
</LabAppLayout>
