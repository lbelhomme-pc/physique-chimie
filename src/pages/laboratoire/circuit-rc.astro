---
import LabAppLayout from "../../components/laboratoire/LabAppLayout.astro";
import { labApps } from "../../data/laboratoire/apps";

const app = labApps.find((item) => item.slug === "circuit-rc")!;
---

<LabAppLayout
  title={app.title}
  description={app.objective}
  icon={app.icon}
  level={app.level}
  concept={app.concept}
  objective={app.objective}
  legacyPath={app.legacyPath}
>
  <section class="lab-grid lab-grid--balanced" data-lab-app="circuit-rc">
    <aside>
      <section class="lab-panel" aria-labelledby="rc-parametres">
        <h2 class="lab-panel__title" id="rc-parametres">Paramètres</h2>
        <p class="lab-panel__subtitle">Change E, R ou C : la constante de temps et la forme de la courbe se recalculent aussitôt.</p>

        <div class="lab-control">
          <label for="slider-e">Tension du générateur E : <span class="lab-value" id="val-e">5</span> V</label>
          <input id="slider-e" type="range" min="1" max="12" step="1" value="5" />
        </div>

        <div class="lab-control">
          <label for="slider-r">Résistance R : <span class="lab-value" id="val-r">10</span> kΩ</label>
          <input id="slider-r" type="range" min="1" max="100" step="1" value="10" />
        </div>

        <div class="lab-control">
          <label for="slider-c">Capacité C : <span class="lab-value" id="val-c">100</span> μF</label>
          <input id="slider-c" type="range" min="10" max="1000" step="10" value="100" />
        </div>

        <div class="lab-control">
          <label for="slider-speed">Vitesse de lecture : <span class="lab-value" id="val-speed">1,0</span>x</label>
          <input id="slider-speed" type="range" min="0.3" max="2.5" step="0.1" value="1" />
        </div>

        <div class="lab-readout" aria-live="polite">
          Constante de temps : <strong id="val-tau">1,00 s</strong>
        </div>

        <div class="rc-key-grid" aria-label="Repères de lecture du dipôle RC">
          <div>
            <span>5τ</span>
            <strong id="val-five-tau">5,00 s</strong>
          </div>
          <div>
            <span>uC(τ)</span>
            <strong id="val-uc-tau">3,16 V</strong>
          </div>
        </div>
      </section>

      <section class="lab-panel" aria-labelledby="rc-mode">
        <h2 class="lab-panel__title" id="rc-mode">Commutateur</h2>
        <div class="lab-button-row" role="group" aria-label="Choix du mode du dipôle RC">
          <button class="lab-button is-active" id="btn-charge" type="button" aria-pressed="true">Charge</button>
          <button class="lab-button" id="btn-discharge" type="button" aria-pressed="false">Décharge</button>
          <button class="lab-button" id="btn-rc-toggle" type="button" aria-pressed="false">Pause</button>
          <button class="lab-button danger" id="btn-rc-reset" type="button">Recommencer</button>
        </div>
        <div class="lab-control rc-time-control">
          <label for="slider-time">Curseur temps : <span class="lab-value" id="time-display">0,00</span> s</label>
          <input id="slider-time" type="range" min="0" max="1000" step="1" value="0" />
        </div>
        <p class="lab-note">À t = τ, la charge atteint environ 63 % de E. À 5τ, le régime transitoire est presque terminé.</p>
      </section>

      <section class="lab-panel" aria-labelledby="rc-modele">
        <h2 class="lab-panel__title" id="rc-modele">Modèle</h2>
        <div id="math-charge" class="lab-formula">
          Charge : u<sub>C</sub>(t) = E × (1 − e<sup>−t/τ</sup>)
        </div>
        <div id="math-discharge" class="lab-formula" hidden>
          Décharge : u<sub>C</sub>(t) = U<sub>C,0</sub> × e<sup>−t/τ</sup>
        </div>
        <div class="rc-curve-options" aria-label="Courbes affichées">
          <label><input id="toggle-uc" type="checkbox" checked /> u<sub>C</sub></label>
          <label><input id="toggle-ur" type="checkbox" checked /> u<sub>R</sub></label>
          <label><input id="toggle-tangent" type="checkbox" checked /> tangente</label>
        </div>
      </section>

      <section class="lab-panel" aria-labelledby="rc-observation-title">
        <h2 class="lab-panel__title" id="rc-observation-title">Observation</h2>
        <div class="lab-readout" id="rc-observation" aria-live="polite">
          Lance la charge pour suivre la tension aux bornes du condensateur.
        </div>
        <div class="rc-mission" aria-live="polite">
          <strong>À observer</strong>
          <span id="rc-mission-text">Repère τ : la courbe bleue doit atteindre environ 63 % de la tension finale.</span>
        </div>
      </section>
    </aside>

    <div class="lab-stage">
      <section class="lab-panel rc-schematic" aria-labelledby="rc-schema">
        <div class="lab-chip-row">
          <span class="lab-pill" id="mode-pill">Mode : charge</span>
          <span class="lab-pill">Courant conventionnel</span>
          <span class="lab-pill">Électrons en bleu</span>
          <span class="lab-pill rc-current-pill" id="current-pill">i > 0</span>
        </div>
        <h2 class="lab-panel__title" id="rc-schema">Schéma du montage</h2>
        <svg class="rc-circuit-svg" viewBox="0 0 640 300" role="img" aria-labelledby="rc-svg-title rc-svg-desc">
          <title id="rc-svg-title">Circuit RC série</title>
          <desc id="rc-svg-desc">Un générateur, un commutateur, une résistance et un condensateur en série, avec charges sur les armatures et électrons dans les fils.</desc>
          <defs>
            <marker id="rc-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M 0 0 L 10 5 L 0 10 z" fill="#f59e0b"></path>
            </marker>
          </defs>
          <path class="wire" d="M95 220 L95 80 L145 80"></path>
          <path class="wire" d="M205 120 L235 120"></path>
          <path class="wire" d="M375 120 L410 120"></path>
          <path class="wire" d="M440 120 L520 120 L520 220 L95 220"></path>
          <path class="wire" d="M145 160 L145 220"></path>
          <line class="component" x1="78" y1="108" x2="78" y2="192"></line>
          <line class="component" x1="100" y1="95" x2="100" y2="205"></line>
          <text x="42" y="158">E</text>
          <circle class="node" cx="145" cy="80" r="7"></circle>
          <circle class="node" cx="145" cy="160" r="7"></circle>
          <circle class="node" cx="205" cy="120" r="7"></circle>
          <line class="switch-blade" id="switch-blade" x1="205" y1="120" x2="145" y2="80"></line>
          <text x="164" y="55">K</text>
          <polyline class="component" points="235,120 250,100 265,140 280,100 295,140 310,100 325,140 340,100 355,140 375,120"></polyline>
          <text x="295" y="82">R</text>
          <text x="279" y="166" class="rc-small-label" id="ur-label">uR = 0,00 V</text>
          <line class="component" x1="410" y1="88" x2="410" y2="152"></line>
          <line class="component" x1="440" y1="88" x2="440" y2="152"></line>
          <text x="455" y="92">C</text>
          <text x="455" y="174" class="rc-small-label" id="uc-label">uC = 0,00 V</text>
          <g class="rc-svg-charge-layer" id="plate-positive-charges" aria-hidden="true"></g>
          <g class="rc-svg-charge-layer" id="plate-negative-charges" aria-hidden="true"></g>
          <g class="rc-electron-layer" id="electron-layer" aria-hidden="true"></g>
          <text x="364" y="68" class="rc-small-label rc-charge-state" id="charge-state-label">condensateur déchargé</text>
          <text x="374" y="194" class="rc-small-label rc-electron-note" id="electron-hint">e− : sens opposé à i</text>
          <line class="current-arrow" id="current-arrow" x1="255" y1="48" x2="350" y2="48" marker-end="url(#rc-arrow)"></line>
          <text x="300" y="38" id="current-label">i</text>
        </svg>
      </section>

      <section class="lab-panel" aria-labelledby="rc-mesures">
        <h2 class="lab-panel__title" id="rc-mesures">Mesures instantanées</h2>
        <div class="rc-meter-grid">
          <div class="rc-meter-card rc-meter-card--primary"><span>uC</span><strong id="val-uc-now">0,00 V</strong></div>
          <div class="rc-meter-card rc-meter-card--success"><span>uR</span><strong id="val-ur-now">5,00 V</strong></div>
          <div class="rc-meter-card rc-meter-card--warning"><span>i</span><strong id="val-i-now">0,50 mA</strong></div>
          <div class="rc-meter-card"><span>Énergie stockée</span><strong id="val-energy-now">0,00 mJ</strong></div>
        </div>
        <div class="rc-progress" aria-label="Avancement de la charge du condensateur">
          <div class="rc-progress__bar"><span id="rc-progress-fill"></span></div>
          <strong id="val-progress-now">0 %</strong>
        </div>
      </section>

      <section class="lab-panel" aria-labelledby="rc-graphe">
        <div class="lab-chip-row">
          <span class="lab-pill">Temps max : <span id="time-max-display">8,00</span> s</span>
          <span class="lab-pill">Repères : τ, 5τ, 63 %</span>
        </div>
        <h2 class="lab-panel__title" id="rc-graphe">Évolution temporelle</h2>
        <div class="lab-canvas-wrap">
          <canvas class="lab-canvas rc-graph-canvas" id="graphCanvas" aria-label="Courbes de uC et uR dans un dipôle RC"></canvas>
        </div>
      </section>
    </div>
  </section>

  <script>
    import "../../scripts/laboratoire/circuit-rc.js";
  </script>
</LabAppLayout>
