---
import LabAppLayout from "../../components/laboratoire/LabAppLayout.astro";
import KeplerLawsSimulator from "../../components/laboratoire/KeplerLawsSimulator.astro";
import { labApps } from "../../data/laboratoire/apps";

const app = labApps.find((item) => item.slug === "lois-kepler")!;
---

<LabAppLayout
  slug={app.slug}
  title={app.title}
  description={app.objective}
  icon={app.icon}
  level={app.level}
  concept={app.concept}
  objective={app.objective}
  legacyPath={app.legacyPath}
>
  <KeplerLawsSimulator />
</LabAppLayout>
