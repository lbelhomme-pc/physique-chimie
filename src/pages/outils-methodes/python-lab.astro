---
import "../../ui-v5/tools/python-lab.css";
// src/pages/outils-methodes/python-lab.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import PyodideLab from "../../components/pedagogie/PyodideLab.tsx";
---

<BaseLayout
  title="Laboratoire Python - Physique-Chimie"
  description="Laboratoire Python interactif avec Pyodide pour tester de petits scripts de physique-chimie dans le navigateur."
  canonical="/outils-methodes/python-lab"
  schemaType="EducationalContent"
  subject="physique-chimie"
  resourceType="tool"
>
  <article class="ui5-page ui5-tool-document" data-subject="physique-chimie" id="top">
    <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">/</span>
      <a href="/outils-methodes">Outils et méthodes</a><span aria-hidden="true">/</span>
      <strong>Laboratoire Python</strong>
    </nav>
    <header class="ui5-page-header">
      <div class="ui5-page-header__copy">
        <p class="ui5-kicker">Outils et méthodes</p>
        <h1 class="ui5-title">Laboratoire Python</h1>
        <p class="ui5-lead">Teste de petits scripts pour exploiter des données de Physique-Chimie directement dans le navigateur.</p>
      </div>
      <div class="ui5-page-header__aside"><a class="ui5-button" href="/outils-methodes/cours-python">Cours Python</a></div>
    </header>

    <section class="lab-page-note" aria-labelledby="lab-warning-title">
      <h2 id="lab-warning-title">Avant de lancer Python</h2>
      <p>
        Le premier chargement peut prendre quelques secondes : Python est téléchargé dans le navigateur.
        Aucun code n'est envoyé à un serveur Python. Matplotlib est chargé seulement quand un exemple
        graphique en a besoin.
      </p>
    </section>

    <PyodideLab client:load />
  </article>
</BaseLayout>
