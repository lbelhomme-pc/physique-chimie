---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableauPeriodique from "../../components/pedagogie/TableauPeriodique.tsx";
---

<BaseLayout
  title="Tableau périodique interactif - Outils & méthodes"
  description="Tableau périodique interactif pour retrouver symbole, numéro atomique, masse approchée et informations utiles."
  canonical="/outils-methodes/tableau-periodique"
  schemaType="EducationalContent"
  subject="physique-chimie"
  resourceType="tool"
>
  <div class="ui5-page" data-subject="physique-chimie">
    <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">/</span>
      <a href="/outils-methodes">Outils et méthodes</a><span aria-hidden="true">/</span>
      <strong>Tableau périodique</strong>
    </nav>
    <header class="ui5-page-header">
      <div class="ui5-page-header__copy">
        <p class="ui5-kicker">Chimie</p>
        <h1 class="ui5-title">Tableau périodique interactif</h1>
        <p class="ui5-lead">Clique sur un élément ou utilise la recherche pour retrouver un nom, un symbole ou un numéro atomique.</p>
      </div>
    </header>
    <section class="ui5-section ui5-tool-workspace">
      <TableauPeriodique client:load />
    </section>
  </div>
</BaseLayout>
