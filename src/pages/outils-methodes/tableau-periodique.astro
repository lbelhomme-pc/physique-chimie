---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableauPeriodique from "../../components/pedagogie/TableauPeriodique.tsx";
---

<BaseLayout
  title="Tableau périodique interactif - Outils & méthodes"
  description="Tableau périodique interactif pour retrouver symbole, numéro atomique, masse approchée et informations utiles sur les éléments chimiques."
  canonical="/outils-methodes/tableau-periodique"
  schemaType="EducationalContent"
>
  <main class="periodic-page">
    <nav aria-label="Fil d'Ariane" class="breadcrumb">
      <a href="/">Accueil</a> &rsaquo;
      <a href="/outils-methodes">Outils & Méthodes</a> &rsaquo;
      <strong>Tableau périodique</strong>
    </nav>

    <header class="periodic-hero">
      <p class="eyebrow">Chimie</p>
      <h1>Tableau périodique interactif</h1>
      <p>Clique sur un élément pour consulter ses informations. Utilise la recherche pour retrouver un nom, un symbole ou un numéro atomique.</p>
    </header>

    <section class="periodic-card">
      <TableauPeriodique client:load />
    </section>
  </main>
</BaseLayout>

<style>
  .periodic-page { max-width: 1120px; margin: 0 auto; padding: 1rem; }
  .periodic-hero { text-align: center; max-width: 760px; margin: 1rem auto 1.5rem; }
  .eyebrow { color: var(--accent-primary); font-size: .78rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; margin: 0 0 .35rem; }
  .periodic-hero h1 { color: var(--accent-primary); margin: 0 0 .45rem; font-size: 1.7rem; }
  .periodic-hero p { color: var(--text-secondary); line-height: 1.65; }
  .periodic-card { background: var(--bg-card); border: 1px solid var(--border-color); border-left: 5px solid var(--accent-primary); border-radius: var(--radius-md); box-shadow: var(--shadow-card); padding: 1rem; overflow-x: auto; }
</style>
