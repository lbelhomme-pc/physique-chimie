---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  methodesMathsLycee,
  type LyceeMathMethod,
} from "../../../data/methodesMathsLycee";

export function getStaticPaths() {
  return methodesMathsLycee.map((method) => ({
    params: { fiche: method.slug },
    props: { method },
  }));
}

interface Props {
  method: LyceeMathMethod;
}

const { method } = Astro.props;
const currentIndex = methodesMathsLycee.findIndex((item) => item.slug === method.slug);
const previous = currentIndex > 0 ? methodesMathsLycee[currentIndex - 1] : null;
const next = currentIndex < methodesMathsLycee.length - 1 ? methodesMathsLycee[currentIndex + 1] : null;
const canonical = `/outils-methodes/methodes-maths-lycee/${method.slug}`;
---

<BaseLayout
  title={`${method.shortTitle} - Méthodes maths lycée`}
  description={method.description}
  canonical={canonical}
  schemaType="EducationalContent"
>
  <main class="method-page">
    <nav aria-label="Fil d'Ariane" class="breadcrumb-bar">
      <a href="/">Accueil</a>
      <span aria-hidden="true">›</span>
      <a href="/outils-methodes">Outils & Méthodes</a>
      <span aria-hidden="true">›</span>
      <a href="/outils-methodes/lycee">Lycée</a>
      <span aria-hidden="true">›</span>
      <a href="/outils-methodes/methodes-maths-lycee">Méthodes maths lycée</a>
      <span aria-hidden="true">›</span>
      <strong>{method.shortTitle}</strong>
    </nav>

    <header class="method-hero">
      <p class="eyebrow">Fiche {method.number} - Méthode lycée</p>
      <h1>{method.title}</h1>
      <p>{method.description}</p>
      <div class="hero-actions">
        <a href="/outils-methodes/methodes-maths-lycee">Toutes les fiches</a>
        <a href="/outils-methodes/lycee">Outils lycée</a>
      </div>
    </header>

    <section class="objective-card" aria-labelledby="objective-title">
      <h2 id="objective-title">Objectif de la fiche</h2>
      <p>{method.objective}</p>
      <div class="level-badges" aria-label="Niveaux concernés">
        {method.levels.map((level) => <span>{level}</span>)}
      </div>
    </section>

    <section class="method-card" aria-labelledby="name-title">
      <p class="section-number">1</p>
      <h2 id="name-title">Nom de la méthode</h2>
      <p class="lead">{method.shortTitle}</p>
    </section>

    <section class="method-card" aria-labelledby="levels-title">
      <p class="section-number">2</p>
      <h2 id="levels-title">Niveaux concernés</h2>
      <p>{method.levels.join(" · ")}</p>
    </section>

    <section class="method-card" aria-labelledby="why-title">
      <p class="section-number">3</p>
      <h2 id="why-title">À quoi ça sert en physique-chimie ?</h2>
      <div class="explanation-list">
        {method.why.map((item) => <p>{item}</p>)}
      </div>
    </section>

    <section class="method-card" aria-labelledby="uses-title">
      <p class="section-number">4</p>
      <h2 id="uses-title">Situations typiques où on l'utilise</h2>
      <ul class="check-list">
        {method.typicalUses.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="method-card method-steps" aria-labelledby="steps-title">
      <p class="section-number">5</p>
      <h2 id="steps-title">Méthode étape par étape</h2>
      <div class="method-focus">
        <article>
          <h3>Méthode rapide</h3>
          <ol>
            {method.quickMethod.map((step) => <li>{step}</li>)}
          </ol>
        </article>
        <article>
          <h3>Pour comprendre</h3>
          <p>{method.forUnderstanding}</p>
        </article>
      </div>
      <ol class="main-steps">
        {method.steps.map((step) => <li>{step}</li>)}
      </ol>
    </section>

    {method.formulas && (
      <section class="method-card" aria-labelledby="formulas-title">
        <p class="section-number">Repères</p>
        <h2 id="formulas-title">Formules ou repères utiles</h2>
        <div class="formula-grid">
          {method.formulas.map((formula) => (
            <article>
              <strong>{formula.label}</strong>
              <span>{formula.detail}</span>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="examples-section" aria-labelledby="examples-title">
      <p class="section-number">6 et 7</p>
      <h2 id="examples-title">Exemples corrigés</h2>
      <div class="examples-grid">
        {method.examples.map((example) => (
          <article class="example-card">
            <h3>{example.title}</h3>
            <p class="statement">{example.statement}</p>
            <ol>
              {example.steps.map((step) => <li>{step}</li>)}
            </ol>
            <p class="answer">{example.answer}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="warning-box" aria-labelledby="mistakes-title">
      <p class="section-number">8</p>
      <h2 id="mistakes-title">Erreurs fréquentes des élèves</h2>
      <ul>
        {method.commonMistakes.map((mistake) => <li>{mistake}</li>)}
      </ul>
    </section>

    <section class="tip-box" aria-labelledby="tip-title">
      <p class="section-number">9</p>
      <h2 id="tip-title">Astuce à retenir</h2>
      <p>{method.tip}</p>
    </section>

    <section class="exercise-card" aria-labelledby="exercise-title">
      <p class="section-number">10 et 11</p>
      <h2 id="exercise-title">Mini-exercice d'application</h2>
      <p>{method.miniExercise.statement}</p>
      <details>
        <summary>Afficher la correction</summary>
        <div class="correction">
          {method.miniExercise.correction.map((line) => <p>{line}</p>)}
        </div>
      </details>
    </section>

    <section class="method-card" aria-labelledby="competencies-title">
      <p class="section-number">12</p>
      <h2 id="competencies-title">Lien avec les compétences du lycée ou du bac</h2>
      <div class="competency-list">
        {method.competencies.map((competency) => <span>{competency}</span>)}
      </div>
    </section>

    <section class="remember-card" aria-labelledby="remember-title">
      <h2 id="remember-title">À retenir</h2>
      <ul>
        {method.remember.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <nav class="method-nav" aria-label="Navigation entre les fiches">
      {previous ? (
        <a href={`/outils-methodes/methodes-maths-lycee/${previous.slug}`}>
          <span>Fiche précédente</span>
          <strong>{previous.shortTitle}</strong>
        </a>
      ) : (
        <span></span>
      )}
      {next ? (
        <a href={`/outils-methodes/methodes-maths-lycee/${next.slug}`}>
          <span>Fiche suivante</span>
          <strong>{next.shortTitle}</strong>
        </a>
      ) : (
        <span></span>
      )}
    </nav>
  </main>
</BaseLayout>

<style>
  .method-page {
    margin: 0 auto;
    max-width: 980px;
    padding: 1rem 1rem 3rem;
  }

  .method-hero {
    margin: 1rem auto 1.5rem;
    max-width: 820px;
    text-align: center;
  }

  .eyebrow,
  .section-number {
    color: var(--accent-primary);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    margin: 0;
    text-transform: uppercase;
  }

  .method-hero h1 {
    color: var(--accent-primary);
    font-size: clamp(1.65rem, 4.4vw, 2.45rem);
    letter-spacing: 0;
    line-height: 1.12;
    margin: 0.4rem 0 0.75rem;
  }

  .method-hero p {
    color: var(--text-secondary);
    line-height: 1.75;
    margin: 0 auto;
    max-width: 760px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin-top: 1.1rem;
  }

  .hero-actions a {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-xs);
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 750;
    padding: 0.5rem 0.85rem;
    text-decoration: none;
  }

  .hero-actions a:hover,
  .hero-actions a:focus-visible {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    outline: none;
    text-decoration: none;
  }

  .objective-card,
  .method-card,
  .warning-box,
  .tip-box,
  .exercise-card,
  .remember-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-left: 5px solid var(--accent-primary);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    margin: 1rem 0;
    padding: 1.2rem;
  }

  .objective-card h2,
  .method-card h2,
  .examples-section h2,
  .warning-box h2,
  .tip-box h2,
  .exercise-card h2,
  .remember-card h2 {
    color: var(--accent-primary);
    font-size: 1.25rem;
    letter-spacing: 0;
    margin: 0.2rem 0 0.75rem;
  }

  .objective-card p,
  .method-card p,
  .warning-box li,
  .tip-box p,
  .exercise-card p,
  .remember-card li,
  .check-list li,
  .method-steps li,
  .examples-section li {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .lead {
    color: var(--text-primary) !important;
    font-size: 1.08rem;
    font-weight: 800;
  }

  .level-badges,
  .competency-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.75rem;
  }

  .level-badges span,
  .competency-list span {
    background: var(--accent-primary-light);
    border-radius: var(--radius-pill);
    color: var(--accent-primary);
    font-size: 0.8rem;
    font-weight: 850;
    padding: 0.25rem 0.65rem;
  }

  .explanation-list {
    display: grid;
    gap: 0.65rem;
  }

  .explanation-list p {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    margin: 0;
    padding: 0.75rem 0.85rem;
  }

  .check-list,
  .warning-box ul,
  .remember-card ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  .method-focus {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: 1fr 1fr;
    margin-bottom: 1rem;
  }

  .method-focus article,
  .formula-grid article {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.95rem;
  }

  .method-focus h3 {
    color: var(--text-primary);
    font-size: 1rem;
    margin: 0 0 0.55rem;
  }

  .method-focus ol,
  .main-steps {
    margin: 0;
    padding-left: 1.25rem;
  }

  .main-steps {
    background: var(--accent-primary-light);
    border-radius: var(--radius-sm);
    padding: 0.85rem 0.85rem 0.85rem 2rem;
  }

  .formula-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .formula-grid strong {
    color: var(--text-primary);
    display: block;
    margin-bottom: 0.35rem;
  }

  .formula-grid span {
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .examples-section {
    margin: 1.35rem 0 1rem;
  }

  .examples-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .example-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    padding: 1.1rem;
  }

  .example-card h3 {
    color: var(--text-primary);
    font-size: 1.05rem;
    margin: 0 0 0.55rem;
  }

  .statement {
    background: var(--bg-secondary);
    border-radius: var(--radius-sm);
    color: var(--text-primary) !important;
    margin: 0 0 0.8rem;
    padding: 0.75rem;
  }

  .answer {
    background: var(--accent-primary-light);
    border-radius: var(--radius-sm);
    color: var(--accent-primary) !important;
    font-weight: 850;
    margin: 0.8rem 0 0;
    padding: 0.75rem;
  }

  .warning-box {
    border-left-color: var(--warning, #d97706);
  }

  .warning-box .section-number,
  .warning-box h2 {
    color: var(--warning, #d97706);
  }

  .tip-box {
    border-left-color: var(--success, #15803d);
  }

  .tip-box .section-number,
  .tip-box h2 {
    color: var(--success, #15803d);
  }

  .exercise-card details {
    margin-top: 0.8rem;
  }

  .exercise-card summary {
    background: var(--accent-primary);
    border-radius: var(--radius-pill);
    color: white;
    cursor: pointer;
    display: inline-flex;
    font-weight: 850;
    padding: 0.55rem 0.9rem;
  }

  .exercise-card summary:focus-visible {
    outline: 3px solid var(--accent-primary-light);
    outline-offset: 3px;
  }

  .correction {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    margin-top: 0.8rem;
    padding: 0.9rem;
  }

  .correction p {
    margin: 0 0 0.55rem;
  }

  .correction p:last-child {
    margin-bottom: 0;
  }

  .method-nav {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 1.5rem;
  }

  .method-nav a {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    color: inherit;
    padding: 1rem;
    text-decoration: none;
  }

  .method-nav a span {
    color: var(--accent-primary);
    display: block;
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
    text-transform: uppercase;
  }

  .method-nav a strong {
    color: var(--text-primary);
  }

  .method-nav a:hover,
  .method-nav a:focus-visible {
    border-color: var(--accent-primary);
    outline: none;
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .method-focus,
    .formula-grid,
    .examples-grid,
    .method-nav {
      grid-template-columns: 1fr;
    }
  }
</style>
