---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  methodesMathsLycee,
  type LyceeMathMethod,
} from "../../../data/methodesMathsLycee";

export function getStaticPaths() {
  return methodesMathsLycee.map((method) => ({
    params: { fiche: method.slug },
    props: { method },
  }));
}

interface Props {
  method: LyceeMathMethod;
}

const { method } = Astro.props;
const currentIndex = methodesMathsLycee.findIndex((item) => item.slug === method.slug);
const previous = currentIndex > 0 ? methodesMathsLycee[currentIndex - 1] : null;
const next = currentIndex < methodesMathsLycee.length - 1 ? methodesMathsLycee[currentIndex + 1] : null;
const canonical = `/outils-methodes/methodes-maths-lycee/${method.slug}`;
---

<BaseLayout
  title={`${method.shortTitle} - Méthodes maths lycée`}
  description={method.description}
  canonical={canonical}
  schemaType="EducationalContent"
>
  <main class="ui5-page ui5-method-page" data-subject="mathematiques">
    <nav aria-label="Fil d'Ariane" class="ui5-breadcrumb">
      <a href="/">Accueil</a>
      <span aria-hidden="true">›</span>
      <a href="/outils-methodes">Outils & Méthodes</a>
      <span aria-hidden="true">›</span>
      <a href="/outils-methodes/lycee">Lycée</a>
      <span aria-hidden="true">›</span>
      <a href="/outils-methodes/methodes-maths-lycee">Méthodes maths lycée</a>
      <span aria-hidden="true">›</span>
      <strong>{method.shortTitle}</strong>
    </nav>

    <header class="method-hero">
      <p class="eyebrow">Fiche {method.number} - Méthode lycée</p>
      <h1>{method.title}</h1>
      <p>{method.description}</p>
      <div class="hero-actions">
        <a href="/outils-methodes/methodes-maths-lycee">Toutes les fiches</a>
        <a href="/outils-methodes/lycee">Outils lycée</a>
      </div>
    </header>

    <section class="objective-card" aria-labelledby="objective-title">
      <h2 id="objective-title">Objectif de la fiche</h2>
      <p>{method.objective}</p>
      <div class="level-badges" aria-label="Niveaux concernés">
        {method.levels.map((level) => <span>{level}</span>)}
      </div>
    </section>

    <section class="method-card" aria-labelledby="name-title">
      <p class="section-number">1</p>
      <h2 id="name-title">Nom de la méthode</h2>
      <p class="lead">{method.shortTitle}</p>
    </section>

    <section class="method-card" aria-labelledby="levels-title">
      <p class="section-number">2</p>
      <h2 id="levels-title">Niveaux concernés</h2>
      <p>{method.levels.join(" · ")}</p>
    </section>

    <section class="method-card" aria-labelledby="why-title">
      <p class="section-number">3</p>
      <h2 id="why-title">À quoi ça sert en physique-chimie ?</h2>
      <div class="explanation-list">
        {method.why.map((item) => <p>{item}</p>)}
      </div>
    </section>

    <section class="method-card" aria-labelledby="uses-title">
      <p class="section-number">4</p>
      <h2 id="uses-title">Situations typiques où on l'utilise</h2>
      <ul class="check-list">
        {method.typicalUses.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="method-card method-steps" aria-labelledby="steps-title">
      <p class="section-number">5</p>
      <h2 id="steps-title">Méthode étape par étape</h2>
      <div class="method-focus">
        <article>
          <h3>Méthode rapide</h3>
          <ol>
            {method.quickMethod.map((step) => <li>{step}</li>)}
          </ol>
        </article>
        <article>
          <h3>Pour comprendre</h3>
          <p>{method.forUnderstanding}</p>
        </article>
      </div>
      <ol class="main-steps">
        {method.steps.map((step) => <li>{step}</li>)}
      </ol>
    </section>

    {method.formulas && (
      <section class="method-card" aria-labelledby="formulas-title">
        <p class="section-number">Repères</p>
        <h2 id="formulas-title">Formules ou repères utiles</h2>
        <div class="formula-grid">
          {method.formulas.map((formula) => (
            <article>
              <strong>{formula.label}</strong>
              <span>{formula.detail}</span>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="examples-section" aria-labelledby="examples-title">
      <p class="section-number">6 et 7</p>
      <h2 id="examples-title">Exemples corrigés</h2>
      <div class="examples-grid">
        {method.examples.map((example) => (
          <article class="example-card">
            <h3>{example.title}</h3>
            <p class="statement">{example.statement}</p>
            <ol>
              {example.steps.map((step) => <li>{step}</li>)}
            </ol>
            <p class="answer">{example.answer}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="warning-box" aria-labelledby="mistakes-title">
      <p class="section-number">8</p>
      <h2 id="mistakes-title">Erreurs fréquentes des élèves</h2>
      <ul>
        {method.commonMistakes.map((mistake) => <li>{mistake}</li>)}
      </ul>
    </section>

    <section class="tip-box" aria-labelledby="tip-title">
      <p class="section-number">9</p>
      <h2 id="tip-title">Astuce à retenir</h2>
      <p>{method.tip}</p>
    </section>

    <section class="exercise-card" aria-labelledby="exercise-title">
      <p class="section-number">10 et 11</p>
      <h2 id="exercise-title">Mini-exercice d'application</h2>
      <p>{method.miniExercise.statement}</p>
      <details>
        <summary>Afficher la correction</summary>
        <div class="correction">
          {method.miniExercise.correction.map((line) => <p>{line}</p>)}
        </div>
      </details>
    </section>

    <section class="method-card" aria-labelledby="competencies-title">
      <p class="section-number">12</p>
      <h2 id="competencies-title">Lien avec les compétences du lycée ou du bac</h2>
      <div class="competency-list">
        {method.competencies.map((competency) => <span>{competency}</span>)}
      </div>
    </section>

    <section class="remember-card" aria-labelledby="remember-title">
      <h2 id="remember-title">À retenir</h2>
      <ul>
        {method.remember.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <nav class="method-nav" aria-label="Navigation entre les fiches">
      {previous ? (
        <a href={`/outils-methodes/methodes-maths-lycee/${previous.slug}`}>
          <span>Fiche précédente</span>
          <strong>{previous.shortTitle}</strong>
        </a>
      ) : (
        <span></span>
      )}
      {next ? (
        <a href={`/outils-methodes/methodes-maths-lycee/${next.slug}`}>
          <span>Fiche suivante</span>
          <strong>{next.shortTitle}</strong>
        </a>
      ) : (
        <span></span>
      )}
    </nav>
  </main>
</BaseLayout>

