---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { lyceeMathsDiagnostic, methodesMathsLycee } from "../../data/methodesMathsLycee";

const families = Array.from(new Set(methodesMathsLycee.map((method) => method.family))).map((family) => ({
  family,
  methods: methodesMathsLycee.filter((method) => method.family === family),
}));
---

<BaseLayout
  title="Méthodes de maths utiles en physique-chimie au lycée"
  description="Fiches méthodes de mathématiques utiles en physique-chimie au lycée : conversions, formules, proportionnalité, graphiques, vecteurs, dérivées, logarithmes, incertitudes et rédaction scientifique."
  canonical="/outils-methodes/methodes-maths-lycee"
  schemaType="EducationalContent"
>
  <main class="ui5-page ui5-methods-home" data-subject="mathematiques">
    <nav aria-label="Fil d'Ariane" class="ui5-breadcrumb">
      <a href="/">Accueil</a>
      <span aria-hidden="true">›</span>
      <a href="/outils-methodes">Outils & Méthodes</a>
      <span aria-hidden="true">›</span>
      <a href="/outils-methodes/lycee">Lycée</a>
      <span aria-hidden="true">›</span>
      <strong>Méthodes maths lycée</strong>
    </nav>

    <header class="page-hero">
      <p class="eyebrow">Méthodes - Lycée</p>
      <h1>Méthodes de maths utiles en physique-chimie au lycée</h1>
      <p>
        Ces fiches rassemblent les outils mathématiques vraiment utilisés en physique-chimie,
        de la seconde à la terminale spécialité. Le but n'est pas d'être excellent en maths :
        il faut surtout choisir la bonne méthode, garder les unités et conclure scientifiquement.
      </p>
      <div class="hero-actions">
        <a href="/outils-methodes/lycee">Retour aux outils lycée</a>
        <a href="/outils-methodes/seconde-numerique">Méthodes numériques</a>
        <a href="/outils-methodes/cours-python">Cours Python</a>
      </div>
    </header>

    <section class="diagnostic-card" aria-labelledby="diagnostic-title">
      <div class="section-heading">
        <p>Avant de choisir une fiche</p>
        <h2 id="diagnostic-title">Diagnostic rapide</h2>
      </div>

      <div class="diagnostic-grid">
        <article>
          <h3>Indispensables</h3>
          <ul>
            {lyceeMathsDiagnostic.indispensables.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article>
          <h3>Difficultés fréquentes</h3>
          <ul>
            {lyceeMathsDiagnostic.difficultes.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article>
          <h3>À revoir régulièrement</h3>
          <ul>
            {lyceeMathsDiagnostic.aRevoirSouvent.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article>
          <h3>Priorités bac</h3>
          <ul>
            {lyceeMathsDiagnostic.prioritesBac.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </section>

    <section class="level-card" aria-labelledby="level-title">
      <h2 id="level-title">Repères par niveau</h2>
      <div class="level-list">
        {lyceeMathsDiagnostic.niveaux.map((item) => <p>{item}</p>)}
      </div>
    </section>

    <section class="cards-section" aria-labelledby="methods-title">
      <div class="section-heading">
        <p>Choisir une méthode</p>
        <h2 id="methods-title">Fiches disponibles</h2>
      </div>

      <div class="family-list">
        {families.map(({ family, methods }) => (
          <section class="family-block" aria-labelledby={`family-${family.toLowerCase().replaceAll(" ", "-")}`}>
            <h3 id={`family-${family.toLowerCase().replaceAll(" ", "-")}`}>{family}</h3>
            <div class="method-grid">
              {methods.map((method) => (
                <a class="method-card" href={`/outils-methodes/methodes-maths-lycee/${method.slug}`}>
                  <span class="method-number">Fiche {method.number}</span>
                  <strong>{method.shortTitle}</strong>
                  <span>{method.description}</span>
                  <span class="level-badges">
                    {method.levels.map((level) => <em>{level}</em>)}
                  </span>
                  <b>Ouvrir la fiche</b>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="guide-card" aria-labelledby="guide-title">
      <h2 id="guide-title">Méthode générale pour résoudre un exercice de physique-chimie au lycée</h2>
      <ol>
        <li>Je lis la question et je repère ce qu'on me demande.</li>
        <li>J'identifie la grandeur cherchée.</li>
        <li>Je liste les données utiles avec leurs unités.</li>
        <li>Je fais un schéma ou un tableau si nécessaire.</li>
        <li>Je choisis la bonne formule, le bon modèle ou la bonne méthode.</li>
        <li>Je convertis les unités avant de calculer.</li>
        <li>Je calcule proprement en gardant les unités.</li>
        <li>Je réponds par une phrase et je vérifie si le résultat est logique.</li>
      </ol>
    </section>
  </main>
</BaseLayout>

