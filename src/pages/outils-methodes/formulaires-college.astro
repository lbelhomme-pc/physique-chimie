---
import BaseLayout from "../../layouts/BaseLayout.astro";

const groups = [
  {
    title: "Mécanique",
    lines: [
      ["v = d / t", "v en m·s⁻¹, d en m, t en s"],
      ["P = m × g", "P en N, m en kg, g ≈ 9,8 N·kg⁻¹"],
      ["E = P × h", "énergie de position dans un cas simple"],
    ],
    warning: "Convertir la durée en secondes avant d'utiliser v = d / t.",
  },
  {
    title: "Électricité",
    lines: [
      ["U = R × I", "U en V, R en Ω, I en A"],
      ["P = U × I", "P en W, U en V, I en A"],
      ["E = P × t", "E en J si P en W et t en s"],
    ],
    warning: "Convertir les milliampères en ampères.",
  },
  {
    title: "Chimie",
    lines: [
      ["ρ = m / V", "masse volumique, par exemple en g·mL⁻¹"],
      ["Cm = m / V", "concentration en masse, en g·L⁻¹"],
      ["m(solution) = m(solvant) + m(soluté)", "conservation de la masse lors d'une dissolution"],
    ],
    warning: "Ne pas confondre masse volumique et concentration.",
  },
  {
    title: "Signaux et ondes",
    lines: [
      ["f = 1 / T", "f en Hz, T en s"],
      ["v = d / Δt", "vitesse de propagation d'un signal"],
    ],
    warning: "Convertir les millisecondes en secondes.",
  },
];
---

<BaseLayout
  title="Formulaires collège - Outils & méthodes"
  description="Formulaires de physique-chimie pour le collège : mécanique, électricité, chimie et signaux."
  canonical="/outils-methodes/formulaires-college"
  schemaType="EducationalContent"
  subject="physique-chimie"
  resourceType="tool"
>
  <div class="ui5-page" data-subject="physique-chimie">
    <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">/</span>
      <a href="/outils-methodes">Outils et méthodes</a><span aria-hidden="true">/</span>
      <strong>Formulaires collège</strong>
    </nav>
    <header class="ui5-page-header">
      <div class="ui5-page-header__copy">
        <p class="ui5-kicker">Révision rapide</p>
        <h1 class="ui5-title">Formulaires collège</h1>
        <p class="ui5-lead">Les relations utiles avec les symboles, les unités et le piège à vérifier avant chaque calcul.</p>
      </div>
    </header>

    <section class="ui5-section">
      <div class="ui5-grid ui5-grid--2">
        {groups.map((group) => (
          <article class="ui5-card ui5-formula-card">
            <h2>{group.title}</h2>
            {group.lines.map(([formula, detail]) => (
              <div class="ui5-formula-line"><strong>{formula}</strong><span>{detail}</span></div>
            ))}
            <p class="ui5-formula-warning"><strong>Vigilance :</strong> {group.warning}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
