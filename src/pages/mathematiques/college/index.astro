---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import V3LandingHero from "../../../components/home/V3LandingHero.astro";
import Breadcrumb from "../../../components/ui/Breadcrumb.astro";
import MathLevelCard from "../../../components/mathematiques/MathLevelCard.astro";
import { getMathematicsLevelsByCycle } from "../../../data/mathematiques/levels";
import { chapterEntryFromGlob } from "../../../data/mathematiques/content";
import "../../../styles/mathematiques/mathematics.css";

const allMeta = import.meta.glob("/src/data/mathematiques/chapters/**/meta.json", { eager: true });
const chapters = Object.entries(allMeta)
  .map(([path, mod]) => chapterEntryFromGlob(path, mod))
  .filter((chapter) => chapter?.cycle === "college");
const levels = getMathematicsLevelsByCycle("college");

function countChapters(levelSlug: string) {
  return chapters.filter((chapter) => chapter?.niveau === levelSlug).length;
}

const availableCount = levels.filter((level) => countChapters(level.slug) > 0 && level.status === "available").length;
---

<BaseLayout
  title="Mathématiques collège"
  description="Niveaux collège de l'espace mathématiques : accès aux chapitres publiés et aux niveaux prévus."
  canonical="/mathematiques/college"
  subject="mathematiques"
>
  <div class="v3-landing-page v3-landing-page--maths">
    <V3LandingHero
      tone="maths"
      eyebrow="Mathématiques"
      mark="∑"
      markLabel="Symbole somme"
      title="Mathématiques au collège"
      description="Choisis ton niveau pour retrouver les chapitres, les exercices, les quiz et les flashcards adaptés au programme."
      actions={[
        { label: "Voir les niveaux", href: "#niveaux-maths-college" },
        { label: "Retour aux mathématiques", href: "/mathematiques", variant: "secondary" },
      ]}
      stats={[
        { value: levels.length, label: "niveaux" },
        { value: availableCount, label: "niveaux publiés" },
        { value: chapters.length, label: "chapitres" },
      ]}
      imageAlt="Espace de travail consacré aux mathématiques du collège."
    />

    <div class="v3-landing-content math-shell">
      <Breadcrumb
        items={[
          { label: "Accueil", href: "/" },
          { label: "Mathématiques", href: "/mathematiques" },
          { label: "Collège" },
        ]}
      />

      <section class="v3-landing-section math-section" id="niveaux-maths-college" aria-labelledby="math-college-levels">
        <div class="v3-landing-section-header">
          <div>
            <p>Parcours collège</p>
            <h2 id="math-college-levels">Choisir un niveau</h2>
          </div>
          <span>Les niveaux publiés donnent directement accès aux chapitres disponibles.</span>
        </div>
        <div class="math-grid">
          {levels.map((level) => <MathLevelCard level={level} chapterCount={countChapters(level.slug)} />)}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
