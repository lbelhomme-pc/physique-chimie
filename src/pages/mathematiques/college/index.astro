---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import MathLevelCard from "../../../components/mathematiques/MathLevelCard.astro";
import { getMathematicsLevelsByCycle } from "../../../data/mathematiques/levels";
import { chapterEntryFromGlob } from "../../../data/mathematiques/content";

const allMeta = import.meta.glob("/src/data/mathematiques/chapters/**/meta.json", { eager: true });
const chapters = Object.entries(allMeta)
  .map(([path, mod]) => chapterEntryFromGlob(path, mod))
  .filter((chapter) => chapter?.cycle === "college");
const levels = getMathematicsLevelsByCycle("college");

function countChapters(levelSlug: string) {
  return chapters.filter((chapter) => chapter?.niveau === levelSlug).length;
}
const availableCount = levels.filter((level) => countChapters(level.slug) > 0 && level.status === "available").length;
---

<BaseLayout
  title="Mathématiques collège"
  description="Niveaux collège de l'espace mathématiques : accès aux chapitres publiés et aux niveaux prévus."
  canonical="/mathematiques/college"
  subject="mathematiques"
  cycle="college"
>
  <div class="ui5-page" data-subject="mathematiques">
    <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">/</span>
      <a href="/mathematiques">Mathématiques</a><span aria-hidden="true">/</span><strong>Collège</strong>
    </nav>

    <header class="ui5-page-header">
      <div class="ui5-page-header__copy">
        <p class="ui5-kicker">Mathématiques · Collège</p>
        <h1 class="ui5-title">Choisir un niveau</h1>
        <p class="ui5-lead">Retrouve les chapitres, exercices, quiz et flashcards adaptés au programme de ton niveau.</p>
      </div>
      <p class="ui5-page-header__aside">{availableCount} niveau{availableCount > 1 ? "x" : ""} publié{availableCount > 1 ? "s" : ""} · {chapters.length} chapitres</p>
    </header>

    <section class="ui5-section" aria-labelledby="math-college-levels">
      <div class="ui5-section-head">
        <h2 id="math-college-levels">Niveaux</h2>
        <p>Les niveaux non encore publiés restent visibles comme repères, sans faux lien.</p>
      </div>
      <div class="ui5-grid ui5-grid--2">
        {levels.map((level) => <MathLevelCard level={level} chapterCount={countChapters(level.slug)} />)}
      </div>
    </section>
  </div>
</BaseLayout>
