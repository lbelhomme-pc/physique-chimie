---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import MathLevelCard from "../../../components/mathematiques/MathLevelCard.astro";
import { getMathematicsLevelsByCycle } from "../../../data/mathematiques/levels";
import { chapterEntryFromGlob } from "../../../data/mathematiques/content";

const allMeta = import.meta.glob("/src/data/mathematiques/chapters/**/meta.json", { eager: true });
const chapters = Object.entries(allMeta)
  .map(([path, mod]) => chapterEntryFromGlob(path, mod))
  .filter((chapter) => chapter?.cycle === "lycee");
const levels = getMathematicsLevelsByCycle("lycee");

function countChapters(levelSlug: string) {
  return chapters.filter((chapter) => chapter?.niveau === levelSlug).length;
}
const availableCount = levels.filter((level) => countChapters(level.slug) > 0 && level.status === "available").length;
---

<BaseLayout
  title="Mathématiques lycée"
  description="Parcours lycée de l'espace mathématiques : accès aux chapitres publiés et aux parcours prévus."
  canonical="/mathematiques/lycee"
  subject="mathematiques"
  cycle="lycee"
>
  <div class="ui5-page" data-subject="mathematiques">
    <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">/</span>
      <a href="/mathematiques">Mathématiques</a><span aria-hidden="true">/</span><strong>Lycée</strong>
    </nav>

    <header class="ui5-page-header">
      <div class="ui5-page-header__copy">
        <p class="ui5-kicker">Mathématiques · Lycée</p>
        <h1 class="ui5-title">Choisir un parcours</h1>
        <p class="ui5-lead">Seconde, spécialité, mathématiques complémentaires ou expertes : chaque parcours ouvre sur le même catalogue et le même lecteur.</p>
      </div>
      <p class="ui5-page-header__aside">{availableCount} parcours publié{availableCount > 1 ? "s" : ""} · {chapters.length} chapitres</p>
    </header>

    <section class="ui5-section" aria-labelledby="math-lycee-levels">
      <div class="ui5-section-head">
        <h2 id="math-lycee-levels">Parcours</h2>
        <p>Les parcours prévus restent identifiés sans créer de pages vides trompeuses.</p>
      </div>
      <div class="ui5-grid ui5-grid--2">
        {levels.map((level) => <MathLevelCard level={level} chapterCount={countChapters(level.slug)} />)}
      </div>
    </section>
  </div>
</BaseLayout>
