---
import BaseLayout from "../../layouts/BaseLayout.astro";
import V3LandingHero from "../../components/home/V3LandingHero.astro";

const memoryModes = [
  {
    mark: "J",
    title: "Révision du jour",
    description: "Retrouve le point d’entrée vers tes outils de révision sur cet appareil.",
    href: "/memorisation/revision-du-jour",
    action: "Commencer la révision",
  },
  {
    mark: "Q",
    title: "Méga quiz",
    description: "Choisis Mathématiques ou Physique-Chimie, puis entraîne-toi sur les chapitres publiés.",
    href: "/memorisation/mega-quiz",
    action: "Lancer un quiz",
  },
  {
    mark: "F",
    title: "Méga flashcards",
    description: "Choisis ta discipline avant de réviser les définitions, formules et idées essentielles.",
    href: "/memorisation/mega-flashcards",
    action: "Ouvrir les flashcards",
  },
];
---

<BaseLayout
  title="Mémorisation - Mathématiques et Physique-Chimie"
  description="Quiz et flashcards des chapitres publiés en Mathématiques et Physique-Chimie, avec choix de la discipline."
  canonical="/memorisation"
  resourceType="memorisation"
  subject="transversal"
>
  <div class="v3-landing-page v3-landing-page--memory">
    <V3LandingHero
      tone="memory"
      eyebrow="Mémorisation"
      mark="M"
      markLabel="Repère mémorisation"
      title="Réviser pour retenir"
      description="Quiz, flashcards et reprises ciblées pour les contenus publiés en Mathématiques et Physique-Chimie."
      actions={[
        { label: "Révision du jour", href: "/memorisation/revision-du-jour" },
        { label: "Choisir un mode", href: "#modes-memorisation", variant: "secondary" },
      ]}
      stats={[
        { value: memoryModes.length, label: "modes de révision" },
      ]}
      imageAlt="Espace de travail scientifique et mathématique préparé pour une séance de révision."
    />

    <div class="v3-landing-content">
      <section class="v3-landing-section" id="modes-memorisation" aria-labelledby="memory-modes-title">
        <div class="v3-landing-section-header">
          <div>
            <p>Choisir une activité</p>
            <h2 id="memory-modes-title">Comment veux-tu réviser ?</h2>
          </div>
          <span>Les banques Mega proposent un filtre de discipline avant la session.</span>
        </div>

        <div class="v3-landing-grid">
          {memoryModes.map((mode) => (
            <a class="v3-landing-card" href={mode.href}>
              <span class="v3-landing-card__mark" aria-hidden="true">{mode.mark}</span>
              <h3>{mode.title}</h3>
              <p>{mode.description}</p>
              <em>{mode.action} →</em>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
