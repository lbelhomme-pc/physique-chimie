---
import BaseLayout from "../../layouts/BaseLayout.astro";

const memoryModes = [
  { mark: "J", title: "Révision du jour", description: "Retrouve le point d’entrée vers tes outils de révision sur cet appareil.", href: "/memorisation/revision-du-jour", action: "Commencer la révision" },
  { mark: "Q", title: "Méga quiz", description: "Choisis Mathématiques ou Physique-Chimie, puis entraîne-toi sur les chapitres publiés.", href: "/memorisation/mega-quiz", action: "Lancer un quiz" },
  { mark: "F", title: "Méga flashcards", description: "Choisis ta discipline avant de réviser les définitions, formules et idées essentielles.", href: "/memorisation/mega-flashcards", action: "Ouvrir les flashcards" },
];
---

<BaseLayout
  title="Mémorisation - Mathématiques et Physique-Chimie"
  description="Quiz et flashcards des chapitres publiés en Mathématiques et Physique-Chimie."
  canonical="/memorisation"
  resourceType="memorisation"
  subject="transversal"
>
  <div class="ui5-page">
    <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">/</span><strong>Mémorisation</strong>
    </nav>
    <header class="ui5-page-header">
      <div class="ui5-page-header__copy">
        <p class="ui5-kicker">Mémorisation</p>
        <h1 class="ui5-title">Réviser pour retenir</h1>
        <p class="ui5-lead">Quiz, flashcards et reprises ciblées pour les contenus publiés en Mathématiques et Physique-Chimie.</p>
      </div>
      <p class="ui5-page-header__aside">{memoryModes.length} modes de révision</p>
    </header>

    <section class="ui5-section" aria-labelledby="memory-modes-title">
      <div class="ui5-section-head">
        <h2 id="memory-modes-title">Comment veux-tu réviser ?</h2>
        <p>Choisis une activité puis ta discipline.</p>
      </div>
      <div class="ui5-grid ui5-grid--2">
        {memoryModes.map((mode) => (
          <a class="ui5-card ui5-resource-card" href={mode.href}>
            <span class="ui5-level-card__badge" aria-hidden="true">{mode.mark}</span>
            <h3>{mode.title}</h3>
            <p>{mode.description}</p>
            <span class="ui5-card__cta">{mode.action} →</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
