---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MegaFlashcardsPlayer from "../../components/pedagogie/MegaFlashcardsPlayer.tsx";
import { MEMORIZATION_CANONICAL_ROUTES } from "../../data/contentRoutes";
import { collectMegaFlashcards } from "../../utils/megaMemorizationData";

const flashFiles = import.meta.glob("../../data/chapters/**/flashcards.json", { eager: true });
const metaFiles = import.meta.glob("../../data/chapters/**/meta.json", { eager: true });

const totalCards = collectMegaFlashcards(flashFiles, metaFiles).length;
const dataUrl = "/memorisation/mega-flashcards-data.json";
---

<BaseLayout
  title="Mega Flashcards — Physique-Chimie"
  description="Toutes les flashcards de tous les chapitres en une seule session."
  canonical={MEMORIZATION_CANONICAL_ROUTES.megaFlashcards}
>
  <div style="text-align:center;padding:1.5rem 0 0.5rem;">
    <span style="font-size:2.5rem;">▣</span>
    <h1 style="font-size:1.6rem;font-weight:800;color:var(--accent-primary);margin:0.3rem 0;">Mega Flashcards</h1>
    <p style="color:var(--text-muted);font-size:0.95rem;">{totalCards} cartes disponibles</p>
  </div>
  <div style="max-width:700px;margin:0 auto;padding:0 1rem 2rem;">
    <MegaFlashcardsPlayer client:idle dataUrl={dataUrl} totalCards={totalCards} />
  </div>
</BaseLayout>
