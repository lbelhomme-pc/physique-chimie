---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { MEMORIZATION_CANONICAL_ROUTES } from "../../data/contentRoutes";
---

<BaseLayout
  title="Révision du jour — Mathématiques et Physique-Chimie"
  description="Point d'entrée vers les outils de révision et de mémorisation en Mathématiques et Physique-Chimie."
  canonical={MEMORIZATION_CANONICAL_ROUTES.dailyReview}
  noindex={true}
  subject="transversal"
>
  <section style="max-width:760px;margin:0 auto;padding:2rem 1rem;text-align:center;">
    <p style="color:var(--text-muted);font-weight:700;margin:0 0 .35rem;">Mémorisation</p>
    <h1 style="font-size:1.6rem;font-weight:800;color:var(--accent-primary);margin:0 0 .75rem;">Révision du jour</h1>
    <p style="color:var(--text-secondary);margin:0 auto 1.25rem;max-width:48rem;">
      Cette page reste le point d'entrée stable des révisions. Dans les banques Mega, choisis Mathématiques ou Physique-Chimie avant de démarrer ta session.
    </p>
    <div style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;">
      <a href={MEMORIZATION_CANONICAL_ROUTES.megaQuiz} class="button-like">Lancer le Mega Quiz</a>
      <a href={MEMORIZATION_CANONICAL_ROUTES.megaFlashcards} class="button-like secondary">Réviser les flashcards</a>
    </div>
  </section>
</BaseLayout>

<style>
  .button-like {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--accent-primary);
    border-radius: var(--radius-sm);
    background: var(--accent-primary);
    color: white;
    text-decoration: none;
    font-weight: 700;
  }

  .button-like.secondary {
    background: transparent;
    color: var(--accent-primary);
  }
</style>
