---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { MEMORIZATION_CANONICAL_ROUTES } from "../../data/contentRoutes";
---

<BaseLayout
  title="Révision du jour — Mathématiques et Physique-Chimie"
  description="Point d'entrée vers les outils de révision et de mémorisation."
  canonical={MEMORIZATION_CANONICAL_ROUTES.dailyReview}
  noindex={true}
  subject="transversal"
>
  <div class="ui5-page">
    <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">/</span>
      <a href="/memorisation">Mémorisation</a><span aria-hidden="true">/</span>
      <strong>Révision du jour</strong>
    </nav>
    <header class="ui5-page-header">
      <div class="ui5-page-header__copy">
        <p class="ui5-kicker">Mémorisation</p>
        <h1 class="ui5-title">Révision du jour</h1>
        <p class="ui5-lead">Choisis ton mode de révision, puis ta discipline avant de commencer.</p>
      </div>
    </header>
    <section class="ui5-section">
      <div class="ui5-grid ui5-grid--2">
        <a class="ui5-card ui5-resource-card" href={MEMORIZATION_CANONICAL_ROUTES.megaQuiz}>
          <h3>Méga quiz</h3><p>Tester tes connaissances et reprendre tes erreurs.</p><span class="ui5-card__cta">Lancer le quiz →</span>
        </a>
        <a class="ui5-card ui5-resource-card" href={MEMORIZATION_CANONICAL_ROUTES.megaFlashcards}>
          <h3>Méga flashcards</h3><p>Réviser les définitions, formules et idées essentielles.</p><span class="ui5-card__cta">Réviser →</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
