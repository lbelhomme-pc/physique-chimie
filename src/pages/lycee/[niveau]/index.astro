---
// src/pages/lycee/[niveau]/index.astro
import BaseLayout from "../../../layouts/BaseLayout.astro";
import V3LandingHero from "../../../components/home/V3LandingHero.astro";
import CatalogueChapterList from "../../../components/catalogue/CatalogueChapterList.astro";
import type { CatalogueChapterItem } from "../../../components/catalogue/types";
import Breadcrumb from "../../../components/ui/Breadcrumb.astro";
import { getDisciplineFromLevelSlug, getDisciplineIdentity } from "../../../data/disciplineIdentity";
import { lyceeLevels, getLevelLabel } from "../../../data/levels";

export function getStaticPaths() {
  return lyceeLevels.map((level) => ({ params: { niveau: level.slug } }));
}

const { niveau } = Astro.params;
const niveauLabel = getLevelLabel(niveau!);
const discipline = getDisciplineIdentity(getDisciplineFromLevelSlug(niveau));
const isTeachingScience = discipline.id === "enseignement-scientifique";

function getShortLabel(slug: string): string {
  const map: Record<string, string> = {
    "2nde": "2nde",
    "1ere-spe": "1re Spé PC",
    "1ere-ens-scientifique": "1re ES",
    "terminale-spe": "Term. Spé PC",
    "terminale-ens-scientifique": "Term. ES",
  };
  return map[slug] ?? getLevelLabel(slug);
}

const allMeta = import.meta.glob("/src/data/chapters/**/meta.json", { eager: true });

interface ChapterInfo extends CatalogueChapterItem {
  matiere: "chimie" | "physique";
}

const chapters: ChapterInfo[] = [];
for (const [path, mod] of Object.entries(allMeta)) {
  const segments = path.replace("/src/data/chapters/", "").replace("/meta.json", "").split("/");
  const [cycle, niv, matiere, slug] = segments;
  if (cycle === "lycee" && niv === niveau && (matiere === "chimie" || matiere === "physique")) {
    const data = (mod as any).default ?? mod;
    chapters.push({
      title: data.title ?? slug,
      href: `/lycee/${niveau}/${matiere}/${slug}`,
      matiere,
      order: data.order ?? 99,
      description: data.description ?? "",
      badges: [
        isTeachingScience ? discipline.label : matiere === "chimie" ? "Chimie" : "Physique",
        `Chapitre ${data.order ?? "à placer"}`,
      ],
    });
  }
}

const chimie = chapters.filter((chapter) => chapter.matiere === "chimie");
const physique = chapters.filter((chapter) => chapter.matiere === "physique");
const total = chapters.length;
const chimieTitle = isTeachingScience ? "Repères chimie et vivant" : "Chimie";
const physiqueTitle = isTeachingScience ? "Repères physique et Terre" : "Physique";
const landingTone = isTeachingScience ? "science" : "pc";
---

<BaseLayout
  title={`${niveauLabel} — Lycée — ${discipline.label}`}
  description={`Catalogue des chapitres pour ${niveauLabel} au lycée.`}
>
  <main class="catalogue-page">
    <Breadcrumb
      items={[
        { label: "Accueil", href: "/" },
        { label: "Lycée", href: "/lycee" },
        { label: niveauLabel },
      ]}
    />

    <nav class="level-nav" aria-label="Niveaux lycée">
      {lyceeLevels.map((level) => (
        <a
          href={`/lycee/${level.slug}`}
          class:list={["nav-pill", { active: level.slug === niveau }]}
          aria-current={level.slug === niveau ? "page" : undefined}
        >
          {getShortLabel(level.slug)}
        </a>
      ))}
    </nav>

    <V3LandingHero
      tone={landingTone}
      eyebrow={discipline.label}
      mark={discipline.mark}
      markLabel={discipline.iconLabel}
      title={isTeachingScience ? niveauLabel : `${niveauLabel} - Physique-Chimie`}
      description="Les chapitres sont classés dans l’ordre du programme pour accéder rapidement aux cours et aux activités."
      actions={total > 0
        ? [
            { label: "Voir les chapitres", href: "#catalogue-tous" },
            { label: "Outils du lycée", href: "/outils-methodes/lycee", variant: "secondary" },
          ]
        : [
            { label: "Retour aux parcours", href: "/lycee" },
            { label: "Outils du lycée", href: "/outils-methodes/lycee", variant: "secondary" },
          ]}
      stats={[
        { value: total, label: "chapitres" },
        { value: chimie.length, label: chimieTitle.toLowerCase() },
        { value: physique.length, label: physiqueTitle.toLowerCase() },
      ]}
      imageAlt={`Espace de travail pour ${discipline.label} au niveau ${niveauLabel}.`}
      contained
    />

    {total > 0 && (
      <nav class="catalogue-filters" aria-label="Filtres de catalogue">
        <a href="#catalogue-tous">Tous</a>
        <a href="#catalogue-chimie">{chimieTitle}</a>
        <a href="#catalogue-physique">{physiqueTitle}</a>
      </nav>
    )}

    {total === 0 ? (
      <section class="catalogue-empty-large" id="catalogue-tous" aria-labelledby="empty-title">
        <h2 id="empty-title">Cette partie est en préparation</h2>
        <p>Les chapitres de {niveauLabel} ne sont pas encore publiés. Tu peux revenir aux niveaux lycée ou travailler les méthodes utiles en attendant.</p>
        <div class="catalogue-empty-large__actions">
          <a class="primary" href="/lycee">Retour aux niveaux lycée</a>
          <a href="/outils-methodes/lycee">Voir les outils lycée</a>
        </div>
      </section>
    ) : (
      <div class="catalogue-layout" id="catalogue-tous">
        <CatalogueChapterList
          id="catalogue-chimie"
          title={chimieTitle}
          chapters={chimie}
          accent={isTeachingScience ? "science" : "chemistry"}
          emptyTitle={`${chimieTitle} en préparation`}
          emptyMessage={`Aucun chapitre n'est encore publié dans ce regroupement pour ${niveauLabel}.`}
          emptyActions={[
            { label: `Voir ${physiqueTitle.toLowerCase()}`, href: `/lycee/${niveau}/physique`, primary: true },
            { label: "Méthodes lycée", href: "/outils-methodes/lycee" },
          ]}
        />
        <CatalogueChapterList
          id="catalogue-physique"
          title={physiqueTitle}
          chapters={physique}
          accent={isTeachingScience ? "science" : "physics"}
          emptyTitle={`${physiqueTitle} en préparation`}
          emptyMessage={`Aucun chapitre n'est encore publié dans ce regroupement pour ${niveauLabel}.`}
          emptyActions={[
            { label: `Voir ${chimieTitle.toLowerCase()}`, href: `/lycee/${niveau}/chimie`, primary: true },
            { label: "Méthodes lycée", href: "/outils-methodes/lycee" },
          ]}
        />
      </div>
    )}
  </main>
</BaseLayout>

<style>
  .catalogue-page {
    margin: 0 auto;
    max-width: 1080px;
    padding: 1rem 1rem 3rem;
  }

  .level-nav,
  .catalogue-filters {
    align-items: center;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin: 1rem auto;
    padding: 0.75rem 1rem;
  }

  .catalogue-filters {
    justify-content: flex-start;
  }

  .catalogue-filters a,
  .catalogue-empty-large__actions a {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-pill);
    color: var(--discipline-accent, var(--accent-primary));
    font-weight: 850;
    min-height: 40px;
    padding: 0.45rem 0.75rem;
    text-decoration: none;
  }

  .catalogue-filters a:hover,
  .catalogue-filters a:focus-visible,
  .catalogue-empty-large__actions a:hover,
  .catalogue-empty-large__actions a:focus-visible {
    box-shadow: var(--v3-shadow-focus);
    outline: none;
  }

  .catalogue-hero {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-left: 5px solid var(--discipline-accent);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    display: grid;
    gap: var(--v3-space-3);
    margin: 1rem auto 1.25rem;
    padding: clamp(1rem, 2.5vw, 1.5rem);
  }

  .discipline-badge {
    align-items: center;
    background: var(--discipline-surface);
    border: 1px solid var(--discipline-border);
    border-radius: var(--radius-pill);
    color: var(--discipline-accent);
    display: inline-flex;
    font-size: 0.82rem;
    font-weight: 900;
    gap: 0.45rem;
    justify-self: start;
    min-height: 34px;
    padding: 0.32rem 0.7rem;
  }

  .discipline-badge span {
    background: var(--bg-card);
    border-radius: var(--v3-radius-sm);
    min-width: 26px;
    padding: 0.08rem 0.22rem;
    text-align: center;
  }

  .catalogue-hero h1,
  .catalogue-empty-large h2 {
    color: var(--text-primary);
    font-size: clamp(1.65rem, 4vw, 2.35rem);
    letter-spacing: 0;
    margin: 0;
  }

  .catalogue-hero p,
  .catalogue-empty-large p {
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
    max-width: 78ch;
  }

  .catalogue-stats {
    display: grid;
    gap: var(--v3-space-3);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
  }

  .catalogue-stats div,
  .catalogue-empty-large {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: var(--v3-space-3);
  }

  .catalogue-stats dt {
    color: var(--discipline-accent);
    font-size: 1.35rem;
    font-weight: 950;
  }

  .catalogue-stats dd {
    color: var(--text-secondary);
    font-weight: 800;
    margin: 0;
  }

  .catalogue-layout {
    display: grid;
    gap: var(--v3-space-4);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .catalogue-empty-large {
    display: grid;
    gap: var(--v3-space-3);
    margin: 1rem auto;
    max-width: 760px;
    text-align: center;
  }

  .catalogue-empty-large__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--v3-space-2);
    justify-content: center;
  }

  .catalogue-empty-large__actions a.primary {
    background: var(--discipline-accent, var(--accent-primary));
    border-color: var(--discipline-accent, var(--accent-primary));
    color: #fff;
  }

  @media (max-width: 860px) {
    .catalogue-layout,
    .catalogue-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
