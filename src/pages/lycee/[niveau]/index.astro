---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  getDisciplineIdentity,
  getPhysiqueChimieTrackFromLevelSlug,
} from "../../../data/disciplineIdentity";
import { lyceeLevels, getLevelLabel } from "../../../data/levels";
import { getPhysicalScienceExplicitChapterPath, type PhysicalScienceSubject } from "../../../data/contentRoutes";

export function getStaticPaths() {
  return lyceeLevels.map((level) => ({ params: { niveau: level.slug } }));
}

const { niveau } = Astro.params;
const niveauLabel = getLevelLabel(niveau!);
const parentDiscipline = getDisciplineIdentity("physique-chimie");
const track = getDisciplineIdentity(getPhysiqueChimieTrackFromLevelSlug(niveau));
const isTeachingScience = track.id === "enseignement-scientifique";

function getShortLabel(slug: string): string {
  const map: Record<string, string> = {
    "2nde": "2nde",
    "1ere-spe": "1re Spé PC",
    "1ere-ens-scientifique": "1re ES",
    "terminale-spe": "Term. Spé PC",
    "terminale-ens-scientifique": "Term. ES",
  };
  return map[slug] ?? getLevelLabel(slug);
}

const allMeta = import.meta.glob("/src/data/chapters/**/meta.json", { eager: true });

interface ChapterInfo {
  title: string;
  href: string;
  matiere: "chimie" | "physique";
  order: number;
  description: string;
}

const chapters: ChapterInfo[] = [];
for (const [path, mod] of Object.entries(allMeta)) {
  const segments = path.replace("/src/data/chapters/", "").replace("/meta.json", "").split("/");
  const [cycle, niv, matiere, slug] = segments;
  if (cycle === "lycee" && niv === niveau && (matiere === "chimie" || matiere === "physique")) {
    const data = (mod as any).default ?? mod;
    chapters.push({
      title: data.title ?? slug,
      href: getPhysicalScienceExplicitChapterPath("lycee", niveau!, matiere as PhysicalScienceSubject, slug),
      matiere,
      order: data.order ?? 99,
      description: data.description ?? "",
    });
  }
}

const chimie = chapters.filter((chapter) => chapter.matiere === "chimie").sort((a,b)=>a.order-b.order);
const physique = chapters.filter((chapter) => chapter.matiere === "physique").sort((a,b)=>a.order-b.order);
const total = chapters.length;
const chimieTitle = isTeachingScience ? "Chimie et vivant" : "Chimie";
const physiqueTitle = isTeachingScience ? "Physique et Terre" : "Physique";
---

<BaseLayout
  title={`${niveauLabel} — Lycée — ${isTeachingScience ? track.label : parentDiscipline.label}`}
  description={`Catalogue des chapitres pour ${niveauLabel} dans l’espace Physique-Chimie du lycée.`}
  subject="physique-chimie"
  cycle="lycee"
  level={niveauLabel}
>
  <div class="ui5-page" data-subject="physique-chimie" data-ui5-catalogue>
    <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">/</span>
      <a href="/physique-chimie">Physique-Chimie</a><span aria-hidden="true">/</span>
      <a href="/lycee">Lycée</a><span aria-hidden="true">/</span>
      <strong>{niveauLabel}</strong>
    </nav>

    <header class="ui5-page-header">
      <div class="ui5-page-header__copy">
        <p class="ui5-kicker">{isTeachingScience ? `${parentDiscipline.label} · ${track.label}` : parentDiscipline.label}</p>
        <h1 class="ui5-title">{isTeachingScience ? niveauLabel : `${niveauLabel} — Physique-Chimie`}</h1>
        <p class="ui5-lead">Les chapitres sont classés dans l’ordre du programme et utilisent tous la même interface de cours et d’entraînement.</p>
      </div>
      <div class="ui5-page-header__aside">
        <strong>{track.label}</strong>
        <p>{total} chapitre{total > 1 ? "s" : ""} · {physique.length} physique · {chimie.length} chimie</p>
      </div>
    </header>

    <nav class="ui5-filter-row" aria-label="Parcours lycée">
      {lyceeLevels.map((level) => (
        <a class="ui5-filter" href={`/lycee/${level.slug}`} aria-current={level.slug === niveau ? "true" : undefined}>
          {getShortLabel(level.slug)}
        </a>
      ))}
    </nav>

    {total > 0 ? (
      <>
        <section class="ui5-section">
          <div class="ui5-toolbar">
            <label for="ui5-level-search">Rechercher dans ce parcours</label>
            <div class="ui5-search"><input id="ui5-level-search" type="search" placeholder="Titre, notion ou thème…" autocomplete="off" data-ui5-search /></div>
            <p class="ui5-toolbar__summary" aria-live="polite" data-ui5-summary>{total} chapitre{total > 1 ? "s" : ""}</p>
          </div>
        </section>

        {chimie.length > 0 && (
          <section class="ui5-section ui5-catalogue-section" data-accent={isTeachingScience ? "science" : "chemistry"} aria-labelledby="ui5-chimie-title">
            <div class="ui5-section-head"><h2 id="ui5-chimie-title">{chimieTitle}</h2><p>{chimie.length} chapitre{chimie.length > 1 ? "s" : ""}</p></div>
            <ol class="ui5-chapter-list">
              {chimie.map((chapter,index)=>(
                <li data-ui5-item data-search-text={`${chapter.title} ${chapter.description} chimie`.toLocaleLowerCase("fr-FR")}>
                  <a class="ui5-card ui5-chapter-card" href={chapter.href}>
                    <span class="ui5-chapter-card__index">{String(index+1).padStart(2,"0")}</span>
                    <span class="ui5-chapter-card__body">
                      <strong>{chapter.title}</strong>
                      {chapter.description && <span>{chapter.description}</span>}
                      <span class="ui5-chapter-card__meta"><em class="ui5-chip">{chimieTitle}</em><em class="ui5-chip">Chapitre {chapter.order}</em></span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )}

        {physique.length > 0 && (
          <section class="ui5-section ui5-catalogue-section" data-accent={isTeachingScience ? "science" : "physics"} aria-labelledby="ui5-physique-title">
            <div class="ui5-section-head"><h2 id="ui5-physique-title">{physiqueTitle}</h2><p>{physique.length} chapitre{physique.length > 1 ? "s" : ""}</p></div>
            <ol class="ui5-chapter-list">
              {physique.map((chapter,index)=>(
                <li data-ui5-item data-search-text={`${chapter.title} ${chapter.description} physique`.toLocaleLowerCase("fr-FR")}>
                  <a class="ui5-card ui5-chapter-card" href={chapter.href}>
                    <span class="ui5-chapter-card__index">{String(index+1).padStart(2,"0")}</span>
                    <span class="ui5-chapter-card__body">
                      <strong>{chapter.title}</strong>
                      {chapter.description && <span>{chapter.description}</span>}
                      <span class="ui5-chapter-card__meta"><em class="ui5-chip">{physiqueTitle}</em><em class="ui5-chip">Chapitre {chapter.order}</em></span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )}

        <p class="ui5-no-results" data-ui5-no-results hidden>Aucun chapitre ne correspond à cette recherche.</p>
      </>
    ) : (
      <section class="ui5-section">
        <div class="ui5-card ui5-empty">
          <h2>Cette partie est en préparation</h2>
          <p>Les chapitres de {niveauLabel} ne sont pas encore publiés.</p>
          <div><a class="ui5-button ui5-button--primary" href="/lycee">Retour aux parcours</a></div>
        </div>
      </section>
    )}
  </div>

  <script>
    const root = document.querySelector<HTMLElement>("[data-ui5-catalogue]");
    const input = root?.querySelector<HTMLInputElement>("[data-ui5-search]");
    const items = Array.from(root?.querySelectorAll<HTMLElement>("[data-ui5-item]") ?? []);
    const summary = root?.querySelector<HTMLElement>("[data-ui5-summary]");
    const noResults = root?.querySelector<HTMLElement>("[data-ui5-no-results]");
    input?.addEventListener("input", () => {
      const query = input.value.trim().toLocaleLowerCase("fr-FR");
      let visible = 0;
      items.forEach((item) => {
        const matches = !query || (item.dataset.searchText ?? "").includes(query);
        item.hidden = !matches;
        if (matches) visible += 1;
      });
      if (summary) summary.textContent = `${visible} chapitre${visible > 1 ? "s" : ""}`;
      if (noResults) noResults.hidden = visible > 0;
    });
  </script>
</BaseLayout>
