---
import {
  getPhysicalScienceRoutePair,
  type PhysicalScienceSubject,
} from "../../../../data/contentRoutes";

export function getStaticPaths() {
  const allMeta = import.meta.glob("/src/data/chapters/**/meta.json", { eager: true });
  const paths: { params: { niveau: string; matiere: string; chapitre: string } }[] = [];
  for (const [path] of Object.entries(allMeta)) {
    const segments = path.replace("/src/data/chapters/", "").replace("/meta.json", "").split("/");
    const [cycle, niveau, matiere, chapitre] = segments;
    if (cycle === "lycee") paths.push({ params: { niveau, matiere, chapitre } });
  }
  return paths;
}

const { niveau, matiere, chapitre } = Astro.params;
if (!niveau || !matiere || !chapitre || (matiere !== "physique" && matiere !== "chimie")) {
  throw new Error("Route historique de chapitre Physique-Chimie invalide.");
}

const routePair = getPhysicalScienceRoutePair({
  cycle: "lycee",
  niveau,
  matiere: matiere as PhysicalScienceSubject,
  chapitre,
});

return Astro.redirect(routePair.canonicalPath, routePair.redirectStatus);
---
