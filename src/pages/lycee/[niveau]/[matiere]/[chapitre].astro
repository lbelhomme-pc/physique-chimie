---
import ChapterPageShell from "../../../../components/pedagogie/ChapterPageShell.astro";
import { getDisciplineFromLevelSlug, getDisciplineIdentity } from "../../../../data/disciplineIdentity";
import { getLevelLabel, getMatiereLabel } from "../../../../data/levels";
import {
  getChapterNavigation,
  getPhysicalScienceLevelPath,
  getPhysicalScienceRouteContext,
  getPhysicalScienceSubjectPath,
  type PhysicalScienceSubject,
} from "../../../../data/contentRoutes";

export function getStaticPaths() {
  const allMeta = import.meta.glob("/src/data/chapters/**/meta.json", { eager: true });
  const paths: { params: { niveau: string; matiere: string; chapitre: string } }[] = [];
  for (const [path] of Object.entries(allMeta)) {
    const segments = path.replace("/src/data/chapters/", "").replace("/meta.json", "").split("/");
    const [cycle, niv, mat, chap] = segments;
    if (cycle === "lycee") paths.push({ params: { niveau: niv, matiere: mat, chapitre: chap } });
  }
  return paths;
}

const allMeta = import.meta.glob("/src/data/chapters/**/meta.json", { eager: true });
const allCours = import.meta.glob("/src/data/chapters/**/cours.mdx", { eager: true });
const allExo = import.meta.glob("/src/data/chapters/**/exercices.json", { eager: true });
const allQuiz = import.meta.glob("/src/data/chapters/**/quiz.json", { eager: true });
const allFlash = import.meta.glob("/src/data/chapters/**/flashcards.json", { eager: true });

const { niveau, matiere, chapitre } = Astro.params;
const subject = matiere as PhysicalScienceSubject;
const context = getPhysicalScienceRouteContext("lycee", niveau!, subject, chapitre!);
const niveauLabel = getLevelLabel(niveau!);
const matiereLabel = getMatiereLabel(matiere!);
const discipline = getDisciplineIdentity(getDisciplineFromLevelSlug(niveau));
const isTeachingScience = discipline.id === "enseignement-scientifique";
const subjectDisplayLabel = isTeachingScience
  ? matiere === "chimie" ? "Repères chimie et vivant" : "Repères physique et Terre"
  : matiereLabel;
const basePath = `/src/data/chapters/lycee/${niveau}/${matiere}/${chapitre}`;
const chapterId = `lycee/${niveau}/${matiere}/${chapitre}`;
const backUrl = getPhysicalScienceLevelPath("lycee", niveau!);
const subjectUrl = getPhysicalScienceSubjectPath("lycee", niveau!, subject);

const metaMod = allMeta[`${basePath}/meta.json`] as any;
const meta = metaMod?.default ?? metaMod ?? {};
const xpConfig = meta.xp ?? undefined;
const seo = meta.seo ?? {};
const displayTitle = meta.title ?? chapitre;
const pageTitle = `${displayTitle} — ${matiereLabel} ${niveauLabel}`;

function textOrFallback(value: unknown, fallback: string): string {
  return typeof value === "string" && value.trim() ? value.trim() : fallback;
}

function localImageOrFallback(value: unknown, fallback: string): string {
  return typeof value === "string" && value.trim().startsWith("/") ? value.trim() : fallback;
}

function getArray(raw: any, key: string): any[] {
  if (Array.isArray(raw)) return raw;
  if (raw && Array.isArray(raw[key])) return raw[key];
  return [];
}

function getTextArray(raw: unknown): string[] {
  if (Array.isArray(raw)) {
    return raw.filter((item): item is string => typeof item === "string").map((item) => item.trim()).filter(Boolean);
  }
  if (typeof raw === "string" && raw.trim()) return [raw.trim()];
  return [];
}

const seoTitle = textOrFallback(seo.meta_title, pageTitle);
const seoDescription = textOrFallback(
  seo.meta_description,
  textOrFallback(meta.description, `Cours de ${matiereLabel.toLowerCase()} ${niveauLabel} : ${displayTitle}.`)
);
const schemaType = textOrFallback(seo.schema_type, "EducationalContent") === "EducationalContent"
  ? "Course"
  : textOrFallback(seo.schema_type, "Course");
const ogImage = localImageOrFallback(seo.ogImage ?? seo.og_image ?? meta.ogImage ?? meta.og_image, "/og-image.png");
const learningObjectives = getTextArray(meta.objectives ?? meta.objectifs ?? meta.objective ?? meta.description);
const prerequisites = getTextArray(meta.prerequisites ?? meta.prerequis);
const competencies = getTextArray(meta.competencies ?? meta.competences);
const tools = getTextArray(meta.tools ?? meta.outils);
const estimatedDuration = typeof meta.duration === "number" || typeof meta.duration === "string" ? meta.duration : undefined;

const coursMod = allCours[`${basePath}/cours.mdx`] as any;
const CoursContent = coursMod?.Content ?? null;
const exercices = getArray((allExo[`${basePath}/exercices.json`] as any)?.default ?? null, "exercices");
const quizData = getArray((allQuiz[`${basePath}/quiz.json`] as any)?.default ?? null, "questions");
const flashData = getArray((allFlash[`${basePath}/flashcards.json`] as any)?.default ?? null, "cards");

const chapterNavigation = Object.entries(allMeta)
  .map(([path, mod]) => {
    const segments = path.replace("/src/data/chapters/", "").replace("/meta.json", "").split("/");
    const [cycle, chapterNiveau, chapterMatiere, slug] = segments;
    const data = (mod as any).default ?? mod;
    return { cycle, chapterNiveau, chapterMatiere, slug, title: data.title ?? slug, order: data.order ?? 99 };
  })
  .filter((item) => item.cycle === "lycee" && item.chapterNiveau === niveau && item.chapterMatiere === matiere);

const { previousChapter, nextChapter } = getChapterNavigation(
  chapterNavigation,
  chapitre!,
  (slug) => `/lycee/${niveau}/${matiere}/${slug}`,
);
---

<ChapterPageShell
  title={seoTitle}
  description={seoDescription}
  canonical={context.canonical}
  ogImage={ogImage}
  schemaType={schemaType}
  breadcrumbItems={[
    { label: "Accueil", href: "/" },
    { label: "Lycée", href: "/lycee" },
    { label: niveauLabel, href: backUrl },
    { label: subjectDisplayLabel, href: subjectUrl },
    { label: displayTitle },
  ]}
  displayTitle={displayTitle}
  chapterDescription={textOrFallback(meta.description, seoDescription)}
  eyebrow={isTeachingScience ? `${discipline.label} ${niveauLabel}` : `${matiereLabel} ${niveauLabel}`}
  theme={meta.theme ? `Thème : ${meta.theme}` : undefined}
  badges={isTeachingScience ? [
    { label: discipline.label },
    { label: subjectDisplayLabel, muted: true },
  ] : []}
  levelLabel={niveauLabel}
  subjectLabel={isTeachingScience ? discipline.shortLabel : matiereLabel}
  objectives={learningObjectives}
  prerequisites={prerequisites}
  competencies={competencies}
  tools={tools}
  estimatedDuration={estimatedDuration}
  chapterId={chapterId}
  xpConfig={xpConfig}
  CoursContent={CoursContent}
  exercices={exercices}
  quizData={quizData}
  flashData={flashData}
  backUrl={backUrl}
  backLabel="Retour"
  previousChapter={previousChapter}
  nextChapter={nextChapter}
  indexHref={subjectUrl}
  indexLabel="Liste des chapitres"
  exercicesTitle={`Exercices par niveaux — ${displayTitle}`}
  quizTitle={`Quiz — ${displayTitle}`}
  flashcardsTitle={`Flashcards — ${displayTitle}`}
/>
