---
// src/pages/lycee/[niveau]/[matiere]/index.astro
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import CatalogueChapterList from "../../../../components/catalogue/CatalogueChapterList.astro";
import type { CatalogueChapterItem } from "../../../../components/catalogue/types";
import Breadcrumb from "../../../../components/ui/Breadcrumb.astro";
import { getDisciplineFromLevelSlug, getDisciplineIdentity, getDisciplineStyle } from "../../../../data/disciplineIdentity";
import { lyceeLevels, matieres, getLevelLabel, getMatiereLabel } from "../../../../data/levels";

const allMeta = import.meta.glob("/src/data/chapters/**/meta.json", { eager: true });

export function getStaticPaths() {
  const paths: { params: { niveau: string; matiere: string } }[] = [];
  for (const level of lyceeLevels) {
    for (const matiere of matieres) {
      paths.push({ params: { niveau: level.slug, matiere: matiere.slug } });
    }
  }
  return paths;
}

const { niveau, matiere } = Astro.params;
const niveauLabel = getLevelLabel(niveau!);
const matiereLabel = getMatiereLabel(matiere!);
const discipline = getDisciplineIdentity(getDisciplineFromLevelSlug(niveau));
const isTeachingScience = discipline.id === "enseignement-scientifique";
const accent = isTeachingScience ? "science" : matiere === "chimie" ? "chemistry" : "physics";
const otherMatiere = matiere === "chimie" ? "physique" : "chimie";
const otherMatiereLabel = getMatiereLabel(otherMatiere);
const catalogueTitle = isTeachingScience
  ? matiere === "chimie" ? "Repères chimie et vivant" : "Repères physique et Terre"
  : matiereLabel;

const chapters: CatalogueChapterItem[] = [];

for (const [path, mod] of Object.entries(allMeta)) {
  const segments = path.replace("/src/data/chapters/", "").replace("/meta.json", "").split("/");
  const [cycle, niv, mat, slug] = segments;

  if (cycle === "lycee" && niv === niveau && mat === matiere) {
    const data = (mod as any).default ?? mod;
    chapters.push({
      title: data.title ?? slug,
      href: `/lycee/${niveau}/${matiere}/${slug}`,
      order: data.order ?? 99,
      description: data.description ?? "",
      badges: [isTeachingScience ? discipline.label : matiereLabel, `Chapitre ${data.order ?? "à placer"}`],
    });
  }
}
---

<BaseLayout
  title={`${catalogueTitle} ${niveauLabel} — Lycée`}
  description={`Catalogue des chapitres pour ${catalogueTitle.toLowerCase()} en ${niveauLabel}.`}
>
  <main class="catalogue-page">
    <Breadcrumb
      items={[
        { label: "Accueil", href: "/" },
        { label: "Lycée", href: "/lycee" },
        { label: niveauLabel, href: `/lycee/${niveau}` },
        { label: catalogueTitle },
      ]}
    />

    <header class="catalogue-hero" data-discipline={discipline.id} style={getDisciplineStyle(discipline)}>
      <span class="discipline-badge" aria-label={discipline.iconLabel}>
        <span aria-hidden="true">{discipline.mark}</span>
        <strong>{discipline.label}</strong>
      </span>
      <p class="catalogue-kicker">Lycée · {catalogueTitle}</p>
      <h1>{catalogueTitle} — {niveauLabel}</h1>
      <p>Les chapitres sont présentés dans l'ordre du programme. Ouvre un chapitre pour accéder au lecteur complet.</p>
      <div class="catalogue-actions" aria-label="Navigation de catalogue">
        <a href={`/lycee/${niveau}`}>Tous les regroupements</a>
        <a href={`/lycee/${niveau}/${otherMatiere}`}>Voir {otherMatiereLabel.toLowerCase()}</a>
      </div>
    </header>

    <CatalogueChapterList
      id="chapitres"
      title={`Chapitres · ${catalogueTitle}`}
      chapters={chapters}
      accent={accent}
      emptyTitle="Ce regroupement est en préparation"
      emptyMessage={`Aucun chapitre n'est encore publié ici pour ${niveauLabel}.`}
      emptyActions={[
        { label: "Retour au niveau", href: `/lycee/${niveau}`, primary: true },
        { label: "Voir les outils lycée", href: "/outils-methodes/lycee" },
      ]}
    />
  </main>
</BaseLayout>

<style>
  .catalogue-page {
    margin: 0 auto;
    max-width: 900px;
    padding: 1rem 1rem 3rem;
  }

  .catalogue-hero {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-left: 5px solid var(--discipline-accent);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    display: grid;
    gap: var(--v3-space-3);
    margin: 1rem auto 1.25rem;
    padding: clamp(1rem, 2.5vw, 1.5rem);
  }

  .discipline-badge {
    align-items: center;
    background: var(--discipline-surface);
    border: 1px solid var(--discipline-border);
    border-radius: var(--radius-pill);
    color: var(--discipline-accent);
    display: inline-flex;
    font-size: 0.82rem;
    font-weight: 900;
    gap: 0.45rem;
    justify-self: start;
    min-height: 34px;
    padding: 0.32rem 0.7rem;
  }

  .discipline-badge span {
    background: var(--bg-card);
    border-radius: var(--v3-radius-sm);
    min-width: 26px;
    padding: 0.08rem 0.22rem;
    text-align: center;
  }

  .catalogue-kicker {
    color: var(--discipline-accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0;
    margin: 0;
    text-transform: uppercase;
  }

  .catalogue-hero h1 {
    color: var(--text-primary);
    font-size: clamp(1.55rem, 4vw, 2.2rem);
    letter-spacing: 0;
    margin: 0;
  }

  .catalogue-hero p {
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0;
  }

  .catalogue-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--v3-space-2);
  }

  .catalogue-actions a {
    align-items: center;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-pill);
    color: var(--discipline-accent);
    display: inline-flex;
    font-weight: 900;
    min-height: 44px;
    padding: 0.55rem 0.85rem;
    text-decoration: none;
  }

  .catalogue-actions a:hover,
  .catalogue-actions a:focus-visible {
    box-shadow: var(--v3-shadow-focus);
    outline: none;
  }
</style>
