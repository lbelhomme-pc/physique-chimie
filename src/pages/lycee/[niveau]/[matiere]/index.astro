---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import CatalogueChapterList from "../../../../components/catalogue/CatalogueChapterList.astro";
import type { CatalogueChapterItem } from "../../../../components/catalogue/types";
import { getDisciplineIdentity, getPhysiqueChimieTrackFromLevelSlug } from "../../../../data/disciplineIdentity";
import { lyceeLevels, matieres, getLevelLabel, getMatiereLabel } from "../../../../data/levels";
import { getPhysicalScienceExplicitChapterPath, type PhysicalScienceSubject } from "../../../../data/contentRoutes";

const allMeta = import.meta.glob("/src/data/chapters/**/meta.json", { eager: true });

export function getStaticPaths() {
  const paths: { params: { niveau: string; matiere: string } }[] = [];
  for (const level of lyceeLevels) for (const matiere of matieres) paths.push({ params: { niveau: level.slug, matiere: matiere.slug } });
  return paths;
}

const { niveau, matiere } = Astro.params;
const niveauLabel = getLevelLabel(niveau!);
const matiereLabel = getMatiereLabel(matiere!);
const parentDiscipline = getDisciplineIdentity("physique-chimie");
const track = getDisciplineIdentity(getPhysiqueChimieTrackFromLevelSlug(niveau));
const isTeachingScience = track.id === "enseignement-scientifique";
const accent = isTeachingScience ? "science" : matiere === "chimie" ? "chemistry" : "physics";
const otherMatiere = matiere === "chimie" ? "physique" : "chimie";
const otherMatiereLabel = getMatiereLabel(otherMatiere);
const catalogueTitle = isTeachingScience
  ? matiere === "chimie" ? "Chimie et vivant" : "Physique et Terre"
  : matiereLabel;

const chapters: CatalogueChapterItem[] = [];
for (const [path, mod] of Object.entries(allMeta)) {
  const segments = path.replace("/src/data/chapters/", "").replace("/meta.json", "").split("/");
  const [cycle, niv, mat, slug] = segments;
  if (cycle === "lycee" && niv === niveau && mat === matiere) {
    const data = (mod as any).default ?? mod;
    chapters.push({
      title: data.title ?? slug,
      href: getPhysicalScienceExplicitChapterPath("lycee", niveau!, matiere as PhysicalScienceSubject, slug),
      order: data.order ?? 99,
      description: data.description ?? "",
      badges: [isTeachingScience ? track.label : matiereLabel, `Chapitre ${data.order ?? "à placer"}`],
    });
  }
}
---

<BaseLayout
  title={`${catalogueTitle} ${niveauLabel} — Lycée`}
  description={`Catalogue des chapitres pour ${catalogueTitle.toLowerCase()} en ${niveauLabel}, dans l’espace Physique-Chimie.`}
  subject="physique-chimie"
  cycle="lycee"
  level={niveauLabel}
>
  <div class="ui5-page" data-subject="physique-chimie">
    <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">/</span>
      <a href={parentDiscipline.href}>Physique-Chimie</a><span aria-hidden="true">/</span>
      <a href="/lycee">Lycée</a><span aria-hidden="true">/</span>
      <a href={`/lycee/${niveau}`}>{niveauLabel}</a><span aria-hidden="true">/</span>
      <strong>{catalogueTitle}</strong>
    </nav>

    <header class="ui5-page-header">
      <div class="ui5-page-header__copy">
        <p class="ui5-kicker">{isTeachingScience ? track.label : `Lycée · ${catalogueTitle}`}</p>
        <h1 class="ui5-title">{catalogueTitle} — {niveauLabel}</h1>
        <p class="ui5-lead">Les chapitres suivent l’ordre du programme et ouvrent tous sur le même espace de travail.</p>
      </div>
      <div class="ui5-page-header__aside"><strong>{chapters.length} chapitre{chapters.length > 1 ? "s" : ""}</strong></div>
    </header>

    <nav class="ui5-filter-row" aria-label="Navigation de catalogue">
      <a class="ui5-filter" href={`/lycee/${niveau}`}>Tous les regroupements</a>
      <a class="ui5-filter" href={`/lycee/${niveau}/${otherMatiere}`}>Voir {otherMatiereLabel.toLowerCase()}</a>
    </nav>

    <CatalogueChapterList
      id="chapitres"
      title={`Chapitres · ${catalogueTitle}`}
      chapters={chapters}
      accent={accent}
      emptyTitle="Ce regroupement est en préparation"
      emptyMessage={`Aucun chapitre n'est encore publié ici pour ${niveauLabel}.`}
      emptyActions={[
        { label: "Retour au niveau", href: `/lycee/${niveau}`, primary: true },
        { label: "Voir les outils lycée", href: "/outils-methodes/lycee" },
      ]}
    />
  </div>
</BaseLayout>
