---
// UI V5 — page d'entrée lycée Physique-Chimie
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getDisciplineIdentity,
  getPhysiqueChimieTrackFromLevelSlug,
} from "../../data/disciplineIdentity";
import { lyceeLevels, getLevelLabel } from "../../data/levels";

const allMeta = import.meta.glob("/src/data/chapters/lycee/**/meta.json", { eager: true });

function getShortLabel(slug: string): string {
  const map: Record<string, string> = {
    "2nde": "Seconde",
    "1ere-spe": "1re spécialité PC",
    "1ere-ens-scientifique": "1re enseignement scientifique",
    "terminale-spe": "Terminale spécialité PC",
    "terminale-ens-scientifique": "Terminale enseignement scientifique",
  };
  return map[slug] ?? getLevelLabel(slug);
}

function countChapters(levelSlug: string, matiere?: string) {
  return Object.keys(allMeta).filter((path) => {
    const segments = path.replace("/src/data/chapters/", "").replace("/meta.json", "").split("/");
    const [, niveau, chapterMatiere] = segments;
    return niveau === levelSlug && (!matiere || chapterMatiere === matiere);
  }).length;
}

const levelCards = lyceeLevels.map((level) => {
  const trackId = getPhysiqueChimieTrackFromLevelSlug(level.slug);
  const track = getDisciplineIdentity(trackId);
  const chimie = countChapters(level.slug, "chimie");
  const physique = countChapters(level.slug, "physique");
  const total = chimie + physique;
  return {
    ...level,
    label: getShortLabel(level.slug),
    fullLabel: getLevelLabel(level.slug),
    chimie,
    physique,
    total,
    track,
    trackId,
  };
});
---

<BaseLayout
  title="Lycée — Physique-Chimie et Enseignement scientifique"
  description="Choisir son parcours dans l’espace Physique-Chimie du lycée : Seconde, spécialité Physique-Chimie et Enseignement scientifique."
  subject="physique-chimie"
  cycle="lycee"
>
  <div class="ui5-page" data-subject="physique-chimie">
    <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">/</span>
      <a href="/physique-chimie">Physique-Chimie</a><span aria-hidden="true">/</span>
      <strong>Lycée</strong>
    </nav>

    <header class="ui5-page-header">
      <div class="ui5-page-header__copy">
        <p class="ui5-kicker">Parcours lycée</p>
        <h1 class="ui5-title">Choisir un parcours</h1>
        <p class="ui5-lead">Seconde, spécialité Physique-Chimie et Enseignement scientifique utilisent désormais la même structure de navigation et de travail.</p>
      </div>
      <p class="ui5-page-header__aside">{levelCards.length} parcours · {levelCards.reduce((sum, level) => sum + level.total, 0)} chapitres publiés</p>
    </header>

    <section class="ui5-section" aria-labelledby="lycee-levels-title">
      <div class="ui5-section-head">
        <h2 id="lycee-levels-title">Parcours disponibles</h2>
        <p>Choisis d’abord le parcours, puis le chapitre.</p>
      </div>

      <div class="ui5-grid ui5-grid--2">
        {levelCards.map((level) => (
          <article class="ui5-card ui5-level-card" data-track={level.trackId}>
            <div class="ui5-level-card__top">
              <span class="ui5-level-card__badge" aria-hidden="true">{level.track.mark}</span>
              <div>
                <h3>{level.label}</h3>
                {level.fullLabel !== level.label && <p class="ui5-level-card__sublabel">{level.fullLabel}</p>}
              </div>
            </div>

            <p>{level.total > 0
              ? level.trackId === "enseignement-scientifique"
                ? `${level.total} chapitres publiés dans le parcours Enseignement scientifique.`
                : `${level.total} chapitres : ${level.physique} en physique et ${level.chimie} en chimie.`
              : "Cette partie est prévue, mais les chapitres ne sont pas encore publiés."}</p>

            <div class="ui5-chapter-card__meta">
              <em class="ui5-chip">{level.track.label}</em>
              {level.total > 0 && <em class="ui5-chip">{level.total} chapitres</em>}
            </div>

            <div class="ui5-level-card__actions">
              <a class="ui5-button ui5-button--primary" href={`/lycee/${level.slug}`}>Voir le parcours</a>
              {level.trackId === "physique-chimie" && level.chimie > 0 && <a class="ui5-button" href={`/lycee/${level.slug}/chimie`}>Chimie</a>}
              {level.trackId === "physique-chimie" && level.physique > 0 && <a class="ui5-button" href={`/lycee/${level.slug}/physique`}>Physique</a>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="ui5-section">
      <div class="ui5-card ui5-tools-row">
        <div>
          <h2>Outils et méthodes lycée</h2>
          <p>Mathématiques utiles, méthodes numériques, Python, laboratoire et ressources transversales.</p>
        </div>
        <a class="ui5-button" href="/outils-methodes/lycee">Voir les outils</a>
      </div>
    </section>
  </div>
</BaseLayout>
