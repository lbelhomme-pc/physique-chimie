---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { collegeLevels, getLevelLabel } from "../../../data/levels";
import { getPhysicalScienceExplicitChapterPath, type PhysicalScienceSubject } from "../../../data/contentRoutes";

export function getStaticPaths() {
  return collegeLevels.map((level) => ({ params: { niveau: level.slug } }));
}

const { niveau } = Astro.params;
const niveauLabel = getLevelLabel(niveau!);
const isSixiemeSciencesTechnologie = niveau === "6eme";
const pageTitle = isSixiemeSciencesTechnologie
  ? "Sciences et technologie 6e — Physique-Chimie"
  : `${niveauLabel} — Collège — Physique-Chimie`;
const pageDescription = isSixiemeSciencesTechnologie
  ? "Ressources du parcours Physique-Chimie en Sciences et technologie de 6e, thème Matière, mouvement, énergie, information du programme de cycle 3 applicable en 2026-2027."
  : `Catalogue des chapitres de physique-chimie pour le niveau ${niveauLabel} au collège.`;

const allMeta = import.meta.glob("/src/data/chapters/**/meta.json", { eager: true });

interface ChapterInfo {
  title: string;
  href: string;
  matiere: "chimie" | "physique";
  order: number;
  description: string;
}

const chapters: ChapterInfo[] = [];
for (const [path, mod] of Object.entries(allMeta)) {
  const segments = path.replace("/src/data/chapters/", "").replace("/meta.json", "").split("/");
  const [cycle, niv, matiere, slug] = segments;
  if (cycle === "college" && niv === niveau && (matiere === "chimie" || matiere === "physique")) {
    const data = (mod as any).default ?? mod;
    chapters.push({
      title: data.title ?? slug,
      href: getPhysicalScienceExplicitChapterPath("college", niveau!, matiere as PhysicalScienceSubject, slug),
      matiere,
      order: data.order ?? 99,
      description: data.description ?? "",
    });
  }
}

const chimie = chapters.filter((chapter) => chapter.matiere === "chimie").sort((a,b)=>a.order-b.order);
const physique = chapters.filter((chapter) => chapter.matiere === "physique").sort((a,b)=>a.order-b.order);
const total = chapters.length;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  subject="physique-chimie"
  cycle="college"
  level={niveauLabel}
>
  <div class="ui5-page" data-subject="physique-chimie" data-ui5-catalogue>
    <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">/</span>
      <a href="/college">Collège</a><span aria-hidden="true">/</span>
      <strong>{isSixiemeSciencesTechnologie ? "6e — Sciences et technologie" : niveauLabel}</strong>
    </nav>

    <header class="ui5-page-header">
      <div class="ui5-page-header__copy">
        <p class="ui5-kicker">{isSixiemeSciencesTechnologie ? "Sciences et technologie · Cycle 3" : "Physique-Chimie · Collège"}</p>
        <h1 class="ui5-title">{isSixiemeSciencesTechnologie ? "Sciences et technologie — 6e" : `${niveauLabel} au collège`}</h1>
        <p class="ui5-lead">
          {isSixiemeSciencesTechnologie
            ? "Parcours Physique-Chimie du programme de Sciences et technologie : matière, mouvement, énergie et information."
            : "Choisis un chapitre. Tous les chapitres utilisent ensuite la même interface pour le cours, les exercices, le quiz et les flashcards."}
        </p>
      </div>
      <p class="ui5-page-header__aside">{total} chapitre{total > 1 ? "s" : ""} · {physique.length} physique · {chimie.length} chimie</p>
    </header>

    <nav class="ui5-filter-row" aria-label="Niveaux collège">
      {collegeLevels.map((level) => (
        <a class="ui5-filter" href={`/college/${level.slug}`} aria-current={level.slug === niveau ? "true" : undefined}>
          {getLevelLabel(level.slug)}
        </a>
      ))}
    </nav>

    {total > 0 ? (
      <>
        <section class="ui5-section">
          <div class="ui5-toolbar">
            <label for="ui5-level-search">Rechercher dans ce niveau</label>
            <div class="ui5-search">
              <input id="ui5-level-search" type="search" placeholder="Titre, notion ou thème…" autocomplete="off" data-ui5-search />
            </div>
            <p class="ui5-toolbar__summary" aria-live="polite" data-ui5-summary>{total} chapitre{total > 1 ? "s" : ""}</p>
          </div>
        </section>

        {chimie.length > 0 && (
          <section class="ui5-section" aria-labelledby="ui5-chimie-title">
            <div class="ui5-section-head">
              <h2 id="ui5-chimie-title">Chimie</h2>
              <p>{chimie.length} chapitre{chimie.length > 1 ? "s" : ""}</p>
            </div>
            <ol class="ui5-chapter-list" data-ui5-list>
              {chimie.map((chapter, index) => (
                <li data-ui5-item data-search-text={`${chapter.title} ${chapter.description} chimie`.toLocaleLowerCase("fr-FR")}>
                  <a class="ui5-card ui5-chapter-card" href={chapter.href}>
                    <span class="ui5-chapter-card__index">{String(index + 1).padStart(2, "0")}</span>
                    <span class="ui5-chapter-card__body">
                      <strong>{chapter.title}</strong>
                      {chapter.description && <span>{chapter.description}</span>}
                      <span class="ui5-chapter-card__meta"><em class="ui5-chip">Chimie</em><em class="ui5-chip">Chapitre {chapter.order}</em></span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )}

        {physique.length > 0 && (
          <section class="ui5-section" aria-labelledby="ui5-physique-title">
            <div class="ui5-section-head">
              <h2 id="ui5-physique-title">Physique</h2>
              <p>{physique.length} chapitre{physique.length > 1 ? "s" : ""}</p>
            </div>
            <ol class="ui5-chapter-list" data-ui5-list>
              {physique.map((chapter, index) => (
                <li data-ui5-item data-search-text={`${chapter.title} ${chapter.description} physique`.toLocaleLowerCase("fr-FR")}>
                  <a class="ui5-card ui5-chapter-card" href={chapter.href}>
                    <span class="ui5-chapter-card__index">{String(index + 1).padStart(2, "0")}</span>
                    <span class="ui5-chapter-card__body">
                      <strong>{chapter.title}</strong>
                      {chapter.description && <span>{chapter.description}</span>}
                      <span class="ui5-chapter-card__meta"><em class="ui5-chip">Physique</em><em class="ui5-chip">Chapitre {chapter.order}</em></span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )}

        <p class="ui5-no-results" data-ui5-no-results hidden>Aucun chapitre ne correspond à cette recherche.</p>
      </>
    ) : (
      <section class="ui5-section">
        <div class="ui5-card ui5-empty">
          <h2>Cette partie est en préparation</h2>
          <p>Les chapitres de {niveauLabel} ne sont pas encore publiés.</p>
          <div><a class="ui5-button ui5-button--primary" href="/college">Retour aux niveaux</a></div>
        </div>
      </section>
    )}
  </div>

  <script>
    const root = document.querySelector<HTMLElement>("[data-ui5-catalogue]");
    const input = root?.querySelector<HTMLInputElement>("[data-ui5-search]");
    const items = Array.from(root?.querySelectorAll<HTMLElement>("[data-ui5-item]") ?? []);
    const summary = root?.querySelector<HTMLElement>("[data-ui5-summary]");
    const noResults = root?.querySelector<HTMLElement>("[data-ui5-no-results]");

    input?.addEventListener("input", () => {
      const query = input.value.trim().toLocaleLowerCase("fr-FR");
      let visible = 0;
      items.forEach((item) => {
        const matches = !query || (item.dataset.searchText ?? "").includes(query);
        item.hidden = !matches;
        if (matches) visible += 1;
      });
      if (summary) summary.textContent = `${visible} chapitre${visible > 1 ? "s" : ""}`;
      if (noResults) noResults.hidden = visible > 0;
    });
  </script>
</BaseLayout>
