---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import CatalogueChapterList from "../../../../components/catalogue/CatalogueChapterList.astro";
import type { CatalogueChapterItem } from "../../../../components/catalogue/types";
import { collegeLevels, matieres, getLevelLabel, getMatiereLabel } from "../../../../data/levels";
import { getPhysicalScienceExplicitChapterPath, type PhysicalScienceSubject } from "../../../../data/contentRoutes";

const allMeta = import.meta.glob("/src/data/chapters/**/meta.json", { eager: true });

export function getStaticPaths() {
  const paths: { params: { niveau: string; matiere: string } }[] = [];
  for (const level of collegeLevels) for (const matiere of matieres) paths.push({ params: { niveau: level.slug, matiere: matiere.slug } });
  return paths;
}

const { niveau, matiere } = Astro.params;
const niveauLabel = getLevelLabel(niveau!);
const matiereLabel = getMatiereLabel(matiere!);
const accent = matiere === "chimie" ? "chemistry" : "physics";
const otherMatiere = matiere === "chimie" ? "physique" : "chimie";
const otherMatiereLabel = getMatiereLabel(otherMatiere);

const chapters: CatalogueChapterItem[] = [];
for (const [path, mod] of Object.entries(allMeta)) {
  const segments = path.replace("/src/data/chapters/", "").replace("/meta.json", "").split("/");
  const [cycle, niv, mat, slug] = segments;
  if (cycle === "college" && niv === niveau && mat === matiere) {
    const data = (mod as any).default ?? mod;
    chapters.push({
      title: data.title ?? slug,
      href: getPhysicalScienceExplicitChapterPath("college", niveau!, matiere as PhysicalScienceSubject, slug),
      order: data.order ?? 99,
      description: data.description ?? "",
      badges: [matiereLabel, `Chapitre ${data.order ?? "à placer"}`],
    });
  }
}
---

<BaseLayout
  title={`${matiereLabel} ${niveauLabel} — Collège`}
  description={`Catalogue des chapitres de ${matiereLabel.toLowerCase()} pour ${niveauLabel} au collège.`}
  subject="physique-chimie"
  cycle="college"
  level={niveauLabel}
>
  <div class="ui5-page" data-subject="physique-chimie">
    <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">/</span>
      <a href="/college">Collège</a><span aria-hidden="true">/</span>
      <a href={`/college/${niveau}`}>{niveauLabel}</a><span aria-hidden="true">/</span>
      <strong>{matiereLabel}</strong>
    </nav>

    <header class="ui5-page-header">
      <div class="ui5-page-header__copy">
        <p class="ui5-kicker">Collège · {matiereLabel}</p>
        <h1 class="ui5-title">{matiereLabel} — {niveauLabel}</h1>
        <p class="ui5-lead">Les chapitres sont présentés dans l’ordre du programme. Ouvre un chapitre pour retrouver le même lecteur de cours et les mêmes outils d’entraînement.</p>
      </div>
      <div class="ui5-page-header__aside">
        <strong>{chapters.length} chapitre{chapters.length > 1 ? "s" : ""}</strong>
      </div>
    </header>

    <nav class="ui5-filter-row" aria-label="Navigation de catalogue">
      <a class="ui5-filter" href={`/college/${niveau}`}>Toutes les matières</a>
      <a class="ui5-filter" href={`/college/${niveau}/${otherMatiere}`}>Voir {otherMatiereLabel.toLowerCase()}</a>
    </nav>

    <CatalogueChapterList
      id="chapitres"
      title={`Chapitres de ${matiereLabel.toLowerCase()}`}
      chapters={chapters}
      accent={accent}
      emptyTitle="Cette matière est en préparation"
      emptyMessage={`Aucun chapitre de ${matiereLabel.toLowerCase()} n'est encore publié pour ${niveauLabel}.`}
      emptyActions={[
        { label: "Retour au niveau", href: `/college/${niveau}`, primary: true },
        { label: "Voir les outils collège", href: "/outils-methodes/college" },
      ]}
    />
  </div>
</BaseLayout>
