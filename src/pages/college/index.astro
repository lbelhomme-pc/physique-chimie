---
// UI V5 — page d'entrée collège Physique-Chimie
import BaseLayout from "../../layouts/BaseLayout.astro";
import { collegeLevels, getLevelLabel } from "../../data/levels";

const allMeta = import.meta.glob("/src/data/chapters/college/**/meta.json", { eager: true });

function countChapters(levelSlug: string, matiere?: string) {
  return Object.keys(allMeta).filter((path) => {
    const segments = path.replace("/src/data/chapters/", "").replace("/meta.json", "").split("/");
    const [, niveau, chapterMatiere] = segments;
    return niveau === levelSlug && (!matiere || chapterMatiere === matiere);
  }).length;
}

const levelCards = collegeLevels.map((level) => {
  const chimie = countChapters(level.slug, "chimie");
  const physique = countChapters(level.slug, "physique");
  return {
    ...level,
    label: getLevelLabel(level.slug),
    chimie,
    physique,
    total: chimie + physique,
    isSixiemeSciencesTechnologie: level.slug === "6eme",
  };
});
---

<BaseLayout
  title="Collège — Physique-Chimie"
  description="Choisir son niveau dans l’espace Physique-Chimie : Sciences et technologie en 6e, puis Physique-Chimie en 5e, 4e et 3e."
  subject="physique-chimie"
  cycle="college"
>
  <div class="ui5-page" data-subject="physique-chimie">
    <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">/</span><span>Physique-Chimie</span><span aria-hidden="true">/</span><strong>Collège</strong>
    </nav>

    <header class="ui5-page-header">
      <div class="ui5-page-header__copy">
        <p class="ui5-kicker">Parcours collège</p>
        <h1 class="ui5-title">Choisir un niveau</h1>
        <p class="ui5-lead">De la 6e à la 3e, retrouve les chapitres dans l’ordre du programme avec un accès direct aux cours, exercices, quiz et flashcards.</p>
      </div>
      <p class="ui5-page-header__aside">Une même interface pour tous les niveaux : tu choisis le niveau, puis le chapitre.</p>
    </header>

    <section class="ui5-section" aria-labelledby="college-levels-title">
      <div class="ui5-section-head">
        <h2 id="college-levels-title">Niveaux disponibles</h2>
        <p>{levelCards.reduce((sum, level) => sum + level.total, 0)} chapitres publiés au total.</p>
      </div>

      <div class="ui5-grid ui5-grid--2">
        {levelCards.map((level) => (
          <article class="ui5-card ui5-level-card">
            <div class="ui5-level-card__top">
              <span class="ui5-level-card__badge">{level.label}</span>
              <h3>{level.isSixiemeSciencesTechnologie ? `${level.label} — Sciences et technologie` : `Niveau ${level.label}`}</h3>
            </div>
            <p>
              {level.total > 0
                ? level.isSixiemeSciencesTechnologie
                  ? `${level.total} chapitres du parcours Physique-Chimie rattachés au programme de Sciences et technologie du cycle 3.`
                  : `${level.total} chapitres en ligne : ${level.physique} en physique et ${level.chimie} en chimie.`
                : "Les contenus de ce niveau sont en préparation."}
            </p>
            <div class="ui5-level-card__actions">
              <a class="ui5-button ui5-button--primary" href={`/college/${level.slug}`}>
                {level.isSixiemeSciencesTechnologie ? "Voir Sciences et technologie" : "Voir le niveau"}
              </a>
              {level.chimie > 0 && <a class="ui5-button" href={`/college/${level.slug}/chimie`}>Chimie</a>}
              {level.physique > 0 && <a class="ui5-button" href={`/college/${level.slug}/physique`}>Physique</a>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="ui5-section">
      <div class="ui5-card ui5-tools-row">
        <div>
          <h2>Outils et méthodes collège</h2>
          <p>Conversions, formules, proportionnalité, graphiques et rédaction scientifique.</p>
        </div>
        <a class="ui5-button" href="/outils-methodes/college">Voir les outils</a>
      </div>
    </section>
  </div>
</BaseLayout>
