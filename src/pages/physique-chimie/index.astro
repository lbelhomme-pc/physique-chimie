---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { physiqueChimieLyceeTracks, physiqueChimieMainNavigation, physiqueChimieResourceNavigation } from "../../data/physiqueChimie/navigation";
---

<BaseLayout
  title="Physique-Chimie - Espace pédagogique"
  description="Espace Physique-Chimie : Sciences et technologie en 6e, Physique-Chimie au cycle 4 et parcours du lycée, dont l’Enseignement scientifique."
  canonical="/physique-chimie"
  subject="physique-chimie"
>
  <div class="ui5-page" data-subject="physique-chimie">
    <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">/</span><strong>Physique-Chimie</strong>
    </nav>

    <header class="ui5-page-header">
      <div class="ui5-page-header__copy">
        <p class="ui5-kicker">Physique-Chimie</p>
        <h1 class="ui5-title">Comprendre la Physique-Chimie</h1>
        <p class="ui5-lead">Cours, exercices, méthodes et simulations pour observer, expérimenter, raisonner et modéliser du collège au lycée.</p>
      </div>
      <p class="ui5-page-header__aside">Choisis ton cycle, puis ton niveau et ton chapitre.</p>
    </header>

    <section class="ui5-section" aria-labelledby="pc-main-access">
      <div class="ui5-section-head">
        <h2 id="pc-main-access">Collège ou lycée</h2>
        <p>Une même structure de navigation et de travail.</p>
      </div>
      <div class="ui5-grid ui5-grid--2">
        {physiqueChimieMainNavigation.map((resource) => (
          <a class="ui5-card ui5-resource-card" href={resource.href}>
            <h3>{resource.title}</h3>
            <p>{resource.description}</p>
            <span class="ui5-card__cta">Ouvrir →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="ui5-section" aria-labelledby="pc-tracks-title">
      <div class="ui5-section-head">
        <h2 id="pc-tracks-title">Parcours lycée</h2>
        <p>Physique-Chimie et Enseignement scientifique restent clairement identifiés.</p>
      </div>
      <div class="ui5-grid ui5-grid--2">
        {physiqueChimieLyceeTracks.map((track) => (
          <a class="ui5-card ui5-resource-card" href={track.href}>
            <h3>{track.title}</h3>
            <p>{track.description}</p>
            <span class="ui5-card__cta">Voir le parcours →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="ui5-section" aria-labelledby="pc-resources-title">
      <div class="ui5-section-head">
        <h2 id="pc-resources-title">Expérimenter et réviser</h2>
        <p>Les ressources transversales utilisent les mêmes primitives visuelles.</p>
      </div>
      <div class="ui5-grid ui5-grid--2">
        {physiqueChimieResourceNavigation.map((resource) => (
          <a class="ui5-card ui5-resource-card" href={resource.href}>
            <h3>{resource.title}</h3>
            <p>{resource.description}</p>
            <span class="ui5-card__cta">Ouvrir →</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
