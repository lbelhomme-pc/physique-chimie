---
import BaseLayout from "../layouts/BaseLayout.astro";
import LabAppCard from "../components/laboratoire/LabAppCard.astro";
import { labApps } from "../data/laboratoire/apps";
---

<BaseLayout
  title="Laboratoire — Physique-Chimie"
  description="Simulations interactives de physique-chimie pour observer, mesurer et expérimenter."
  canonical="/laboratoire"
  subject="physique-chimie"
  resourceType="simulation"
>
  <div class="ui5-page ui5-lab-index" data-subject="physique-chimie" data-lab-index>
    <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">/</span>
      <a href="/physique-chimie">Physique-Chimie</a><span aria-hidden="true">/</span>
      <strong>Laboratoire</strong>
    </nav>

    <header class="ui5-page-header">
      <div class="ui5-page-header__copy">
        <p class="ui5-kicker">Laboratoire virtuel</p>
        <h1 class="ui5-title">Expérimenter en laboratoire</h1>
        <p class="ui5-lead">Manipule, mesure et observe les notions de Physique-Chimie avec des simulations accessibles et reliées au programme.</p>
      </div>
      <p class="ui5-page-header__aside">{labApps.length} simulations disponibles</p>
    </header>

    <section class="ui5-section ui5-lab-layout" id="bibliotheque-laboratoire">
      <aside id="ui5-lab-filter-panel" class="ui5-lab-filters" aria-labelledby="ui5-lab-filter-title" data-lab-filter-panel>
        <div class="ui5-lab-filters__head">
          <h2 id="ui5-lab-filter-title">Filtres</h2>
          <div>
            <button class="ui5-button ui5-lab-clear is-hidden" type="button" data-lab-clear>Effacer</button>
            <button class="ui5-button ui5-lab-filter-close" type="button" data-lab-filter-close>Fermer</button>
          </div>
        </div>

        <fieldset class="ui5-lab-filter-group">
          <legend>Niveau scolaire</legend>
          <label><input type="checkbox" value="college" data-lab-filter="level" /> Collège</label>
          <label><input type="checkbox" value="lycee" data-lab-filter="level" /> Lycée</label>
        </fieldset>

        <fieldset class="ui5-lab-filter-group">
          <legend>Physique</legend>
          <label><input type="checkbox" value="physique" data-lab-filter="theme" /> Toute la physique</label>
          <label><input type="checkbox" value="mouvement" data-lab-filter="topic" /> Mouvement & gravitation</label>
          <label><input type="checkbox" value="ondes" data-lab-filter="topic" /> Optique, son & ondes</label>
          <label><input type="checkbox" value="electricite" data-lab-filter="topic" /> Électricité & énergie</label>
        </fieldset>

        <fieldset class="ui5-lab-filter-group">
          <legend>Chimie</legend>
          <label><input type="checkbox" value="chimie" data-lab-filter="theme" /> Toute la chimie</label>
          <label><input type="checkbox" value="matiere" data-lab-filter="topic" /> Structure de la matière</label>
          <label><input type="checkbox" value="transformations" data-lab-filter="topic" /> Transformations chimiques</label>
          <label><input type="checkbox" value="acidebase" data-lab-filter="topic" /> Acide / base & pH</label>
        </fieldset>
      </aside>

      <div class="ui5-lab-results" aria-live="polite">
        <div class="ui5-lab-mobile-toolbar">
          <button class="ui5-button" type="button" data-lab-filter-toggle aria-expanded="false" aria-controls="ui5-lab-filter-panel">
            Filtres <span data-lab-filter-count>0</span>
          </button>
        </div>

        <div class="ui5-toolbar">
          <label for="ui5-lab-search">Rechercher une simulation</label>
          <div class="ui5-search">
            <input id="ui5-lab-search" type="search" placeholder="Lentille, atome, condensateur…" data-lab-search />
          </div>
        </div>

        <div class="ui5-lab-active-filters" data-lab-active-filters aria-label="Filtres actifs"></div>

        <div class="ui5-section-head">
          <h2 data-lab-results-title>Toutes les simulations</h2>
          <p data-lab-results-count>{labApps.length} simulations</p>
        </div>

        <div class="ui5-lab-grid" aria-label="Applications disponibles">
          {labApps.map((app) => <LabAppCard app={app} />)}
        </div>

        <p class="ui5-no-results is-hidden" data-lab-no-results>Aucune simulation ne correspond à cette recherche.</p>
      </div>
    </section>

    <script>
      import "../scripts/laboratoire/filter-lab-index.js";
    </script>
  </div>
</BaseLayout>
