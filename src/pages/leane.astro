---
import BaseLayout from "../layouts/BaseLayout.astro";

type LevelBlock = {
  id: string;
  title: string;
  subtitle: string;
  objective: string;
  courses: Array<{
    title: string;
    focus: string;
    points: string[];
    example: string;
    trap: string;
  }>;
  exercises: Array<{
    title: string;
    level: string;
    prompt: string;
    hint: string;
    answer: string;
  }>;
};

const levels: LevelBlock[] = [
  {
    id: "5e",
    title: "Bases 5e",
    subtitle: "Reprendre les automatismes sans stress",
    objective: "Savoir poser un calcul propre, respecter les priorites et manipuler une expression simple.",
    courses: [
      {
        title: "Enchainements d'operations",
        focus: "Une ligne = une seule transformation.",
        points: [
          "Parentheses d'abord, en commencant par les plus interieures.",
          "Multiplications et divisions avant additions et soustractions.",
          "A priorite egale, on avance de gauche a droite.",
        ],
        example: "50 - [3 x (9 - 5)] = 50 - [3 x 4] = 50 - 12 = 38",
        trap: "36 / 6 x 4 se calcule de gauche a droite : 6 x 4 = 24, pas 36 / 24.",
      },
      {
        title: "Calcul litteral de depart",
        focus: "Remplacer une lettre par un nombre et reduire les termes de meme nature.",
        points: [
          "7 x x s'ecrit 7x ; 1 x a s'ecrit a ; -1 x b s'ecrit -b.",
          "Avec une valeur negative, on met des parentheses : (-4)^2 = 16.",
          "On additionne seulement les termes comparables : x avec x, x^2 avec x^2.",
        ],
        example: "Pour x = -3, 2x - 7 = 2 x (-3) - 7 = -13",
        trap: "7x + 3 ne devient jamais 10x : 3 n'est pas un terme en x.",
      },
      {
        title: "Statistiques essentielles",
        focus: "Effectif, frequence, moyenne : trois mots a stabiliser.",
        points: [
          "L'effectif total est le nombre de donnees.",
          "Une frequence se calcule avec effectif de la valeur / effectif total.",
          "La moyenne simple est la somme des valeurs divisee par le nombre de valeurs.",
        ],
        example: "12 ; 15 ; 9 ; 14 ; 10 donne une moyenne de 60 / 5 = 12",
        trap: "Une moyenne doit rester entre la plus petite et la plus grande valeur.",
      },
    ],
    exercises: [
      {
        title: "Priorites",
        level: "Niveau 1",
        prompt: "Calcule A = 8 + 6 x 5 puis B = 72 / 8 x 3 - 4.",
        hint: "Commence par la multiplication ou la division, puis avance de gauche a droite.",
        answer: "A = 38. B = 9 x 3 - 4 = 27 - 4 = 23.",
      },
      {
        title: "Parentheses",
        level: "Niveau 2",
        prompt: "Calcule C = 16 - [4 x (8 - 5)].",
        hint: "La parenthese la plus interieure se traite en premier.",
        answer: "C = 16 - [4 x 3] = 16 - 12 = 4.",
      },
      {
        title: "Substitution",
        level: "Niveau 2",
        prompt: "Calcule D = x^2 + 3x pour x = -4.",
        hint: "Ecris D = (-4)^2 + 3 x (-4).",
        answer: "D = 16 - 12 = 4.",
      },
    ],
  },
  {
    id: "4e",
    title: "Bases 4e",
    subtitle: "Solidifier fractions, puissances et equations",
    objective: "Gagner en securite sur les calculs qui reviennent constamment au lycee.",
    courses: [
      {
        title: "Fractions",
        focus: "Additionner demande un denominateur commun, multiplier demande de simplifier avant.",
        points: [
          "Pour additionner : on met au meme denominateur.",
          "Pour multiplier : on multiplie les numerateurs et les denominateurs.",
          "Pour diviser : on multiplie par l'inverse.",
        ],
        example: "3/4 - 5/6 = 9/12 - 10/12 = -1/12",
        trap: "On n'additionne pas les denominateurs : 1/3 + 1/3 = 2/3, pas 2/6.",
      },
      {
        title: "Puissances",
        focus: "Les puissances servent a ecrire vite de grands ou petits nombres.",
        points: [
          "a^0 = 1 si a n'est pas nul.",
          "a^-n = 1 / a^n.",
          "Une notation scientifique s'ecrit a x 10^n avec 1 <= |a| < 10.",
        ],
        example: "0,00056 = 5,6 x 10^-4",
        trap: "(-5)^2 = 25, mais -5^2 = -25.",
      },
      {
        title: "Equations",
        focus: "Le but est d'isoler x en gardant l'egalite vraie.",
        points: [
          "On peut ajouter, soustraire, multiplier ou diviser les deux membres par le meme nombre non nul.",
          "On regroupe les x d'un cote et les nombres de l'autre.",
          "On verifie rapidement en remettant la valeur trouvee dans l'equation de depart.",
        ],
        example: "5x - 7 = 2x + 8 donne 3x = 15 donc x = 5",
        trap: "Si on deplace un terme, on change son signe.",
      },
    ],
    exercises: [
      {
        title: "Fraction",
        level: "Niveau 1",
        prompt: "Calcule et simplifie : 7/9 / (-14/27).",
        hint: "Diviser par une fraction revient a multiplier par son inverse.",
        answer: "7/9 x 27/(-14) = 7 x 3 / (-14) = 21 / -14 = -3/2.",
      },
      {
        title: "Puissance",
        level: "Niveau 2",
        prompt: "Ecris 0,0042 en notation scientifique.",
        hint: "Le nombre devant 10 doit etre compris entre 1 et 10.",
        answer: "0,0042 = 4,2 x 10^-3.",
      },
      {
        title: "Equation",
        level: "Niveau 2",
        prompt: "Resous 4 - 3x = x + 12.",
        hint: "Regroupe les x a droite ou a gauche, puis les nombres de l'autre cote.",
        answer: "-4x = 8 donc x = -2.",
      },
    ],
  },
  {
    id: "3e",
    title: "Bases 3e",
    subtitle: "Preparer l'entree au lycee",
    objective: "Relier calcul litteral, factorisation, fonctions et probabilites pour aborder la seconde puis la premiere.",
    courses: [
      {
        title: "Developper et factoriser",
        focus: "Developper enleve les parentheses ; factoriser remet sous forme de produit.",
        points: [
          "Distributivite simple : k(a + b) = ka + kb.",
          "Double distributivite : chaque terme multiplie chaque terme.",
          "Identite utile : a^2 - b^2 = (a - b)(a + b).",
        ],
        example: "(2x - 1)(x + 4) = 2x^2 + 8x - x - 4 = 2x^2 + 7x - 4",
        trap: "Un signe moins devant une parenthese change tous les signes.",
      },
      {
        title: "Equations-produits",
        focus: "Un produit est nul si au moins un de ses facteurs est nul.",
        points: [
          "On factorise si l'expression n'est pas deja un produit.",
          "On resout chaque facteur egal a 0.",
          "On donne toutes les solutions.",
        ],
        example: "(2x - 6)(x + 5) = 0 donne x = 3 ou x = -5",
        trap: "La regle ne marche que quand le second membre vaut 0.",
      },
      {
        title: "Fonctions",
        focus: "Comprendre image, antecedent, tableau et formule.",
        points: [
          "f(3) = -1 signifie que l'image de 3 est -1.",
          "Chercher un antecedent revient souvent a resoudre une equation.",
          "Un point A(x ; y) appartient a la courbe de f si f(x) = y.",
        ],
        example: "Pour f(x) = 4x - 7, l'antecedent de 9 verifie 4x - 7 = 9, donc x = 4",
        trap: "Image et antecedent sont inverses : on ne les confond pas.",
      },
      {
        title: "Probabilites et statistiques",
        focus: "Interpreter une situation avant de calculer.",
        points: [
          "Une probabilite est comprise entre 0 et 1.",
          "Avec des issues equiprobables : cas favorables / cas possibles.",
          "La mediane partage une serie ordonnee en deux groupes de meme taille.",
        ],
        example: "Sur un de, P(nombre pair) = 3/6 = 1/2.",
        trap: "Une probabilite de 1 signifie certain, pas seulement probable.",
      },
    ],
    exercises: [
      {
        title: "Developpement",
        level: "Niveau 2",
        prompt: "Developpe et reduis : (3x - 2)(4 - x).",
        hint: "Distribue chaque terme du premier facteur sur chaque terme du second.",
        answer: "12x - 3x^2 - 8 + 2x = -3x^2 + 14x - 8.",
      },
      {
        title: "Factorisation",
        level: "Niveau 2",
        prompt: "Factorise : x^2 - 49.",
        hint: "Utilise a^2 - b^2 = (a - b)(a + b).",
        answer: "x^2 - 49 = x^2 - 7^2 = (x - 7)(x + 7).",
      },
      {
        title: "Fonction",
        level: "Niveau 2",
        prompt: "Soit h(x) = 2x^2 - 3x + 1. Calcule h(-3).",
        hint: "Remplace x par (-3), avec des parentheses.",
        answer: "h(-3) = 2 x 9 - 3 x (-3) + 1 = 18 + 9 + 1 = 28.",
      },
    ],
  },
];

const bridgeItems = [
  "Revoir les fractions avant les fonctions derivees, les probabilites et les calculs de physique.",
  "Automatiser le calcul litteral pour ne pas perdre le fil dans les chapitres de fonctions.",
  "Lire un tableau, un graphique et une formule : c'est le trio qui revient partout au lycee.",
  "Travailler court mais regulier : 20 minutes, une notion, deux exercices, une correction.",
];

const quiz = [
  {
    question: "Dans 36 / 6 x 4, quelle operation effectue-t-on en premier ?",
    choices: ["36 / 6", "6 x 4", "36 / 24"],
    answer: 0,
    explanation: "Division et multiplication ont la meme priorite : on calcule de gauche a droite.",
  },
  {
    question: "Quelle est la valeur de (-5)^2 ?",
    choices: ["25", "-25", "-10"],
    answer: 0,
    explanation: "Les parentheses indiquent que le signe moins fait partie du nombre mis au carre.",
  },
  {
    question: "Pour additionner 3/4 et 5/6, que faut-il faire d'abord ?",
    choices: ["Mettre au meme denominateur", "Additionner 4 et 6", "Multiplier les deux fractions"],
    answer: 0,
    explanation: "Une addition de fractions demande des denominateurs identiques.",
  },
  {
    question: "Quelle expression est reduite correctement ?",
    choices: ["5x + 2x = 7x", "5x + 2 = 7x", "5x^2 + 2x = 7x^2"],
    answer: 0,
    explanation: "On regroupe uniquement les termes de meme nature.",
  },
  {
    question: "Resoudre 3x - 7 = 11 donne :",
    choices: ["x = 6", "x = 4/3", "x = -6"],
    answer: 0,
    explanation: "3x = 18 donc x = 6.",
  },
  {
    question: "Que signifie f(3) = -1 ?",
    choices: ["L'image de 3 est -1", "L'image de -1 est 3", "La fonction vaut toujours -1"],
    answer: 0,
    explanation: "Le nombre entre parentheses est l'antecedent ; le resultat est l'image.",
  },
  {
    question: "Quelle factorisation correspond a x^2 - 49 ?",
    choices: ["(x - 7)(x + 7)", "(x - 49)(x + 49)", "(x - 7)^2"],
    answer: 0,
    explanation: "C'est une difference de deux carres : x^2 - 7^2.",
  },
  {
    question: "Sur un de equilibre, P(obtenir un nombre pair) vaut :",
    choices: ["1/2", "1/3", "2/3"],
    answer: 0,
    explanation: "Il y a 3 nombres pairs sur 6 issues possibles.",
  },
  {
    question: "La moyenne de 12, 15, 9, 14, 10 vaut :",
    choices: ["12", "13", "60"],
    answer: 0,
    explanation: "La somme vaut 60 et il y a 5 notes : 60 / 5 = 12.",
  },
  {
    question: "Pour resoudre (2x - 6)(x + 5) = 0, on utilise :",
    choices: ["La regle du produit nul", "La moyenne", "La notation scientifique"],
    answer: 0,
    explanation: "Un produit nul signifie qu'au moins un facteur est nul.",
  },
];

const flashcards = [
  ["Priorites", "Parentheses, puissances, multiplications/divisions, additions/soustractions."],
  ["Fraction", "Pour additionner, meme denominateur. Pour diviser, multiplier par l'inverse."],
  ["Puissance negative", "a^-n = 1 / a^n, avec a non nul."],
  ["Notation scientifique", "a x 10^n avec 1 <= |a| < 10."],
  ["Substitution", "Remplacer la lettre par la valeur, avec parentheses si elle est negative."],
  ["Developper", "Supprimer les parentheses en distribuant."],
  ["Factoriser", "Ecrire une somme sous forme de produit."],
  ["Produit nul", "Si AB = 0, alors A = 0 ou B = 0."],
  ["Image", "f(a) est l'image de a par la fonction f."],
  ["Antecedent", "Un nombre qui donne une image donnee."],
  ["Frequence", "Effectif d'une valeur / effectif total."],
  ["Mediane", "Valeur qui partage la serie ordonnee en deux groupes de meme taille."],
];
---

<BaseLayout
  title="Espace Léane - révisions de mathématiques pour préparer la première"
  description="Cours courts, exercices guidés, QCM et flashcards pour reprendre les bases de 5e, 4e et 3e avant l'entrée en première."
  subject="mathematiques"
  cycle="lycee"
  level="Objectif première"
  resourceType="Révisions personnalisées"
>
  <div class="leane-page">
    <section class="leane-hero" aria-labelledby="leane-title">
      <div class="leane-hero__copy">
        <span class="leane-kicker">Espace personnel</span>
        <h1 id="leane-title">Léane</h1>
        <p>
          Un parcours de révision doux et progressif pour reprendre les bases de collège, combler les
          fragilités et arriver plus sereinement en première.
        </p>
        <div class="leane-hero__actions" aria-label="Accès rapides">
          <a href="#niveaux">Cours et exercices</a>
          <a href="#qcm-global">QCM global</a>
          <a href="#flashcards-globales">Flashcards</a>
        </div>
      </div>
      <div class="leane-hero__visual" aria-hidden="true">
        <img src="/images/accueil-v3-hero-sciences-2026-07-27.webp" alt="" width="1600" height="762" loading="eager" decoding="async" />
      </div>
    </section>

    <nav class="leane-tabs" aria-label="Sous-onglets Léane">
      <a href="#parcours">Parcours</a>
      {levels.map((level) => <a href={`#niveau-${level.id}`}>{level.title}</a>)}
      <a href="#qcm-global">QCM global</a>
      <a href="#flashcards-globales">Flashcards</a>
    </nav>

    <section id="parcours" class="leane-section leane-section--intro" aria-labelledby="parcours-title">
      <div>
        <span class="leane-kicker">Méthode</span>
        <h2 id="parcours-title">Un rythme adapté aux difficultés</h2>
        <p>
          Chaque niveau reprend les documents fournis sous forme de cours courts, d'exemples, de pièges
          fréquents et d'exercices avec aide puis correction masquée.
        </p>
      </div>
      <ol class="leane-routine">
        <li><strong>5 min</strong><span>Lire le cours et recopier l'exemple.</span></li>
        <li><strong>10 min</strong><span>Faire deux exercices sans regarder la correction.</span></li>
        <li><strong>5 min</strong><span>Comparer, corriger, puis écrire l'erreur à éviter.</span></li>
      </ol>
    </section>

    <section class="leane-section leane-bridge" aria-labelledby="bridge-title">
      <div>
        <span class="leane-kicker">Objectif première</span>
        <h2 id="bridge-title">Ce qu'il faut consolider avant le lycée scientifique</h2>
      </div>
      <div class="leane-bridge__grid">
        {bridgeItems.map((item) => (
          <article>
            <span aria-hidden="true">✓</span>
            <p>{item}</p>
          </article>
        ))}
      </div>
    </section>

    <div id="niveaux" class="leane-levels">
      {levels.map((level) => (
        <section id={`niveau-${level.id}`} class="leane-section leane-level" aria-labelledby={`${level.id}-title`}>
          <div class="leane-level__header">
            <div>
              <span class="leane-kicker">Cours par niveau</span>
              <h2 id={`${level.id}-title`}>{level.title}</h2>
              <p>{level.subtitle}</p>
            </div>
            <strong>{level.objective}</strong>
          </div>

          <div class="leane-course-grid">
            {level.courses.map((course) => (
              <article class="leane-course">
                <span class="leane-chip">Cours</span>
                <h3>{course.title}</h3>
                <p class="leane-focus">{course.focus}</p>
                <ul>
                  {course.points.map((point) => <li>{point}</li>)}
                </ul>
                <div class="leane-example">
                  <strong>Exemple</strong>
                  <code>{course.example}</code>
                </div>
                <p class="leane-trap"><strong>Piège à éviter :</strong> {course.trap}</p>
              </article>
            ))}
          </div>

          <div class="leane-exercises">
            <h3>Exercices guidés</h3>
            <div class="leane-exercise-grid">
              {level.exercises.map((exercise) => (
                <article class="leane-exercise">
                  <span class="leane-chip leane-chip--soft">{exercise.level}</span>
                  <h4>{exercise.title}</h4>
                  <p>{exercise.prompt}</p>
                  <details>
                    <summary>Voir une aide</summary>
                    <p>{exercise.hint}</p>
                  </details>
                  <details>
                    <summary>Voir la correction</summary>
                    <p>{exercise.answer}</p>
                  </details>
                </article>
              ))}
            </div>
          </div>
        </section>
      ))}
    </div>

    <section id="qcm-global" class="leane-section leane-quiz" aria-labelledby="qcm-title">
      <div class="leane-section__heading">
        <span class="leane-kicker">Évaluation rapide</span>
        <h2 id="qcm-title">QCM global</h2>
        <p>Un mélange de questions 5e, 4e et 3e pour repérer les automatismes à retravailler.</p>
      </div>
      <form class="leane-quiz__form" data-leane-quiz>
        {quiz.map((item, index) => (
          <fieldset class="leane-question">
            <legend>{index + 1}. {item.question}</legend>
            {item.choices.map((choice, choiceIndex) => (
              <label>
                <input type="radio" name={`q${index}`} value={choiceIndex} data-correct={choiceIndex === item.answer ? "true" : "false"} />
                <span>{choice}</span>
              </label>
            ))}
            <p class="leane-question__feedback" data-feedback>{item.explanation}</p>
          </fieldset>
        ))}
        <button type="button" data-check-quiz>Corriger le QCM</button>
        <p class="leane-quiz__score" data-score aria-live="polite"></p>
      </form>
    </section>

    <section id="flashcards-globales" class="leane-section leane-flashcards" aria-labelledby="flashcards-title">
      <div class="leane-section__heading">
        <span class="leane-kicker">Mémorisation</span>
        <h2 id="flashcards-title">Flashcards globales</h2>
        <p>Cliquer sur une carte pour révéler la réponse, puis refaire le paquet jusqu'à réponse fluide.</p>
      </div>
      <div class="leane-flashcards__grid">
        {flashcards.map(([front, back]) => (
          <button type="button" class="leane-flashcard" data-flashcard aria-pressed="false">
            <span>{front}</span>
            <strong>{back}</strong>
          </button>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const quizRoot = document.querySelector("[data-leane-quiz]");
  if (quizRoot instanceof HTMLFormElement) {
    const score = quizRoot.querySelector("[data-score]");
    const checkButton = quizRoot.querySelector("[data-check-quiz]");

    checkButton?.addEventListener("click", () => {
      const questions = Array.from(quizRoot.querySelectorAll(".leane-question"));
      let correctCount = 0;

      questions.forEach((question) => {
        const checked = question.querySelector("input:checked");
        const feedback = question.querySelector("[data-feedback]");
        const isChecked = checked instanceof HTMLInputElement;
        const isCorrect = isChecked && checked.dataset.correct === "true";
        question.classList.toggle("is-correct", isCorrect);
        question.classList.toggle("is-wrong", isChecked && !isCorrect);
        if (feedback instanceof HTMLElement) feedback.hidden = !isChecked;
        if (isCorrect) correctCount += 1;
      });

      if (score instanceof HTMLElement) {
        score.textContent = `Score : ${correctCount} / ${questions.length}. ${correctCount >= 8 ? "Très bon socle, on consolide les réflexes." : "On reprend les cartes et les exercices associés tranquillement."}`;
      }
    });
  }

  document.querySelectorAll("[data-flashcard]").forEach((card) => {
    card.addEventListener("click", () => {
      const pressed = card.getAttribute("aria-pressed") === "true";
      card.setAttribute("aria-pressed", String(!pressed));
      card.classList.toggle("is-flipped", !pressed);
    });
  });
</script>

<style>
  :global(.page-container:has(.leane-page)) {
    max-width: none;
    padding: 0;
  }

  .leane-page {
    --leane-blue: #0f5bff;
    --leane-navy: #00184d;
    --leane-text: #061849;
    --leane-muted: #52617c;
    --leane-border: #d9e6fb;
    --leane-panel: #f7fbff;
    background: #fff;
    color: var(--leane-text);
    font-family: "Plus Jakarta Sans", Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .leane-hero {
    background: linear-gradient(90deg, #ffffff 0%, #ffffff 36%, rgba(223, 239, 255, 0.9) 100%);
    border-bottom: 1px solid #dce8f8;
    display: grid;
    grid-template-columns: minmax(300px, 0.9fr) minmax(360px, 1.1fr);
    min-height: 430px;
    overflow: hidden;
    padding: 4rem max(2rem, calc((100vw - 1180px) / 2));
    position: relative;
  }

  .leane-hero__copy {
    align-self: center;
    display: grid;
    gap: 1.35rem;
    max-width: 560px;
    position: relative;
    z-index: 2;
  }

  .leane-kicker {
    color: var(--leane-blue);
    font-size: 0.78rem;
    font-weight: 950;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .leane-hero h1 {
    color: var(--leane-navy);
    font-size: clamp(3.2rem, 6vw, 5.4rem);
    font-weight: 950;
    letter-spacing: 0;
    line-height: 0.94;
    margin: 0;
  }

  .leane-hero p,
  .leane-section p {
    line-height: 1.6;
  }

  .leane-hero p {
    color: var(--leane-text);
    font-size: 1.08rem;
    font-weight: 650;
    margin: 0;
    max-width: 56ch;
  }

  .leane-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .leane-hero__actions a,
  .leane-quiz button {
    align-items: center;
    background: var(--leane-blue);
    border: 1.5px solid var(--leane-blue);
    border-radius: 999px;
    color: #fff;
    display: inline-flex;
    font-size: 0.86rem;
    font-weight: 900;
    justify-content: center;
    min-height: 44px;
    padding: 0 1.35rem;
    text-decoration: none;
  }

  .leane-hero__actions a:nth-child(n + 2) {
    background: #fff;
    color: var(--leane-blue);
  }

  .leane-hero__visual {
    inset: 0 0 0 42%;
    position: absolute;
    z-index: 0;
  }

  .leane-hero__visual::before {
    background: linear-gradient(90deg, #fff 0%, rgba(255, 255, 255, 0.72) 26%, rgba(255, 255, 255, 0) 58%);
    content: "";
    inset: 0;
    position: absolute;
    z-index: 1;
