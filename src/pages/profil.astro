---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProfilePage from "../components/pedagogie/ProfilePage.tsx";
---
<BaseLayout
  title="Mon profil — Mathématiques et Physique-Chimie"
  description="Progression locale en Mathématiques et Physique-Chimie sur cet appareil."
  subject="transversal"
>
  <div class="ui5-page">
    <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span aria-hidden="true">/</span><strong>Compte</strong></nav>
    <header class="ui5-page-header">
      <div class="ui5-page-header__copy">
        <p class="ui5-kicker">Espace personnel</p>
        <h1 class="ui5-title">Mon profil</h1>
        <p class="ui5-lead">Progression et mémorisation enregistrées localement sur cet appareil.</p>
      </div>
    </header>
    <section class="ui5-section ui5-profile-shell"><ProfilePage client:load /></section>
  </div>
</BaseLayout>
