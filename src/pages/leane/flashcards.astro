---
import "../../ui-v5/tools/flashcards.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LeaneIcon from "../../components/leane/LeaneIcon.astro";
import LeaneShell from "../../components/leane/LeaneShell.astro";
import { leaneCoursePracticeEntries, leaneFlashcards } from "../../data/leane";

const courseCards = leaneCoursePracticeEntries.map(({ level, course, practice }, index) => ({
  id: `course-${index}`,
  source: "Cours",
  tag: practice.flashcard.tag,
  level: level.title,
  course: course.title,
  front: practice.flashcard.front,
  back: practice.flashcard.back,
  filter: level.id,
}));

const globalCards = leaneFlashcards.map((card, index) => ({
  id: `global-${index}`,
  source: "Global",
  tag: card.tag,
  level: "Synthèse",
  course: card.tag,
  front: card.front,
  back: card.back,
  filter: "global",
}));

const studyCards = [...courseCards, ...globalCards];
const totalCards = studyCards.length;
const filters = [
  { id: "all", label: "Toutes" },
  { id: "5e", label: "5ème" },
  { id: "4e", label: "4ème" },
  { id: "3e", label: "3ème" },
  { id: "global", label: "Synthèse" },
];

const reviewPlan = [
  { label: "À voir maintenant", count: totalCards, tone: "danger" },
  { label: "Dans 1 jour", count: 0, tone: "warning" },
  { label: "Dans 3 jours", count: 0, tone: "gold" },
  { label: "Dans 7 jours", count: 0, tone: "primary" },
  { label: "Dans 14 jours", count: 0, tone: "success" },
];

const deckCards = [
  {
    title: "Priorités",
    detail: "Parenthèses et opérations",
    count: 3,
    tone: "primary",
  },
  {
    title: "Fractions",
    detail: "Calculs et signes",
    count: 2,
    tone: "success",
  },
  {
    title: "Équations",
    detail: "Isoler et vérifier",
    count: 2,
    tone: "purple",
  },
  {
    title: "Fonctions",
    detail: "Images et antécédents",
    count: 2,
    tone: "warning",
  },
];
---

<BaseLayout
  title="Flashcards Léane - révisions de mathématiques"
  description="Flashcards de révision pour mémoriser les réflexes de calcul et de raisonnement."
  subject="mathematiques"
  cycle="lycee"
  level="1re"
>
  <LeaneShell
    active="flashcards"
    title="Flashcards Léane"
    subtitle="Révision progressive par répétition espacée."
    hideHeading
  >
    <section class="leane-flash-space" data-leane-flash-study>
      <div class="leane-flash-heading">
        <div>
          <h1 id="leane-page-title">Flashcards — Maths essentielles</h1>
          <p>Collège à consolider avant la première</p>
        </div>
        <button class="leane-flash-settings" type="button">
          <LeaneIcon name="settings" />
          Paramètres des cartes
        </button>
      </div>

      <div class="leane-flash-stats" aria-label="Statistiques des flashcards">
        <article class="leane-flash-stat leane-flash-stat--success">
          <span class="leane-flash-stat__icon"><LeaneIcon name="check" /></span>
          <span>
            <small>Cartes maîtrisées</small>
            <strong data-flash-mastered>0</strong>
            <em>0% du deck</em>
          </span>
        </article>
        <article class="leane-flash-stat leane-flash-stat--warning">
          <span class="leane-flash-stat__icon"><LeaneIcon name="clock" /></span>
          <span>
            <small>Cartes à revoir</small>
            <strong data-flash-review-count>{totalCards}</strong>
            <em>Départ à 0%</em>
          </span>
        </article>
        <article class="leane-flash-stat leane-flash-stat--primary">
          <span class="leane-flash-stat__icon"><LeaneIcon name="cards" /></span>
          <span>
            <small>Deck actif</small>
            <strong data-flash-total>{totalCards}</strong>
            <em>Cartes disponibles</em>
          </span>
        </article>
        <article class="leane-flash-stat leane-flash-stat--purple">
          <span class="leane-flash-stat__icon"><LeaneIcon name="target" /></span>
          <span>
            <small>Temps d'étude</small>
            <strong data-flash-time>0 min</strong>
            <em>Aujourd'hui</em>
          </span>
        </article>
      </div>

      <div class="leane-flash-layout">
        <div class="leane-flash-maincol">
          <section class="leane-flash-player" aria-label="Session de flashcards">
            <div class="leane-flash-tabs" role="tablist" aria-label="Filtrer les cartes">
              {filters.map((filter, index) => (
                <button
                  type="button"
                  class:list={["leane-flash-tab", { "is-active": index === 0 }]}
                  data-flash-filter={filter.id}
                  aria-selected={index === 0 ? "true" : "false"}
                  role="tab"
                >
                  {filter.label}
                </button>
              ))}
            </div>

            <button
              class="leane-flash-card"
              type="button"
              aria-live="polite"
              aria-pressed="false"
              data-flash-card
            >
              <span class="leane-flash-card__tag" data-flash-tag>{studyCards[0].tag}</span>
              <span class="leane-flash-card__counter" data-flash-counter>1 / {totalCards}</span>
              <strong data-flash-question>{studyCards[0].front}</strong>
              <span class="leane-flash-card__hint" data-flash-hint>Cliquer pour retourner la carte</span>
            </button>

            <div class="leane-flash-actions" aria-label="Évaluer la réponse">
              <button type="button" class="leane-flash-answer leane-flash-answer--success" data-flash-rate="mastered">
                <span><LeaneIcon name="check" /> Je maîtrise</span>
                <small>Facile</small>
              </button>
              <button type="button" class="leane-flash-answer leane-flash-answer--warning" data-flash-rate="review">
                <span><LeaneIcon name="clock" /> À revoir</span>
                <small>Moyen</small>
              </button>
              <button type="button" class="leane-flash-answer leane-flash-answer--danger" data-flash-rate="hard">
                <span><LeaneIcon name="target" /> Difficile</span>
                <small>Je ne savais pas</small>
              </button>
            </div>
          </section>

          <section class="leane-flash-progress" aria-label="Progression du deck">
            <div class="leane-flash-progress__top">
              <strong>Progression du deck</strong>
              <span data-flash-percent>0% complété</span>
            </div>
            <div class="leane-flash-progress__bar" aria-hidden="true">
              <span data-flash-progress style="width: 0%"></span>
            </div>
            <div class="leane-flash-progress__meta">
              <span><LeaneIcon name="check" /> <b data-flash-mastered-inline>0</b> / <b>{totalCards}</b> cartes maîtrisées</span>
              <span><LeaneIcon name="cards" /> <b data-flash-remaining>{totalCards}</b> cartes restantes</span>
              <button type="button" data-flash-reset>Recommencer</button>
            </div>
          </section>

          <section class="leane-flash-decks" aria-label="Decks de révision">
            <div class="leane-flash-section-title">
              <strong>Decks récents</strong>
              <span>Essentiel seulement</span>
            </div>
            <div class="leane-flash-decks__grid">
              {deckCards.map((deck) => (
                <article class:list={["leane-flash-deck", `leane-flash-deck--${deck.tone}`]}>
                  <span class="leane-flash-deck__icon"><LeaneIcon name="cards" /></span>
                  <span>
                    <strong>{deck.title}</strong>
                    <small>{deck.detail}</small>
                  </span>
                  <em>{deck.count} cartes</em>
                </article>
              ))}
            </div>
          </section>
        </div>

        <aside class="leane-flash-side" aria-label="Répétition espacée">
          <section class="leane-flash-panel">
            <h2>Plan de révision <span>(Répétition espacée)</span></h2>
            <ul class="leane-flash-plan">
              {reviewPlan.map((item) => (
                <li class:list={[`leane-flash-plan__item`, `leane-flash-plan__item--${item.tone}`]}>
                  <span class="leane-flash-dot" aria-hidden="true"></span>
                  <strong>{item.label}</strong>
                  <em>{item.count} cartes</em>
                </li>
              ))}
            </ul>
          </section>

          <section class="leane-flash-panel leane-flash-tip">
            <span class="leane-flash-tip__icon"><LeaneIcon name="target" /></span>
            <div>
              <h2>Conseil du jour</h2>
              <p>Une carte hésitante repart dans le deck. Une carte maîtrisée avance.</p>
            </div>
          </section>
        </aside>
      </div>
    </section>

    <script type="application/json" is:inline id="leane-flash-study-data" set:html={JSON.stringify(studyCards)}></script>
  </LeaneShell>
</BaseLayout>

<script>
  type StudyCard = {
    id: string;
    source: string;
    tag: string;
    level: string;
    course: string;
    front: string;
    back: string;
    filter: string;
  };

  const dataNode = document.getElementById("leane-flash-study-data");
  const root = document.querySelector<HTMLElement>("[data-leane-flash-study]");
  const cards = (dataNode?.textContent ? JSON.parse(dataNode.textContent) : []) as StudyCard[];

  if (root && Array.isArray(cards) && cards.length > 0) {
    const cardButton = root.querySelector<HTMLButtonElement>("[data-flash-card]");
    const question = root.querySelector<HTMLElement>("[data-flash-question]");
    const tag = root.querySelector<HTMLElement>("[data-flash-tag]");
    const counter = root.querySelector<HTMLElement>("[data-flash-counter]");
    const hint = root.querySelector<HTMLElement>("[data-flash-hint]");
    const progress = root.querySelector<HTMLElement>("[data-flash-progress]");
    const percent = root.querySelector<HTMLElement>("[data-flash-percent]");
    const masteredNodes = root.querySelectorAll<HTMLElement>("[data-flash-mastered], [data-flash-mastered-inline]");
    const remaining = root.querySelector<HTMLElement>("[data-flash-remaining]");
    const reviewCount = root.querySelector<HTMLElement>("[data-flash-review-count]");
    const total = root.querySelector<HTMLElement>("[data-flash-total]");
    const filterButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-flash-filter]"));
    const resetButton = root.querySelector<HTMLButtonElement>("[data-flash-reset]");
    const rateButtons = root.querySelectorAll<HTMLButtonElement>("[data-flash-rate]");

    let pool = [...cards];
    let index = 0;
    let mastered = 0;
    let flipped = false;

    const setText = (node: Element | null, value: string) => {
      if (node) node.textContent = value;
    };

    function currentCard() {
      return pool[index] ?? pool[0];
    }

    function render() {
      const current = currentCard();
      const currentText = flipped ? current.back : current.front;
      const progressValue = pool.length > 0 ? Math.round((mastered / pool.length) * 100) : 0;
      setText(question, currentText);
      setText(tag, flipped ? "Réponse" : current.tag);
      setText(counter, `${Math.min(index + 1, pool.length)} / ${pool.length}`);
      setText(hint, flipped ? "Cliquer pour revoir la question" : "Cliquer pour retourner la carte");
      setText(percent, `${progressValue}% complété`);
      setText(remaining, String(Math.max(pool.length - mastered, 0)));
      setText(reviewCount, String(Math.max(pool.length - mastered, 0)));
      setText(total, String(pool.length));
      masteredNodes.forEach((node) => setText(node, String(mastered)));
      if (progress) progress.style.width = `${progressValue}%`;
      cardButton?.classList.toggle("is-flipped", flipped);
      cardButton?.setAttribute("aria-pressed", String(flipped));
    }

    function nextCard(rating: string) {
      if (rating === "mastered") mastered = Math.min(mastered + 1, pool.length);
      index = index + 1 >= pool.length ? 0 : index + 1;
      flipped = false;
      render();
    }

    function applyFilter(filter: string) {
      pool = filter === "all" ? [...cards] : cards.filter((card) => card.filter === filter);
      index = 0;
      mastered = 0;
      flipped = false;
      filterButtons.forEach((button) => {
        const isActive = button.dataset.flashFilter === filter;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-selected", String(isActive));
      });
      render();
    }

    function filterFromHash() {
      const hash = window.location.hash.replace("#", "");
      return ["5e", "4e", "3e", "global"].includes(hash) ? hash : "all";
    }

    cardButton?.addEventListener("click", () => {
      flipped = !flipped;
      render();
    });
    cardButton?.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        flipped = !flipped;
        render();
      }
    });
    rateButtons.forEach((button) => {
      button.addEventListener("click", () => nextCard(button.dataset.flashRate ?? "review"));
    });
    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.flashFilter ?? "all";
        applyFilter(filter);
        if (filter === "all") {
          window.history.replaceState(null, "", window.location.pathname);
        } else {
          window.location.hash = filter;
        }
      });
    });
    resetButton?.addEventListener("click", () => applyFilter(filterButtons.find((button) => button.classList.contains("is-active"))?.dataset.flashFilter ?? "all"));
    window.addEventListener("hashchange", () => applyFilter(filterFromHash()));
    applyFilter(filterFromHash());
  }
</script>
