---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LeaneShell from "../../components/leane/LeaneShell.astro";
import { leaneQuiz } from "../../data/leane";

const qcmBases = [
  {
    href: "/leane/qcm/5e",
    label: "Bases 5ème",
    title: "Automatismes de 5ème",
    detail: "Priorités, calcul littéral et statistiques.",
    count: 12,
  },
  {
    href: "/leane/qcm/4e",
    label: "Bases 4ème",
    title: "Calculs de 4ème",
    detail: "Fractions, puissances et équations.",
    count: 11,
  },
  {
    href: "/leane/qcm/3e",
    label: "Bases 3ème",
    title: "Passage lycée",
    detail: "Développer, factoriser, produit nul et fonctions.",
    count: 14,
  },
  {
    href: "/leane/qcm/global",
    label: "Synthèse",
    title: "Diagnostic global",
    detail: "Tous les repères essentiels avant la première.",
    count: leaneQuiz.length,
  },
];
---

<BaseLayout
  title="QCM Léane - révisions de mathématiques"
  description="QCM séparés par base pour tester les acquis essentiels avant la première."
  subject="mathematiques"
  cycle="lycee"
  level="1re"
>
  <LeaneShell
    active="qcm"
    title="QCM par base"
    subtitle="Choisis une base. Chaque QCM a maintenant sa propre page."
  >
    <section class="leane-panel">
      <p class="leane-eyebrow">Accès directs</p>
      <h2>Choisir un QCM</h2>
      <div class="leane-card-grid leane-qcm-choice-grid">
        {qcmBases.map((qcm) => (
          <a class="leane-course-card leane-qcm-choice" href={qcm.href}>
            <span class="leane-chip">{qcm.label}</span>
            <h2>{qcm.title}</h2>
            <p>{qcm.detail}</p>
            <div class="leane-progress-row">
              <strong>0 / {qcm.count}</strong>
              <span>{qcm.count} questions</span>
            </div>
            <div class="leane-progress" aria-hidden="true">
              <span style="width: 0%"></span>
            </div>
            <span class="leane-primary-link">Ouvrir le QCM</span>
          </a>
        ))}
      </div>
    </section>
  </LeaneShell>
</BaseLayout>

<style is:global>
  .leane-qcm-choice-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .leane-qcm-choice {
    color: inherit;
    min-height: 250px;
    text-decoration: none;
  }

  .leane-qcm-choice:hover,
  .leane-qcm-choice:focus-visible {
    border-color: #b9cef0;
    box-shadow: 0 14px 30px rgba(16, 42, 92, 0.09);
    transform: translateY(-1px);
  }

  .leane-qcm-choice .leane-primary-link {
    justify-self: start;
    margin-top: auto;
  }

  @media (max-width: 900px) {
    .leane-qcm-choice-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
