---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LeaneShell from "../../components/leane/LeaneShell.astro";
import { leaneCoursePracticeEntries } from "../../data/leane";
---

<BaseLayout
  title="Exercices Léane - révisions de mathématiques"
  description="Exercices gradués avec aide et correction pour consolider les bases avant la première."
  subject="mathematiques"
  cycle="lycee"
  level="1re"
>
  <LeaneShell
    active="exercices"
    title="Exercices guid&eacute;s"
    subtitle="Un niveau, une consigne, une aide, puis la correction seulement quand elle est utile."
  >
    <section class="leane-panel">
      <p class="leane-eyebrow">Par cours</p>
      <h2>Un exercice pour chaque cours</h2>
      <div class="leane-card-grid">
        {leaneCoursePracticeEntries.map(({ level, course, practice }) => (
          <section class="leane-exercise-card" id={`${level.id}-${course.title.toLowerCase().replaceAll(" ", "-")}`}>
            <span class="leane-chip">{level.title}</span>
            <h2>{course.title}</h2>
            <p><strong>{practice.exercise.title}</strong></p>
            <p>{practice.exercise.prompt}</p>
            <details>
              <summary>Voir une aide</summary>
              <p>{practice.exercise.hint}</p>
            </details>
            <details>
              <summary>Voir la correction</summary>
              <p>{practice.exercise.answer}</p>
            </details>
          </section>
        ))}
      </div>
    </section>
  </LeaneShell>
</BaseLayout>
