---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LeaneShell from "../../components/leane/LeaneShell.astro";
import { leaneCoursePracticeEntries } from "../../data/leane";
---

<BaseLayout
  title="Exercices Léane - révisions de mathématiques"
  description="Exercices gradués avec aide et correction pour consolider les bases avant la première."
  subject="mathematiques"
  cycle="lycee"
  level="1re"
>
  <LeaneShell
    active="exercices"
    title="Exercices guidés"
    subtitle="Un niveau, une consigne, une aide, puis la correction seulement quand elle est utile."
  >
    <section class="leane-panel">
      <p class="leane-eyebrow">Par cours</p>
      <h2>Séries progressives</h2>
      <div class="leane-card-grid">
        {leaneCoursePracticeEntries.map(({ level, course, exercises }) => (
          <section class="leane-exercise-card leane-exercise-runner" id={`${level.id}-${course.title.toLowerCase().replaceAll(" ", "-")}`} data-leane-exercises>
            <span class="leane-chip">{level.title}</span>
            <h2>{course.title}</h2>
            <div class="leane-exercise-runner__meta">
              <span data-leane-exercise-progress>1 / {exercises.length}</span>
              <small>{exercises.length} exercices</small>
            </div>
            <div class="leane-exercise-runner__stack">
              {exercises.map((exercise, index) => (
                <article class="leane-exercise-step" data-leane-exercise hidden={index !== 0}>
                  <p class="leane-card-muted">Niveau {exercise.level}</p>
                  <h3>{exercise.title}</h3>
                  <p>{exercise.prompt}</p>
                  <details>
                    <summary>Aide</summary>
                    <p>{exercise.hint}</p>
                  </details>
                  <details>
                    <summary>Correction</summary>
                    <p>{exercise.answer}</p>
                  </details>
                </article>
              ))}
            </div>
            <div class="leane-inline-actions">
              <button class="leane-outline-link" type="button" data-leane-exercise-prev disabled>Précédent</button>
              <button class="leane-primary-link" type="button" data-leane-exercise-next>Suivant</button>
              <button class="leane-outline-link" type="button" data-leane-exercise-reset>Recommencer</button>
            </div>
          </section>
        ))}
      </div>
    </section>
  </LeaneShell>
</BaseLayout>
