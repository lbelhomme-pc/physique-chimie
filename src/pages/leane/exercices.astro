---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LeaneShell from "../../components/leane/LeaneShell.astro";
import { getLeaneCourseExercises, leaneLevels } from "../../data/leane";

const slugify = (value: string) =>
  value
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
---

<BaseLayout
  title="Exercices Léane - révisions de mathématiques"
  description="Séries progressives séparées par cours pour consolider les acquis avant la première."
  subject="mathematiques"
  cycle="lycee"
  level="1re"
>
  <LeaneShell
    active="exercices"
    title="Exercices par cours"
    subtitle="Choisis une série. Chaque cours garde ses exercices progressifs, son aide et sa correction."
  >
    <section class="leane-grid" aria-label="Séries d'exercices par niveau">
      {leaneLevels.map((level) => (
        <article class="leane-panel" id={level.id}>
          <p class="leane-eyebrow">{level.subtitle}</p>
          <h2>{level.title}</h2>
          <div class="leane-card-grid leane-card-grid--courses">
            {level.courses.map((course) => {
              const href = `/leane/exercices/${level.id}-${slugify(course.title)}`;
              const exerciseCount = getLeaneCourseExercises(level.id, course.title).length;
              return (
                <a class="leane-course-card leane-exercise-choice" href={href}>
                  <span class="leane-chip">{level.title}</span>
                  <h2>{course.title}</h2>
                  <p>{course.focus}</p>
                  <div class="leane-progress-row">
                    <strong>0 / {exerciseCount}</strong>
                    <span>{exerciseCount} exercices</span>
                  </div>
                  <div class="leane-progress" aria-hidden="true">
                    <span style="width: 0%"></span>
                  </div>
                  <span class="leane-primary-link">Ouvrir la série</span>
                </a>
              );
            })}
          </div>
        </article>
      ))}
    </section>
  </LeaneShell>
</BaseLayout>

<style is:global>
  .leane-exercise-choice {
    color: inherit;
    min-height: 250px;
    text-decoration: none;
  }

  .leane-exercise-choice:hover,
  .leane-exercise-choice:focus-visible {
    border-color: #b9cef0;
    box-shadow: 0 14px 30px rgba(16, 42, 92, 0.09);
    transform: translateY(-1px);
  }

  .leane-exercise-choice .leane-primary-link {
    justify-self: start;
    margin-top: auto;
  }
</style>
