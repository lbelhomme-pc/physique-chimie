---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/laboratoire/global-lab.css";

interface Props {
  title: string;
  description: string;
  icon: string;
  level: string;
  concept: string;
  objective: string;
  legacyPath?: string;
}

const { title, description, icon, level, concept, objective, legacyPath } = Astro.props;
---

<BaseLayout title={`${title} — Laboratoire`} description={description} schemaType="EducationalContent">
  <article class="lab-page" data-legacy-path={legacyPath}>
    <nav class="lab-breadcrumb" aria-label="Fil d'Ariane">
      <a href="/laboratoire">← Laboratoire</a>
      <span aria-hidden="true">/</span>
      <span>{title}</span>
    </nav>

    <header class="lab-hero">
      <div class="lab-hero__icon" aria-hidden="true">{icon}</div>
      <div class="lab-hero__content">
        <p class="lab-hero__eyebrow">{level} · {concept}</p>
        <h1>{title}</h1>
        <p class="lab-hero__objective">{objective}</p>
      </div>
    </header>

    <slot />
  </article>
</BaseLayout>
