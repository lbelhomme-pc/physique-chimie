---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLabAccessibilityGuide } from "../../data/laboratoire/accessibilityGuides";
import "../../ui-v5/laboratoire/global-lab.css";

interface Props {
  slug: string;
  title: string;
  description: string;
  icon: string;
  level: string;
  concept: string;
  objective: string;
  legacyPath?: string;
}

const { slug, title, description, icon, level, concept, objective } = Astro.props;
const accessibilityGuide = getLabAccessibilityGuide(slug);
---

<BaseLayout
  title={`${title} — Laboratoire`}
  description={description}
  schemaType="SoftwareApplication"
  subject="physique-chimie"
  resourceType="simulation"
  level={level}
>
  <article class="ui5-page ui5-lab-page" data-subject="physique-chimie">
    <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">/</span>
      <a href="/physique-chimie">Physique-Chimie</a><span aria-hidden="true">/</span>
      <a href="/laboratoire">Laboratoire</a><span aria-hidden="true">/</span>
      <strong>{title}</strong>
    </nav>

    <header class="ui5-page-header">
      <div class="ui5-page-header__copy">
        <p class="ui5-kicker">{level} · {concept}</p>
        <h1 class="ui5-title">{title}</h1>
        <p class="ui5-lead">{objective}</p>
      </div>
      <span class="ui5-lab-page__mark" aria-hidden="true">{icon}</span>
    </header>

    <details class="ui5-section ui5-chapter-before ui5-lab-guide" data-lab-access-guide>
      <summary>
        <span>Exploitation accessible</span>
        <small>Hypothèse, mesures et conclusion</small>
      </summary>
      <div class="ui5-lab-guide__summary">
        <p>{accessibilityGuide.nonVisualSummary}</p>
      </div>
      <div class="ui5-chapter-before__grid">
        <section>
          <h2>Hypothèse</h2>
          <p>{accessibilityGuide.hypothesis}</p>
        </section>
        <section>
          <h2>Mesures à relever</h2>
          <ul>{accessibilityGuide.measurements.map((measurement) => <li>{measurement}</li>)}</ul>
        </section>
        <section>
          <h2>Conclusion attendue</h2>
          <p>{accessibilityGuide.conclusionPrompt}</p>
        </section>
      </div>
      <details class="ui5-lab-guide__questions">
        <summary>Questions de vérification</summary>
        <ol>{accessibilityGuide.questions.map((question) => <li>{question}</li>)}</ol>
      </details>
    </details>

    <section class="ui5-section ui5-lab-simulation">
      <slot />
    </section>
  </article>
</BaseLayout>
