---
import type { LabApp } from "../../data/laboratoire/apps";

interface Props { app: LabApp; }
const { app } = Astro.props;
const searchText = [app.title, app.level, app.concept, app.theme, app.objective, app.tags.join(" ")].join(" ");
---

<a
  class="ui5-card ui5-lab-card"
  href={app.route}
  data-lab-card
  data-app-slug={app.slug}
  data-theme={app.theme}
  data-levels={app.levels.join(" ")}
  data-topics={app.topics.join(" ")}
  data-search={searchText.toLocaleLowerCase("fr-FR")}
>
  <span class="ui5-lab-card__icon" aria-hidden="true">{app.icon}</span>
  <span class="ui5-lab-card__body">
    <span class="ui5-lab-card__tags">
      {app.tags.slice(0, 3).map((tag) => <em class="ui5-chip">{tag}</em>)}
    </span>
    <strong>{app.title}</strong>
    <span>{app.objective}</span>
    <b>Ouvrir la simulation →</b>
  </span>
</a>
