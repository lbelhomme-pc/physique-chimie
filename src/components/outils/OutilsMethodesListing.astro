---
import {
  getResourcesByLevel,
  getResourcesByType,
  typeDefinitions,
  typeLabels,
  type OutilMethodeLevel,
  type OutilMethodeType,
} from "../../data/outilsMethodes";

interface Props {
  level: OutilMethodeLevel;
  eyebrow: string;
  title: string;
  description: string;
}

const { level, eyebrow, title, description } = Astro.props;
const resources = getResourcesByLevel(level);
const orderedTypes: OutilMethodeType[] = ["methode", "outil"];
const sections = orderedTypes.map((type) => ({
  type,
  label: typeLabels[type],
  definition: typeDefinitions[type],
  resources: getResourcesByType(resources, type),
}));
---

<div class="ui5-page" data-subject="physique-chimie">
  <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane">
    <a href="/">Accueil</a><span aria-hidden="true">/</span>
    <a href="/outils-methodes">Outils et méthodes</a><span aria-hidden="true">/</span>
    <strong>{eyebrow}</strong>
  </nav>

  <header class="ui5-page-header">
    <div class="ui5-page-header__copy">
      <p class="ui5-kicker">{eyebrow}</p>
      <h1 class="ui5-title">{title}</h1>
      <p class="ui5-lead">{description}</p>
    </div>
    <p class="ui5-page-header__aside">{resources.length} ressource{resources.length > 1 ? "s" : ""}</p>
  </header>

  <nav class="ui5-filter-row" aria-label="Espaces outils et méthodes">
    <a class="ui5-filter" href="/outils-methodes/college" aria-current={level === "college" ? "true" : undefined}>Collège</a>
    <a class="ui5-filter" href="/outils-methodes/lycee" aria-current={level === "lycee" ? "true" : undefined}>Lycée</a>
    <a class="ui5-filter" href="/outils-methodes/transverses" aria-current={level === "transverse" ? "true" : undefined}>Transverses</a>
  </nav>

  <section class="ui5-section">
    <div class="ui5-grid ui5-grid--2">
      <article class="ui5-card ui5-definition-card">
        <span class="ui5-chip">Méthode</span>
        <p>{typeDefinitions.methode}</p>
      </article>
      <article class="ui5-card ui5-definition-card">
        <span class="ui5-chip">Outil</span>
        <p>{typeDefinitions.outil}</p>
      </article>
    </div>
  </section>

  {sections.map((section) => (
    <section class="ui5-section" aria-labelledby={`${section.type}-title`}>
      <div class="ui5-section-head">
        <h2 id={`${section.type}-title`}>{section.label}</h2>
        <p>{section.definition}</p>
      </div>

      {section.resources.length > 0 ? (
        <div class="ui5-grid ui5-grid--2">
          {section.resources.map((resource) => (
            <a class="ui5-card ui5-tool-card" href={resource.href}>
              <span class="ui5-tool-card__symbol" aria-hidden="true">{resource.symbol}</span>
              <span class="ui5-tool-card__body">
                <small>{resource.theme}</small>
                <strong>{resource.title}</strong>
                <span>{resource.description}</span>
                <em>{resource.details}</em>
              </span>
            </a>
          ))}
        </div>
      ) : (
        <div class="ui5-card ui5-empty"><p>Aucune ressource dédiée pour le moment.</p></div>
      )}
    </section>
  ))}
</div>
