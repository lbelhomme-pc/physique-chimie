---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="ui5-breadcrumb" aria-label="Fil d'Ariane">
  {items.map((item, index) => {
    const isLast = index === items.length - 1;
    return (
      <>
        {item.href && !isLast ? <a href={item.href}>{item.label}</a> : <strong>{item.label}</strong>}
        {!isLast && <span aria-hidden="true">/</span>}
      </>
    );
  })}
</nav>
