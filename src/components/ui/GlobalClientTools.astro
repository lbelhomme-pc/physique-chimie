---
import "../../ui-v5/global-client.css";
---
<!--
  Shell client global C16.
  Les comportements simples restent natifs ; le panneau React d'accessibilité
  n'est téléchargé qu'après une action explicite de l'utilisateur.
-->

<button
  type="button"
  class="global-a11y-launcher"
  data-global-a11y-launcher
  aria-label="Ouvrir les paramètres accessibilité et DYS"
  aria-controls="a11y-react-mount"
>
  <span aria-hidden="true">Aa</span>
</button>
<div id="a11y-react-mount" data-a11y-react-mount></div>

<div class="native-reading-guide" data-native-reading-guide hidden aria-hidden="true">
  <div class="native-reading-guide__shade" data-reading-guide-top></div>
  <div class="native-reading-guide__line" data-reading-guide-line></div>
  <div class="native-reading-guide__shade" data-reading-guide-bottom></div>
</div>

<button type="button" class="native-scroll-top" data-native-scroll-top hidden aria-label="Retour en haut">
  <span aria-hidden="true">↑</span>
</button>

<div class="native-xp-toast-stack" data-native-xp-toasts aria-live="polite" aria-atomic="false"></div>



<script>
  const launcher = document.querySelector<HTMLButtonElement>("[data-global-a11y-launcher]");
  const panelMount = document.querySelector<HTMLElement>("[data-a11y-react-mount]");
  const readingGuide = document.querySelector<HTMLElement>("[data-native-reading-guide]");
  const guideTop = document.querySelector<HTMLElement>("[data-reading-guide-top]");
  const guideLine = document.querySelector<HTMLElement>("[data-reading-guide-line]");
  const guideBottom = document.querySelector<HTMLElement>("[data-reading-guide-bottom]");
  const scrollTopButton = document.querySelector<HTMLButtonElement>("[data-native-scroll-top]");
  const toastStack = document.querySelector<HTMLElement>("[data-native-xp-toasts]");

  let panelMounted = false;
  let readingGuideEnabled = false;
  let readingGuideY = -100;
  const guideHeight = 44;

  function readStoredA11yPreferences(): Record<string, unknown> {
    try {
      const raw = localStorage.getItem("a11y_preferences");
      if (!raw) return {};
      const parsed = JSON.parse(raw);
      return parsed && typeof parsed === "object" ? parsed : {};
    } catch {
      return {};
    }
  }

  function renderReadingGuide() {
    if (!readingGuide || !guideTop || !guideLine || !guideBottom) return;
    if (!readingGuideEnabled || readingGuideY < 0) {
      readingGuide.hidden = true;
      return;
    }

    const topHeight = Math.max(0, readingGuideY - guideHeight / 2);
    readingGuide.hidden = false;
    guideTop.style.height = `${topHeight}px`;
    guideLine.style.top = `${topHeight}px`;
    guideBottom.style.top = `${topHeight + guideHeight}px`;
    guideBottom.style.bottom = "0";
  }

  function onGuideMouseMove(event: MouseEvent) {
    readingGuideY = event.clientY;
    renderReadingGuide();
  }

  function onGuideFocusIn(event: FocusEvent) {
    const target = event.target instanceof HTMLElement ? event.target : null;
    const rect = target?.getBoundingClientRect();
    if (!rect) return;
    readingGuideY = rect.top + rect.height / 2;
    renderReadingGuide();
  }

  function onGuideKeyDown(event: KeyboardEvent) {
    if (event.key === "ArrowDown" || event.key === "PageDown") {
      readingGuideY = Math.min(window.innerHeight - 20, Math.max(20, readingGuideY) + 36);
      renderReadingGuide();
    }
    if (event.key === "ArrowUp" || event.key === "PageUp") {
      readingGuideY = Math.max(20, Math.max(20, readingGuideY) - 36);
      renderReadingGuide();
    }
  }

  function setReadingGuideEnabled(enabled: boolean) {
    if (readingGuideEnabled === enabled) return;
    readingGuideEnabled = enabled;
    if (enabled) {
      window.addEventListener("mousemove", onGuideMouseMove, { passive: true });
      window.addEventListener("focusin", onGuideFocusIn);
      window.addEventListener("keydown", onGuideKeyDown);
    } else {
      window.removeEventListener("mousemove", onGuideMouseMove);
      window.removeEventListener("focusin", onGuideFocusIn);
      window.removeEventListener("keydown", onGuideKeyDown);
      readingGuideY = -100;
    }
    renderReadingGuide();
  }

  setReadingGuideEnabled(readStoredA11yPreferences().readingGuide === true);

  const scheduleIdle = (callback: () => void) => {
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(callback, { timeout: 1500 });
    } else {
      globalThis.setTimeout(callback, 250);
    }
  };

  scheduleIdle(() => {
    void import("../../data/accessibility/a11y-engine").then(({ getA11yEngine }) => {
      const engine = getA11yEngine();
      setReadingGuideEnabled(engine.getPrefs().readingGuide);
      engine.subscribe((prefs) => setReadingGuideEnabled(prefs.readingGuide));
    }).catch((error) => console.warn("C16: moteur d'accessibilité indisponible", error));
  });

  launcher?.addEventListener("click", async () => {
    if (!launcher || !panelMount || panelMounted) return;
    launcher.disabled = true;
    launcher.setAttribute("aria-busy", "true");

    try {
      const { mountAccessibilityPanel } = await import("../accessibility/mountAccessibilityPanel");
      await mountAccessibilityPanel(panelMount);
      panelMounted = true;
      launcher.hidden = true;
    } catch (error) {
      launcher.disabled = false;
      launcher.removeAttribute("aria-busy");
      launcher.setAttribute("aria-label", "Paramètres d'accessibilité indisponibles. Réessayer.");
      console.error("C16: chargement différé du panneau d'accessibilité impossible", error);
    }
  });

  function updateScrollTopVisibility() {
    if (scrollTopButton) scrollTopButton.hidden = window.scrollY <= 300;
  }

  window.addEventListener("scroll", updateScrollTopVisibility, { passive: true });
  updateScrollTopVisibility();
  scrollTopButton?.addEventListener("click", () => {
    const reduceMotion =
      document.documentElement.classList.contains("a11y-reduced-motion") ||
      window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
  });

  type NativeToast = {
    type: "xp" | "rank_up" | "badge" | "streak_bonus" | "chapter_complete";
    message: string;
    icon?: string;
  };

  function addToast(toast: NativeToast) {
    if (!toastStack) return;
    const bubble = document.createElement("div");
    bubble.className = "native-xp-toast";
    bubble.dataset.toastType = toast.type;
    bubble.setAttribute("role", "status");

    if (toast.icon) {
      const icon = document.createElement("span");
      icon.className = "native-xp-toast__icon";
      icon.setAttribute("aria-hidden", "true");
      icon.textContent = toast.icon;
      bubble.appendChild(icon);
    }

    const message = document.createElement("span");
    message.className = "native-xp-toast__message";
    message.textContent = toast.message;
    bubble.appendChild(message);
    toastStack.appendChild(bubble);

    window.requestAnimationFrame(() => bubble.classList.add("is-visible"));
    window.setTimeout(() => {
      bubble.classList.remove("is-visible");
      window.setTimeout(() => bubble.remove(), 300);
    }, 3000);
  }

  scheduleIdle(() => {
    void import("../../data/gamification/engine").then(({ getGamificationEngine }) => {
      const engine = getGamificationEngine();
      const result = engine.dailyLogin();

      if (result.xp > 0) {
        addToast({ type: "xp", message: `Connexion du jour : +${result.xp} XP`, icon: "🌅" });
      }
      if (result.streakBonus > 0) {
        const streak = engine.getStreak();
        addToast({
          type: "streak_bonus",
          message: `${streak.current} jours d'affilée ! +${result.streakBonus} XP bonus`,
          icon: "🔥",
        });
      }
      if (result.rankUp) {
        addToast({
          type: "rank_up",
          message: `Nouveau rang : ${result.rankUp.icon} ${result.rankUp.name} !`,
          icon: result.rankUp.icon,
        });
      }
      for (const badge of result.newBadges) {
        addToast({ type: "badge", message: `Badge : ${badge.icon} ${badge.name}`, icon: badge.icon });
      }
    }).catch((error) => console.warn("C16: gamification quotidienne indisponible", error));
  });
</script>
