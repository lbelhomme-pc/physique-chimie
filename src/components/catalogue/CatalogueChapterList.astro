---
import type { CatalogueAction, CatalogueChapterItem } from "./types";

interface Props {
  id: string;
  title: string;
  chapters: CatalogueChapterItem[];
  accent?: "physics" | "chemistry" | "maths" | "science";
  emptyTitle?: string;
  emptyMessage?: string;
  emptyActions?: CatalogueAction[];
}

const {
  id,
  title,
  chapters,
  accent = "physics",
  emptyTitle = "Aucun chapitre publié pour le moment",
  emptyMessage = "Les contenus seront ajoutés progressivement.",
  emptyActions = [],
} = Astro.props;

const sortedChapters = [...chapters].sort((a, b) => (a.order ?? 99) - (b.order ?? 99) || a.title.localeCompare(b.title));
---

<section id={id} class="ui5-catalogue-section ui5-section" data-accent={accent} aria-labelledby={`${id}-title`}>
  <div class="ui5-section-head">
    <h2 id={`${id}-title`}>{title}</h2>
    <p>{sortedChapters.length} chapitre{sortedChapters.length > 1 ? "s" : ""} dans l’ordre du programme</p>
  </div>

  {sortedChapters.length > 0 ? (
    <>
      <div class="ui5-toolbar" data-catalogue-toolbar>
        <label for={`${id}-search`}>Rechercher dans cette liste</label>
        <div class="ui5-search">
          <input
            id={`${id}-search`}
            type="search"
            placeholder="Titre, notion ou thème…"
            data-catalogue-search
            autocomplete="off"
          />
        </div>
        <p class="ui5-toolbar__summary" aria-live="polite" data-catalogue-summary>
          {sortedChapters.length} chapitre{sortedChapters.length > 1 ? "s" : ""}
        </p>
      </div>

      <ol class="ui5-chapter-list" data-catalogue-list>
        {sortedChapters.map((chapter, index) => (
          <li data-catalogue-item data-search-text={[chapter.title, chapter.description ?? "", ...(chapter.badges ?? [])].join(" ").toLocaleLowerCase("fr-FR")}>
            <a class="ui5-card ui5-chapter-card" href={chapter.href}>
              <span class="ui5-chapter-card__index" aria-label={`Chapitre ${index + 1}`}>{String(index + 1).padStart(2, "0")}</span>
              <span class="ui5-chapter-card__body">
                <strong>{chapter.title}</strong>
                {chapter.description && <span>{chapter.description}</span>}
                {chapter.badges && chapter.badges.length > 0 && (
                  <span class="ui5-chapter-card__meta" aria-label="Repères du chapitre">
                    {chapter.badges.slice(0, 2).map((badge) => <em class="ui5-chip">{badge}</em>)}
                  </span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ol>

      <p class="ui5-no-results" data-catalogue-no-results hidden>Aucun chapitre ne correspond à cette recherche.</p>
    </>
  ) : (
    <div class="ui5-card ui5-empty" aria-live="polite">
      <h3>{emptyTitle}</h3>
      <p>{emptyMessage}</p>
      {emptyActions.length > 0 && (
        <div class="ui5-filter-row">
          {emptyActions.map((action) => (
            <a class:list={["ui5-button", { "ui5-button--primary": action.primary }]} href={action.href}>{action.label}</a>
          ))}
        </div>
      )}
    </div>
  )}
</section>

<script>
  document.querySelectorAll<HTMLElement>(".ui5-catalogue-section").forEach((section) => {
    const input = section.querySelector<HTMLInputElement>("[data-catalogue-search]");
    const items = Array.from(section.querySelectorAll<HTMLElement>("[data-catalogue-item]"));
    const summary = section.querySelector<HTMLElement>("[data-catalogue-summary]");
    const noResults = section.querySelector<HTMLElement>("[data-catalogue-no-results]");
    if (!input || items.length === 0) return;

    const update = () => {
      const query = input.value.trim().toLocaleLowerCase("fr-FR");
      let visible = 0;
      items.forEach((item) => {
        const matches = !query || (item.dataset.searchText ?? "").includes(query);
        item.hidden = !matches;
        if (matches) visible += 1;
      });
      if (summary) summary.textContent = `${visible} chapitre${visible > 1 ? "s" : ""}`;
      if (noResults) noResults.hidden = visible > 0;
    };

    input.addEventListener("input", update);
  });
</script>
