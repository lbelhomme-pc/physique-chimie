---
import type { MathematicsLevel } from "../../data/mathematiques/types";

interface Props {
  level: MathematicsLevel;
  chapterCount?: number;
}

const { level, chapterCount = 0 } = Astro.props;
const isAvailable = chapterCount > 0 && level.status === "available";
const Tag = isAvailable ? "a" : "article";
const availableLabel = chapterCount === 0
  ? "Prévu"
  : `${chapterCount} chapitre${chapterCount > 1 ? "s" : ""}`;
---

<Tag
  class:list={["ui5-card", "ui5-level-card", "ui5-math-level-card", { "ui5-card--disabled": !isAvailable }]}
  href={isAvailable ? level.path : undefined}
  aria-disabled={!isAvailable ? "true" : undefined}
>
  <div class="ui5-level-card__top">
    <span class="ui5-level-card__badge">∑</span>
    <h3>{level.label}</h3>
  </div>
  {level.description && <p>{level.description}</p>}
  <div class="ui5-chapter-card__meta">
    <em class="ui5-chip">{availableLabel}</em>
    {level.shortLabel && <em class="ui5-chip">{level.shortLabel}</em>}
  </div>
  {isAvailable && <span class="ui5-card__cta">Voir les chapitres →</span>}
</Tag>
