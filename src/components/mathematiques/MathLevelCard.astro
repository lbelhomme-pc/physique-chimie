---
import type { MathematicsLevel } from "../../data/mathematiques/types";

interface Props {
  level: MathematicsLevel;
  chapterCount?: number;
}

const { level, chapterCount = 0 } = Astro.props;
const isAvailable = chapterCount > 0 && level.status === "available";
const Tag = isAvailable ? "a" : "article";
const availableLabel = chapterCount === 0
  ? "Prévu"
  : `${chapterCount} chapitre${chapterCount > 1 ? "s" : ""}`;
---

<Tag
  class:list={["math-card", "math-level-card", { disabled: !isAvailable }]}
  href={isAvailable ? level.path : undefined}
  aria-disabled={!isAvailable ? "true" : undefined}
>
  <p class="math-card-title">
    <span>{level.label}</span>
    {isAvailable && <span aria-hidden="true">→</span>}
  </p>
  {level.description && <p class="math-card-description">{level.description}</p>}
  <div class="math-card-meta">
    <span class:list={["math-badge", chapterCount === 0 ? "muted" : "success"]}>{availableLabel}</span>
    {level.shortLabel && <span class="math-badge muted">{level.shortLabel}</span>}
  </div>
</Tag>
