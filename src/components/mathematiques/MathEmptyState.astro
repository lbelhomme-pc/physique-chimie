---
interface Action {
  label: string;
  href: string;
  primary?: boolean;
}

interface Props {
  title?: string;
  message?: string;
  icon?: string;
  actions?: Action[];
  headingLevel?: "h2" | "h3";
}

const {
  title = "Aucun contenu n'est encore disponible.",
  message = "Les contenus seront ajoutés progressivement.",
  icon = "∅",
  actions = [],
  headingLevel = "h2",
} = Astro.props;

const HeadingTag = headingLevel;
---

<section class="ui5-card ui5-empty" aria-live="polite">
  <span class="ui5-empty__icon" aria-hidden="true">{icon}</span>
  <HeadingTag>{title}</HeadingTag>
  <p>{message}</p>
  {actions.length > 0 && (
    <div class="ui5-filter-row">
      {actions.map((action) => (
        <a href={action.href} class:list={["ui5-button", { "ui5-button--primary": action.primary }]}>
          {action.label}
        </a>
      ))}
    </div>
  )}
</section>
