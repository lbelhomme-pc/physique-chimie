---
import type { MathematicsResource } from "../../data/mathematiques/types";

interface Props {
  resource: MathematicsResource;
}

const { resource } = Astro.props;
const isAvailable = resource.status === "available";
const Tag = isAvailable && resource.href ? "a" : "article";
---

<Tag
  class:list={["ui5-card", "ui5-resource-card", { "ui5-card--disabled": !isAvailable }]}
  href={isAvailable ? resource.href : undefined}
  aria-disabled={!isAvailable ? "true" : undefined}
>
  <h3>{resource.title}</h3>
  {resource.description && <p>{resource.description}</p>}
  <div class="ui5-chapter-card__meta">
    <em class="ui5-chip">{isAvailable ? "Disponible" : "À venir"}</em>
  </div>
  {isAvailable && resource.href && <span class="ui5-card__cta">Ouvrir →</span>}
</Tag>
