---
import { siteConfig } from "../../config/site";
import { disciplineIdentities } from "../../data/disciplineIdentity";
import { publicMenuSections } from "../../data/publicMenu";
import type { CycleContext, SubjectId } from "./SubjectContext";

export interface Props {
  currentPath: string;
  subject?: SubjectId;
  cycle?: CycleContext;
  level?: string;
  resourceType?: string;
}

const { currentPath, subject = "transversal", cycle, level, resourceType } = Astro.props;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(`${href}/`);
}

const cycleLabel = cycle === "college" ? "Collège" : cycle === "lycee" ? "Lycée" : undefined;
const showContext = currentPath !== "/" && Boolean(cycleLabel || level || resourceType);
---

<header class="ui5-nav" data-ui5-navigation>
  <a class="ui5-skip-link" href="#main-content">Aller au contenu</a>

  <div class="ui5-nav__inner">
    <a class="ui5-nav__brand" href="/" aria-label={`${siteConfig.name} - accueil`}>
      <span class="ui5-nav__mark" aria-hidden="true">R</span>
      <span>
        <strong>{siteConfig.shortName}</strong>
        <small>Sciences et maths</small>
      </span>
    </a>

    <button class="ui5-nav__toggle" type="button" aria-expanded="false" aria-controls="ui5-nav-links">
      Menu
    </button>

    <nav id="ui5-nav-links" class="ui5-nav__links" aria-label="Navigation principale">
      {publicMenuSections.map((section) => (
        <details class="ui5-nav__menu" data-tone={section.tone}>
          <summary class:list={["ui5-nav__menu-summary", { active: isActive(section.href) }]}>
            {section.title}
          </summary>
          <div class="ui5-nav__panel">
            <a class="ui5-nav__overview" href={section.href}>Vue d’ensemble</a>
            {section.links.map((item) => (
              <a class:list={["ui5-nav__panel-link", { active: isActive(item.href) }]} href={item.href}>{item.label}</a>
            ))}
          </div>
        </details>
      ))}

      <a class:list={["ui5-nav__link", { active: currentPath === "/" }]} href="/#global-search">Recherche</a>
      <a class:list={["ui5-nav__link", { active: isActive("/profil") }]} href="/profil">Compte</a>
    </nav>
  </div>

  {showContext && (
    <div class="ui5-nav__context" aria-label="Contexte de navigation">
      <span>{subject === "transversal" ? "Toutes les matières" : disciplineIdentities[subject].label}</span>
      {cycleLabel && <span>{cycleLabel}</span>}
      {level && <span>{level}</span>}
    </div>
  )}
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-ui5-navigation]");
  if (nav) {
    const toggle = nav.querySelector<HTMLButtonElement>(".ui5-nav__toggle");
    const menus = Array.from(nav.querySelectorAll<HTMLDetailsElement>("details.ui5-nav__menu"));

    const closeMenus = () => menus.forEach((menu) => menu.removeAttribute("open"));
    const closeMobile = () => {
      nav.removeAttribute("data-open");
      toggle?.setAttribute("aria-expanded", "false");
    };

    toggle?.addEventListener("click", () => {
      const open = nav.getAttribute("data-open") === "true";
      if (open) {
        closeMenus();
        closeMobile();
      } else {
        nav.setAttribute("data-open", "true");
        toggle.setAttribute("aria-expanded", "true");
      }
    });

    menus.forEach((menu) => {
      menu.addEventListener("toggle", () => {
        if (!menu.open) return;
        menus.forEach((other) => {
          if (other !== menu) other.removeAttribute("open");
        });
      });
      menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
        closeMenus();
        closeMobile();
      }));
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (target instanceof Node && !nav.contains(target)) {
        closeMenus();
        closeMobile();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenus();
        closeMobile();
        toggle?.focus();
      }
    });
  }
</script>
