---
import { siteConfig } from "../../config/site";
import { disciplineIdentities } from "../../data/disciplineIdentity";
import { publicMenuSections } from "../../data/publicMenu";
import type { CycleContext, SubjectId } from "./SubjectContext";

export interface Props {
  currentPath: string;
  subject?: SubjectId;
  cycle?: CycleContext;
  level?: string;
  resourceType?: string;
}

const { currentPath, subject = "transversal", cycle, level, resourceType } = Astro.props;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(`${href}/`);
}

const cycleLabel = cycle === "college" ? "Collège" : cycle === "lycee" ? "Lycée" : undefined;
const showContext = currentPath !== "/" && !isActive("/leane") && Boolean(cycleLabel || level || resourceType);
---

<header class="public-nav" data-public-navigation>
  <a class="skip-link" href="#main-content">Aller au contenu</a>
  <div class="public-nav__inner">
    <a class="public-nav__brand" href="/" aria-label={`${siteConfig.name} - accueil`}>
      <span class="public-nav__mark" aria-hidden="true">R</span>
      <span class="public-nav__brand-text">
        <strong>{siteConfig.shortName}</strong>
        <small>Sciences et maths</small>
      </span>
    </a>

    <div class="public-nav__mobile-actions">
      <a class="public-nav__search-link" href="/#global-search" aria-label="Ouvrir la recherche globale">Rechercher</a>
      <button class="public-nav__mobile-toggle" type="button" aria-expanded="false" aria-controls="public-nav-links">
        <span>Menu</span>
      </button>
    </div>

    <nav id="public-nav-links" class="public-nav__links" aria-label="Navigation publique V4">
      {publicMenuSections.map((section) => (
        <details
          class={`public-nav__menu public-nav__menu--${section.tone}`}
          data-discipline={section.discipline}
        >
          <summary aria-label={`Ouvrir le menu ${section.title}`}>
            <span class="public-nav__menu-mark" aria-hidden="true"></span>
            <span>{section.title}</span>
          </summary>
          <div class="public-nav__panel">
            <a
              class:list={["public-nav__overview", { active: isActive(section.href) }]}
              href={section.href}
            >
              Ouvrir l'espace
            </a>
            <ul>
              {section.links.map((item) => (
                <li>
                  <a href={item.href} class:list={["public-nav__panel-link", { active: isActive(item.href) }]}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </details>
      ))}
      <a
        class:list={["public-nav__global-link", { active: isActive("/profil") }]}
        href="/profil"
      >
        Compte
      </a>
    </nav>
  </div>

  {showContext && (
    <div class="public-nav__context" aria-label="Contexte de navigation">
      <span>{subject === "transversal" ? "Toutes les matières" : disciplineIdentities[subject].label}</span>
      {cycleLabel && <span>{cycleLabel}</span>}
      {level && <span>{level}</span>}
    </div>
  )}
</header>

<script>
  const publicNavigation = document.querySelector("[data-public-navigation]");

  if (publicNavigation) {
    const menus = Array.from(publicNavigation.querySelectorAll<HTMLDetailsElement>("details.public-nav__menu"));
    const mobileToggle = publicNavigation.querySelector<HTMLButtonElement>(".public-nav__mobile-toggle");
    const closeMenus = () => menus.forEach((menu) => menu.removeAttribute("open"));
    const closeMobileMenu = () => {
      publicNavigation.removeAttribute("data-menu-open");
      mobileToggle?.setAttribute("aria-expanded", "false");
    };

    mobileToggle?.addEventListener("click", () => {
      const open = publicNavigation.getAttribute("data-menu-open") === "true";
      if (open) {
        closeMobileMenu();
        closeMenus();
      } else {
        publicNavigation.setAttribute("data-menu-open", "true");
        mobileToggle.setAttribute("aria-expanded", "true");
      }
    });

    menus.forEach((menu) => {
      menu.addEventListener("toggle", () => {
        if (!menu.open) return;
        menus.forEach((otherMenu) => {
          if (otherMenu !== menu) otherMenu.removeAttribute("open");
        });
      });

      menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          menu.removeAttribute("open");
          closeMobileMenu();
        });
      });
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (target instanceof Node && !publicNavigation.contains(target)) {
        closeMenus();
        closeMobileMenu();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenus();
        closeMobileMenu();
        mobileToggle?.focus();
      }
    });
  }
</script>

<style>
  .skip-link {
    background: #0f5bff;
    border-radius: 6px;
    color: #fff;
    left: 1rem;
    padding: 0.7rem 1rem;
    position: fixed;
    top: 0.75rem;
    transform: translateY(-170%);
    z-index: 1001;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .public-nav {
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid #e8eef8;
    font-family: "Plus Jakarta Sans", Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    position: sticky;
    top: 0;
    z-index: 90;
  }

  .public-nav__inner {
    align-items: center;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: auto minmax(0, 1fr);
    margin: 0 auto;
    max-width: 1440px;
    min-height: 84px;
    padding: 0 1.25rem;
  }

  .public-nav__brand {
    align-items: center;
    color: #061849;
    display: inline-flex;
    gap: 0.65rem;
    min-width: max-content;
    text-decoration: none;
  }

  .public-nav__mark {
    align-items: center;
    background: #0f5bff;
    border-radius: 6px;
    color: #fff;
    display: inline-flex;
    font-size: 0.95rem;
    font-weight: 950;
    height: 38px;
    justify-content: center;
    width: 38px;
  }

  .public-nav__brand-text {
    display: grid;
    gap: 0.08rem;
    line-height: 1.05;
  }

  .public-nav__brand-text strong {
    color: #061849;
    font-size: 0.9rem;
    font-weight: 920;
    white-space: nowrap;
  }

  .public-nav__brand-text small {
    color: #526b96;
    font-size: 0.72rem;
    font-weight: 760;
    white-space: nowrap;
  }

  .public-nav__mobile-actions {
    display: none;
  }

  .public-nav__search-link,
  .public-nav__mobile-toggle {
    align-items: center;
    border: 1px solid var(--v3-color-border-default);
    border-radius: var(--v3-radius-md);
    background: var(--v3-color-surface-page);
    color: var(--v3-color-text-main);
    display: inline-flex;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 850;
    justify-content: center;
    min-height: 44px;
    padding: 0.45rem 0.7rem;
    text-decoration: none;
  }

  .public-nav__mobile-toggle {
    cursor: pointer;
  }

  .public-nav__links {
    align-items: center;
    display: flex;
    gap: 0.35rem;
    justify-content: flex-end;
    width: 100%;
  }

  .public-nav__menu summary,
  .public-nav__global-link {
    align-items: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #061849;
    cursor: pointer;
    display: grid;
    font-size: 0.76rem;
    font-weight: 900;
    gap: 0.42rem;
    grid-template-columns: auto minmax(0, 1fr) auto;
    line-height: 1.15;
    min-height: 48px;
    padding: 0.45rem 0.6rem;
    text-decoration: none;
  }

  .public-nav__global-link {
    display: inline-flex;
    justify-content: center;
    white-space: nowrap;
  }

  .public-nav__menu {
    --menu-accent: #0f5bff;
    --menu-soft: #eef5ff;
    position: relative;
  }

  .public-nav__menu--maths { --menu-accent: var(--v3-color-discipline-maths); --menu-soft: var(--v3-color-discipline-maths-bg); }
  .public-nav__menu--pc { --menu-accent: var(--v3-color-discipline-pc); --menu-soft: var(--v3-color-discipline-pc-bg); }
  .public-nav__menu--science { --menu-accent: var(--v3-color-discipline-science); --menu-soft: var(--v3-color-discipline-science-bg); }
  .public-nav__menu--memory { --menu-accent: #e85d04; --menu-soft: #fff7ee; }
  .public-nav__menu--kit { --menu-accent: #102a5c; --menu-soft: #f3f6fb; }

  .public-nav__menu summary {
    list-style: none;
  }

  .public-nav__menu summary::-webkit-details-marker {
    display: none;
  }

  .public-nav__menu summary::after {
    color: var(--menu-accent);
    content: "⌄";
    font-size: 0.85em;
    transform: translateY(-0.05rem);
  }

  .public-nav__menu[open] summary::after {
    transform: rotate(180deg);
  }

  .public-nav__menu-mark {
    background: var(--menu-accent);
    border-radius: 999px;
    height: 9px;
    position: relative;
    width: 9px;
  }

  .public-nav__menu-mark::after {
    background: var(--menu-accent);
    border-radius: 999px;
    content: "";
    height: 2px;
    left: 6px;
    position: absolute;
    top: 7px;
    width: 7px;
  }

  .public-nav__panel {
    background: #fff;
    border: 1px solid #dde8fb;
    border-radius: 8px;
    box-shadow: 0 16px 34px rgba(15, 72, 160, 0.11);
    left: 50%;
    max-height: min(420px, calc(100vh - 120px));
    min-width: 250px;
    overflow-y: auto;
    position: absolute;
    top: calc(100% + 0.7rem);
    transform: translateX(-50%);
    z-index: 5;
  }

  .public-nav__menu:nth-last-child(-n + 2) .public-nav__panel {
    left: auto;
    right: 0;
    transform: none;
  }

  .public-nav__overview {
    align-items: center;
    background: var(--menu-soft);
    border-bottom: 1px solid #e4edf9;
    color: var(--menu-accent);
    display: flex;
    font-size: 0.8rem;
    font-weight: 900;
    justify-content: space-between;
    min-height: 42px;
    padding: 0 0.85rem;
    text-decoration: none;
  }

  .public-nav__overview::after {
    content: "→";
  }

  .public-nav__panel ul {
    list-style: none;
    margin: 0;
    padding: 0.35rem 0.75rem 0.6rem;
  }

  .public-nav__panel li + li {
    border-top: 1px solid #edf2fa;
  }

  .public-nav__panel-link {
    align-items: center;
    color: #09205d;
    display: flex;
    font-size: 0.84rem;
    font-weight: 800;
    justify-content: space-between;
    line-height: 1.25;
    min-height: 42px;
    padding: 0.45rem 0.2rem;
    text-decoration: none;
  }

  .public-nav__panel-link::after {
    color: var(--menu-accent);
    content: "›";
    font-size: 1.05rem;
    font-weight: 950;
  }

  .public-nav__overview:hover,
  .public-nav__overview:focus-visible,
  .public-nav__panel-link:hover,
  .public-nav__panel-link.active {
    color: var(--menu-accent);
  }

  .public-nav__menu[open] summary {
    background: var(--menu-soft);
    border-color: color-mix(in srgb, var(--menu-accent) 24%, #ffffff);
    color: var(--menu-accent);
  }

  .public-nav__global-link:hover,
  .public-nav__global-link.active {
    background: #eef5ff;
    border-color: #cdddf7;
    color: #0f5bff;
  }

  .public-nav__brand:focus-visible,
  .public-nav__menu summary:focus-visible,
  .public-nav__global-link:focus-visible,
  .public-nav__overview:focus-visible,
  .public-nav__panel-link:focus-visible {
    box-shadow: 0 0 0 4px rgba(15, 91, 255, 0.18);
    outline: none;
  }

  .public-nav__context {
    align-items: center;
    background: #f4f8ff;
    border-top: 1px solid #e8eef8;
    color: #385071;
    display: flex;
    font-size: 0.8rem;
    font-weight: 800;
    gap: 0.65rem;
    justify-content: center;
    min-height: 36px;
  }

  .public-nav__context span + span::before {
    color: #8ca0bf;
    content: "/";
    margin-right: 0.65rem;
  }

  @media (max-width: 1180px) {
    .public-nav__brand-text small {
      display: none;
    }

    .public-nav__inner {
      grid-template-columns: auto minmax(0, 1fr);
      min-height: 76px;
      padding: 0 0.75rem;
    }

    .public-nav__links {
      gap: 0.15rem;
      justify-content: flex-start;
      overflow-x: auto;
      padding-bottom: 0.15rem;
    }

    .public-nav__menu summary,
    .public-nav__global-link {
      font-size: 0.7rem;
      min-width: max-content;
      padding-inline: 0.45rem;
    }
  }

  @media (max-width: 760px) {
    .public-nav {
      position: sticky;
    }

    .public-nav__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      min-height: 60px;
      padding: 0.45rem 0.75rem;
    }

    .public-nav__brand {
      justify-content: flex-start;
      min-width: 0;
    }

    .public-nav__brand-text small {
      display: none;
    }

    .public-nav__mobile-actions {
      align-items: center;
      display: flex;
      gap: 0.4rem;
    }

    .public-nav__search-link {
      padding-inline: 0.6rem;
    }

    .public-nav__links {
      align-content: start;
      background: var(--v3-color-surface-page);
      display: none;
      gap: 0.5rem;
      inset: 60px 0 0;
      overflow-y: auto;
      padding: 1rem;
      position: fixed;
      width: auto;
      z-index: 89;
    }

    .public-nav[data-menu-open="true"] .public-nav__links {
      display: grid;
      grid-template-columns: 1fr;
    }

    .public-nav[data-menu-open="true"] .public-nav__mobile-toggle {
      background: var(--v3-color-action-subtle);
      border-color: var(--v3-color-action);
      color: var(--v3-color-action);
    }

    .public-nav__menu summary,
    .public-nav__global-link {
      background: var(--v3-color-surface-muted);
      grid-template-columns: auto minmax(0, 1fr) auto;
      min-height: 48px;
      padding: 0 0.85rem;
      width: 100%;
    }

    .public-nav__panel {
      box-shadow: none;
      left: auto;
      max-height: none;
      min-width: 0;
      position: static;
      right: auto;
      transform: none;
      width: 100%;
    }

    .public-nav__context {
      justify-content: flex-start;
      min-height: 32px;
      overflow: hidden;
      padding: 0 0.75rem;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>
