---
interface Props {
  chapterId: string;
  title?: string;
}

const { chapterId, title = "Cours" } = Astro.props;
const readerTitleId = `${chapterId.replace(/[^a-zA-Z0-9_-]/g, "-")}-course-reader-title`;
---

<section class="course-reader-v3" data-course-reader-v3 aria-labelledby={readerTitleId}>
  <h2 id={readerTitleId} class="course-reader-v3__title">{title}</h2>
  <div class="course-reader-v3__body">
    <slot />
  </div>
</section>

<style is:global>
  .course-reader-v3 {
    max-width: var(--max-line-width);
    margin: 0 auto;
  }

  .course-reader-v3__title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .course-reader-v3__body {
    display: flow-root;
    color: var(--text-primary);
    font-size: 1rem;
    line-height: 1.75;
  }

  .course-reader-v3 :where(h2, h3, h4) {
    letter-spacing: 0;
    scroll-margin-top: 6rem;
    text-wrap: balance;
  }

  .course-reader-v3 :where(p, li) {
    overflow-wrap: anywhere;
  }

  .course-reader-v3 :where(figure, table, pre, blockquote, svg) {
    break-inside: avoid;
  }

  .course-reader-v3 figure {
    margin: 1.4rem 0;
  }

  .course-reader-v3 figcaption {
    max-width: 64ch;
    margin: 0.65rem auto 0;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
    text-align: center;
  }

  .course-reader-v3 pre {
    max-width: 100%;
    overflow-x: auto;
    padding: 1rem;
    border-radius: var(--radius-md);
    background: #111827;
    color: #f8fafc;
    line-height: 1.6;
    -webkit-overflow-scrolling: touch;
  }

  .course-reader-v3 code {
    font-size: 0.92em;
  }

  .course-reader-v3 :not(pre) > code {
    padding: 0.08rem 0.28rem;
    border-radius: var(--radius-sm);
    background: var(--bg-tertiary);
    color: var(--text-primary);
  }

  .course-reader-v3 .course-law-heading {
    background: rgba(14, 116, 144, 0.1);
    color: #0e7490 !important;
  }

  .course-reader-v3 .course-law-heading::before {
    background: #0e7490;
  }

  .course-reader-v3 .course-synthesis-heading,
  .course-reader-v3 .course-vocabulary-heading {
    background: rgba(79, 70, 229, 0.1);
    color: var(--accent-primary) !important;
  }

  .course-reader-v3 .course-synthesis-heading::before,
  .course-reader-v3 .course-vocabulary-heading::before {
    background: var(--accent-primary);
  }

  .course-reader-v3 .course-law-heading + p,
  .course-reader-v3 .course-law-heading + ul,
  .course-reader-v3 .course-law-heading + ol,
  .course-reader-v3 .course-law-heading + table,
  .course-reader-v3 .course-law-heading + .katex-display,
  .course-reader-v3 .course-law-heading + .katex-block {
    border-left-color: #0e7490;
  }

  .course-reader-v3 .course-synthesis-heading + p,
  .course-reader-v3 .course-synthesis-heading + ul,
  .course-reader-v3 .course-synthesis-heading + ol,
  .course-reader-v3 .course-vocabulary-heading + p,
  .course-reader-v3 .course-vocabulary-heading + ul,
  .course-reader-v3 .course-vocabulary-heading + ol {
    border-left-color: var(--accent-primary);
  }

  .course-reader-v3 .retenir-box,
  .course-reader-v3 .box-regle-or,
  .course-reader-v3 .summary-box {
    border-radius: var(--radius-md);
  }

  .course-reader-v3 .definition-box,
  .course-reader-v3 .formule-box,
  .course-reader-v3 .formula-box,
  .course-reader-v3 .methode-box,
  .course-reader-v3 .m\00e9thode-box,
  .course-reader-v3 .info-box,
  .course-reader-v3 .example-box,
  .course-reader-v3 .box-regle-or,
  .course-reader-v3 .retenir-box {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .course-reader-v3 .katex-display,
  .course-reader-v3 .katex-block {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
  }

  .course-reader-v3 .katex .katex-mathml {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    clip-path: inset(50%) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .course-reader-v3 .katex .katex-html {
    max-width: 100%;
  }

  .course-reader-v3 table {
    contain: layout;
  }

  .course-reader-v3 svg[role="img"] :where(title, desc) {
    pointer-events: none;
  }

  @media (max-width: 700px) {
    .course-reader-v3__body {
      font-size: 0.96rem;
      line-height: 1.72;
    }

    .course-reader-v3 figure,
    .course-reader-v3 .schema-block,
    .course-reader-v3 .svg-wrap {
      margin-inline: -0.25rem;
    }
  }
</style>
