---
// src/components/pedagogie/ChapterTabs.astro
// Onglets de chapitre accessibles et homogènes pour cours, exercices, quiz et flashcards.

interface Props {
  hasCours?: boolean;
  hasActivite?: boolean;
  hasExercices?: boolean;
  hasQuiz?: boolean;
  hasFlashcards?: boolean;
  exercicesCount?: number;
  quizCount?: number;
  flashcardsCount?: number;
  backUrl?: string;
  backLabel?: string;
}

const {
  hasCours = true,
  hasActivite = false,
  hasExercices = false,
  hasQuiz = false,
  hasFlashcards = false,
  exercicesCount = 0,
  quizCount = 0,
  flashcardsCount = 0,
  backUrl = "",
  backLabel = "Retour",
} = Astro.props;

const activeTab = hasCours
  ? "cours"
  : hasActivite
    ? "activite"
    : hasExercices
      ? "exercices"
      : hasQuiz
        ? "quiz"
        : hasFlashcards
          ? "flashcards"
          : "";
---

<div class="chapter-tabs-wrapper" data-chapter-tabs>
  <div class="chapter-tabs">
    {backUrl && (
      <a href={backUrl} class="tab-pill tab-back">
        <span>{backLabel}</span>
      </a>
    )}

    <nav class="chapter-tablist" role="tablist" aria-label="Sections du chapitre">
      {hasCours && (
        <button
          type="button"
          id="chapter-tab-cours"
          class:list={["tab-pill", { active: activeTab === "cours" }]}
          role="tab"
          aria-selected={activeTab === "cours" ? "true" : "false"}
          aria-controls="chapter-panel-cours"
          tabindex={activeTab === "cours" ? "0" : "-1"}
          data-tab="cours"
        >
          Cours
        </button>
      )}
      {hasActivite && (
        <button
          type="button"
          id="chapter-tab-activite"
          class:list={["tab-pill", { active: activeTab === "activite" }]}
          role="tab"
          aria-selected={activeTab === "activite" ? "true" : "false"}
          aria-controls="chapter-panel-activite"
          tabindex={activeTab === "activite" ? "0" : "-1"}
          data-tab="activite"
        >
          Activite
        </button>
      )}
      {hasExercices && (
        <button
          type="button"
          id="chapter-tab-exercices"
          class:list={["tab-pill", { active: activeTab === "exercices" }]}
          role="tab"
          aria-selected={activeTab === "exercices" ? "true" : "false"}
          aria-controls="chapter-panel-exercices"
          tabindex={activeTab === "exercices" ? "0" : "-1"}
          data-tab="exercices"
        >
          Exercices
          {exercicesCount > 0 && <span class="tab-badge">{exercicesCount}</span>}
        </button>
      )}
      {hasQuiz && (
        <button
          type="button"
          id="chapter-tab-quiz"
          class:list={["tab-pill", { active: activeTab === "quiz" }]}
          role="tab"
          aria-selected={activeTab === "quiz" ? "true" : "false"}
          aria-controls="chapter-panel-quiz"
          tabindex={activeTab === "quiz" ? "0" : "-1"}
          data-tab="quiz"
        >
          Quiz
          {quizCount > 0 && <span class="tab-badge">{quizCount}</span>}
        </button>
      )}
      {hasFlashcards && (
        <button
          type="button"
          id="chapter-tab-flashcards"
          class:list={["tab-pill", { active: activeTab === "flashcards" }]}
          role="tab"
          aria-selected={activeTab === "flashcards" ? "true" : "false"}
          aria-controls="chapter-panel-flashcards"
          tabindex={activeTab === "flashcards" ? "0" : "-1"}
          data-tab="flashcards"
        >
          Flashcards
          {flashcardsCount > 0 && <span class="tab-badge">{flashcardsCount}</span>}
        </button>
      )}
    </nav>
  </div>

  <div class="tab-panels">
    {hasCours && (
      <div
        id="chapter-panel-cours"
        class:list={["tab-panel", { active: activeTab === "cours" }]}
        data-panel="cours"
        role="tabpanel"
        aria-labelledby="chapter-tab-cours"
        hidden={activeTab !== "cours"}
      >
        <slot name="cours" />
      </div>
    )}
    {hasActivite && (
      <div
        id="chapter-panel-activite"
        class:list={["tab-panel", { active: activeTab === "activite" }]}
        data-panel="activite"
        role="tabpanel"
        aria-labelledby="chapter-tab-activite"
        hidden={activeTab !== "activite"}
      >
        <slot name="activite" />
      </div>
    )}
    {hasExercices && (
      <div
        id="chapter-panel-exercices"
        class:list={["tab-panel", { active: activeTab === "exercices" }]}
        data-panel="exercices"
        role="tabpanel"
        aria-labelledby="chapter-tab-exercices"
        hidden={activeTab !== "exercices"}
      >
        <slot name="exercices" />
      </div>
    )}
    {hasQuiz && (
      <div
        id="chapter-panel-quiz"
        class:list={["tab-panel", { active: activeTab === "quiz" }]}
        data-panel="quiz"
        role="tabpanel"
        aria-labelledby="chapter-tab-quiz"
        hidden={activeTab !== "quiz"}
      >
        <slot name="quiz" />
      </div>
    )}
    {hasFlashcards && (
      <div
        id="chapter-panel-flashcards"
        class:list={["tab-panel", { active: activeTab === "flashcards" }]}
        data-panel="flashcards"
        role="tabpanel"
        aria-labelledby="chapter-tab-flashcards"
        hidden={activeTab !== "flashcards"}
      >
        <slot name="flashcards" />
      </div>
    )}
  </div>
</div>

<style>
  .chapter-tabs-wrapper {
    max-width: 900px;
    margin: 0 auto;
  }

  .chapter-tabs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .chapter-tablist {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .tab-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--text-muted);
    font-weight: 700;
    font-size: 0.9rem;
    border: 1px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s, border-color 0.2s, color 0.2s, outline-color 0.2s;
    font-family: inherit;
    text-decoration: none;
  }

  .tab-pill:hover {
    background: var(--bg-tertiary);
    color: var(--text-primary);
  }

  .tab-pill:focus-visible {
    outline: 3px solid var(--accent-primary);
    outline-offset: 3px;
  }

  .tab-pill.active {
    background: var(--accent-primary-light);
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }

  .tab-back {
    color: var(--text-secondary);
  }

  .tab-back:hover {
    background: var(--bg-tertiary);
    color: var(--text-primary);
    text-decoration: none;
  }

  .tab-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 99px;
    background: var(--bg-tertiary);
    color: var(--text-muted);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .tab-pill.active .tab-badge {
    background: var(--accent-primary);
    color: #ffffff;
  }

  .tab-panel,
  .tab-panel[hidden] {
    display: none;
  }

  .tab-panel.active {
    display: block;
    animation: fadeIn 0.2s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 600px) {
    .chapter-tabs {
      justify-content: center;
      overflow-x: visible;
    }

    .chapter-tablist {
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
    }

    .tab-pill {
      flex: 1 1 calc(50% - 0.4rem);
      justify-content: center;
      min-width: 0;
      padding: 0.45rem 0.8rem;
      font-size: 0.8rem;
      text-align: center;
      white-space: normal;
    }

    .tab-back {
      flex: 0 0 auto;
      white-space: nowrap;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    function normalizeHeading(text: string) {
      return text
        .trim()
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/\s+/g, " ");
    }

    function enhanceCourseHeadings(root: ParentNode) {
      const courseBlocks = root.querySelectorAll<HTMLElement>(
        ".cours-content, .course-tab-content, .course-reader-v3"
      );

      courseBlocks.forEach((block) => {
        const headings = block.querySelectorAll<HTMLHeadingElement>("h3, h4");

        headings.forEach((heading) => {
          const text = normalizeHeading(heading.textContent ?? "");
          if (!text || heading.dataset.courseUx === "done") return;

          if (/^\d+[\s.)-]/.test(text)) {
            heading.classList.add("course-idea-heading");
          }

          if (/^definitions?$/.test(text) || text === "definition" || text === "definitions essentielles") {
            heading.classList.add("course-label-heading", "course-definition-heading");
          } else if (
            text === "methode" ||
            text === "methodes" ||
            text === "formule ou methode" ||
            text === "formules et methodes" ||
            text === "methode importante" ||
            text === "methodes importantes" ||
            text.startsWith("methode -") ||
            text.startsWith("methode :")
          ) {
            heading.classList.add("course-label-heading", "course-method-heading");
          } else if (
            text === "loi" ||
            text === "lois" ||
            text === "propriete" ||
            text === "proprietes" ||
            text === "principe" ||
            text === "principes" ||
            text === "theoreme" ||
            text === "theoremes" ||
            text === "formule" ||
            text === "formules" ||
            text === "formule importante" ||
            text === "formules importantes" ||
            text.includes("loi d'") ||
            text.includes("loi de ") ||
            text.includes("loi des ") ||
            text.includes("relation a connaitre")
          ) {
            heading.classList.add("course-label-heading", "course-law-heading");
          } else if (/^exemples?$/.test(text) || text === "exemple corrige" || text === "exemples corriges") {
            heading.classList.add("course-label-heading", "course-example-heading");
          } else if (
            text === "erreur frequente" ||
            text === "erreurs frequentes" ||
            text === "pieges classiques" ||
            text === "point de vigilance" ||
            text === "attention" ||
            text === "danger"
          ) {
            heading.classList.add("course-label-heading", "course-warning-heading");
          } else if (
            text === "synthese" ||
            text === "resume" ||
            text === "resume du chapitre" ||
            text === "points cles" ||
            text === "a retenir" ||
            text === "bilan" ||
            text === "l'essentiel" ||
            text === "essentiel" ||
            text === "formules et idees a retenir"
          ) {
            heading.classList.add("course-label-heading", "course-synthesis-heading");
          } else if (
            text === "vocabulaire" ||
            text === "lexique" ||
            text === "mots cles" ||
            text === "mots-cles"
          ) {
            heading.classList.add("course-label-heading", "course-vocabulary-heading");
          }

          heading.dataset.courseUx = "done";
        });
      });
    }

    enhanceCourseHeadings(document);

    const wrappers = document.querySelectorAll<HTMLElement>("[data-chapter-tabs]");

    wrappers.forEach((wrapper) => {
      enhanceCourseHeadings(wrapper);

      const tabs = wrapper.querySelectorAll<HTMLButtonElement>(".tab-pill[data-tab]");
      const panels = wrapper.querySelectorAll<HTMLDivElement>(".tab-panel[data-panel]");
      const summaryLinks = document.querySelectorAll<HTMLAnchorElement>("[data-chapter-summary-link]");

      function syncChapterSummary(target: string) {
        summaryLinks.forEach((link) => {
          if (link.dataset.chapterSummaryLink === target) {
            link.setAttribute("aria-current", "step");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      }

      function activateTab(tab: HTMLButtonElement) {
        const target = tab.dataset.tab;
        if (!target) return;

        tabs.forEach((item) => {
          item.classList.remove("active");
          item.setAttribute("aria-selected", "false");
          item.setAttribute("tabindex", "-1");
        });

        panels.forEach((panel) => {
          panel.classList.remove("active");
          panel.hidden = true;
        });

        tab.classList.add("active");
        tab.setAttribute("aria-selected", "true");
        tab.setAttribute("tabindex", "0");

        const panel = wrapper.querySelector<HTMLDivElement>(`.tab-panel[data-panel="${target}"]`);
        if (panel) {
          panel.hidden = false;
          panel.classList.add("active");
        }

        syncChapterSummary(target);
      }

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => activateTab(tab));

        tab.addEventListener("keydown", (event) => {
          const tabsArray = Array.from(tabs);
          const index = tabsArray.indexOf(tab);
          let next = -1;

          if (event.key === "ArrowRight" || event.key === "ArrowDown") {
            next = (index + 1) % tabsArray.length;
          } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
            next = (index - 1 + tabsArray.length) % tabsArray.length;
          } else if (event.key === "Home") {
            next = 0;
          } else if (event.key === "End") {
            next = tabsArray.length - 1;
          }

          if (next >= 0) {
            event.preventDefault();
            activateTab(tabsArray[next]);
            tabsArray[next].focus();
          }
        });
      });

      summaryLinks.forEach((link) => {
        link.addEventListener("click", () => {
          const target = link.dataset.chapterSummaryLink;
          const tab = target ? wrapper.querySelector<HTMLButtonElement>(`.tab-pill[data-tab="${target}"]`) : null;
          if (tab) activateTab(tab);
        });
      });
    });
  });
</script>
