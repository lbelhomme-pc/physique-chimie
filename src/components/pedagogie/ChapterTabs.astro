---
// src/components/pedagogie/ChapterTabs.astro
// Onglets de chapitre accessibles et homogènes pour cours, exercices, quiz et flashcards.

interface Props {
  hasCours?: boolean;
  hasExercices?: boolean;
  hasQuiz?: boolean;
  hasFlashcards?: boolean;
  exercicesCount?: number;
  quizCount?: number;
  flashcardsCount?: number;
  backUrl?: string;
  backLabel?: string;
}

const {
  hasCours = true,
  hasExercices = false,
  hasQuiz = false,
  hasFlashcards = false,
  exercicesCount = 0,
  quizCount = 0,
  flashcardsCount = 0,
  backUrl = "",
  backLabel = "Retour",
} = Astro.props;
---

<div class="chapter-tabs-wrapper" data-chapter-tabs>
  <div class="chapter-tabs">
    {backUrl && (
      <a href={backUrl} class="tab-pill tab-back">
        <span>{backLabel}</span>
      </a>
    )}

    <nav class="chapter-tablist" role="tablist" aria-label="Sections du chapitre">
      {hasCours && (
        <button
          type="button"
          id="chapter-tab-cours"
          class="tab-pill active"
          role="tab"
          aria-selected="true"
          aria-controls="chapter-panel-cours"
          tabindex="0"
          data-tab="cours"
        >
          Cours
        </button>
      )}
      {hasExercices && (
        <button
          type="button"
          id="chapter-tab-exercices"
          class="tab-pill"
          role="tab"
          aria-selected="false"
          aria-controls="chapter-panel-exercices"
          tabindex="-1"
          data-tab="exercices"
        >
          Exercices
          {exercicesCount > 0 && <span class="tab-badge">{exercicesCount}</span>}
        </button>
      )}
      {hasQuiz && (
        <button
          type="button"
          id="chapter-tab-quiz"
          class="tab-pill"
          role="tab"
          aria-selected="false"
          aria-controls="chapter-panel-quiz"
          tabindex="-1"
          data-tab="quiz"
        >
          Quiz
          {quizCount > 0 && <span class="tab-badge">{quizCount}</span>}
        </button>
      )}
      {hasFlashcards && (
        <button
          type="button"
          id="chapter-tab-flashcards"
          class="tab-pill"
          role="tab"
          aria-selected="false"
          aria-controls="chapter-panel-flashcards"
          tabindex="-1"
          data-tab="flashcards"
        >
          Flashcards
          {flashcardsCount > 0 && <span class="tab-badge">{flashcardsCount}</span>}
        </button>
      )}
    </nav>
  </div>

  <div class="tab-panels">
    {hasCours && (
      <div
        id="chapter-panel-cours"
        class="tab-panel active"
        data-panel="cours"
        role="tabpanel"
        aria-labelledby="chapter-tab-cours"
      >
        <slot name="cours" />
      </div>
    )}
    {hasExercices && (
      <div
        id="chapter-panel-exercices"
        class="tab-panel"
        data-panel="exercices"
        role="tabpanel"
        aria-labelledby="chapter-tab-exercices"
        hidden
      >
        <slot name="exercices" />
      </div>
    )}
    {hasQuiz && (
      <div
        id="chapter-panel-quiz"
        class="tab-panel"
        data-panel="quiz"
        role="tabpanel"
        aria-labelledby="chapter-tab-quiz"
        hidden
      >
        <slot name="quiz" />
      </div>
    )}
    {hasFlashcards && (
      <div
        id="chapter-panel-flashcards"
        class="tab-panel"
        data-panel="flashcards"
        role="tabpanel"
        aria-labelledby="chapter-tab-flashcards"
        hidden
      >
        <slot name="flashcards" />
      </div>
    )}
  </div>
</div>

<style>
  .chapter-tabs-wrapper {
    max-width: 900px;
    margin: 0 auto;
  }

  .chapter-tabs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .chapter-tablist {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .tab-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--text-muted);
    font-weight: 700;
    font-size: 0.9rem;
    border: 1px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s, border-color 0.2s, color 0.2s, outline-color 0.2s;
    font-family: inherit;
    text-decoration: none;
  }

  .tab-pill:hover {
    background: var(--bg-tertiary);
    color: var(--text-primary);
  }

  .tab-pill:focus-visible {
    outline: 3px solid var(--accent-primary);
    outline-offset: 3px;
  }

  .tab-pill.active {
    background: var(--accent-primary-light);
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }

  .tab-back {
    color: var(--text-secondary);
  }

  .tab-back:hover {
    background: var(--bg-tertiary);
    color: var(--text-primary);
    text-decoration: none;
  }

  .tab-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 99px;
    background: var(--bg-tertiary);
    color: var(--text-muted);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .tab-pill.active .tab-badge {
    background: var(--accent-primary);
    color: #ffffff;
  }

  .tab-panel,
  .tab-panel[hidden] {
    display: none;
  }

  .tab-panel.active {
    display: block;
    animation: fadeIn 0.2s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 600px) {
    .chapter-tabs {
      justify-content: center;
      overflow-x: visible;
    }

    .chapter-tablist {
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
    }

    .tab-pill {
      flex: 1 1 calc(50% - 0.4rem);
      justify-content: center;
      min-width: 0;
      padding: 0.45rem 0.8rem;
      font-size: 0.8rem;
      text-align: center;
      white-space: normal;
    }

    .tab-back {
      flex: 0 0 auto;
      white-space: nowrap;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const wrappers = document.querySelectorAll<HTMLElement>("[data-chapter-tabs]");

    wrappers.forEach((wrapper) => {
      const tabs = wrapper.querySelectorAll<HTMLButtonElement>(".tab-pill[data-tab]");
      const panels = wrapper.querySelectorAll<HTMLDivElement>(".tab-panel[data-panel]");

      function activateTab(tab: HTMLButtonElement) {
        const target = tab.dataset.tab;
        if (!target) return;

        tabs.forEach((item) => {
          item.classList.remove("active");
          item.setAttribute("aria-selected", "false");
          item.setAttribute("tabindex", "-1");
        });

        panels.forEach((panel) => {
          panel.classList.remove("active");
          panel.hidden = true;
        });

        tab.classList.add("active");
        tab.setAttribute("aria-selected", "true");
        tab.setAttribute("tabindex", "0");

        const panel = wrapper.querySelector<HTMLDivElement>(`.tab-panel[data-panel="${target}"]`);
        if (panel) {
          panel.hidden = false;
          panel.classList.add("active");
        }
      }

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => activateTab(tab));

        tab.addEventListener("keydown", (event) => {
          const tabsArray = Array.from(tabs);
          const index = tabsArray.indexOf(tab);
          let next = -1;

          if (event.key === "ArrowRight" || event.key === "ArrowDown") {
            next = (index + 1) % tabsArray.length;
          } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
            next = (index - 1 + tabsArray.length) % tabsArray.length;
          } else if (event.key === "Home") {
            next = 0;
          } else if (event.key === "End") {
            next = tabsArray.length - 1;
          }

          if (next >= 0) {
            event.preventDefault();
            activateTab(tabsArray[next]);
            tabsArray[next].focus();
          }
        });
      });
    });
  });
</script>
