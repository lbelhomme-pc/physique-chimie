---
import "../../ui-v5/imported-content.css";
import { renderMathInTrustedHtml } from "../../utils/trustedContent";

interface Props {
  html: string;
}

const { html } = Astro.props;

function normalizeImportedContent(source: string) {
  const normalized = String(source ?? "")
    .replace(
      /<section[^>]*>\s*<h2[^>]*>\s*(?:Pr�requis|Prérequis|Problematique|Probl�matique|Problématique|Activite[\s\S]*?|Activit�[\s\S]*?|Activité[\s\S]*?|Situation[\s\S]*?)\s*<\/h2>[\s\S]*?<\/section>/gi,
      "",
    )
    .replace(/<div[^>]*class="[^"]*(?:activite-box|activity-box|discovery-box|prerequis-box|problem-box)[^"]*"[^>]*>[\s\S]*?<\/div>/gi, "")
    .replace(
      /<p>\s*<strong>\s*Objectifs du chapitre\s*<\/strong>\s*<\/p>\s*(<ul[\s\S]*?<\/ul>)/i,
      `<section class="objectives-card">
  <h2 class="objectives-title">Objectifs</h2>
  $1
</section>`,
    )
    .replace(
      /<section class="course-section">\s*<h2>\s*Objectifs du chapitre\s*<\/h2>/i,
      `<section class="course-section objectives-card">
  <h2 class="objectives-title">Objectifs</h2>`,
    )
    .replace(
      /<h2(?:\s+class="[^"]*")?>\s*Objectifs du chapitre\s*<\/h2>/gi,
      `<h2 class="objectives-title">Objectifs</h2>`,
    )
    .replace(
      /<h2[^>]*>\s*(?:\d+\s*[./-]\s*)?(?:Points cl�s|� retenir)\s*<\/h2>\s*<div class="card chapter-card">\s*([\s\S]*?)\s*<\/div>/gi,
      `<div class="summary-box">
  <strong class="summary-label">� retenir</strong>
  $1
</div>`,
    )
    .replace(
      /<h2[^>]*>\s*(?:\d+\s*[./-]\s*)?(?:Points cl�s|� retenir)\s*<\/h2>\s*(<ul[\s\S]*?<\/ul>)/gi,
      `<div class="summary-box">
  <strong class="summary-label">� retenir</strong>
  $1
</div>`,
    )
    .replace(
      /<h2[^>]*>\s*(?:\d+\s*[./-]\s*)?Points cl�s\s*<\/h2>/gi,
      `<h2 class="final-summary-title">� retenir</h2>`,
    )
    .replace(
      /<h2[^>]*>\s*(?:\d+\s*[./-]\s*)?� retenir\s*<\/h2>/gi,
      `<h2 class="final-summary-title">� retenir</h2>`,
    )
    .replace(/<strong>\s*R�sum�\.?\s*<\/strong>/gi, `<strong class="summary-label">� retenir</strong>`);
  if (normalized.includes("course-main-heading")) return normalized;

  return normalized.replace(
    /(<section class="course-section objectives-card">[\s\S]*?<\/section>)(\s*)/i,
    `$1
<h2 class="course-main-heading" data-course-section="course">Cours</h2>$2`,
  );
}

const renderedHtml = renderMathInTrustedHtml(normalizeImportedContent(html));
---

<div class="spe-imported-content" set:html={renderedHtml} />
