---
export type LandingTone = "maths" | "pc" | "science" | "memory" | "kit" | "mixed";

export interface LandingAction {
  label: string;
  href: string;
  variant?: "primary" | "secondary";
}

export interface LandingStat {
  value: string | number;
  label: string;
}

interface Props {
  tone: LandingTone;
  eyebrow: string;
  mark: string;
  markLabel: string;
  title: string;
  description: string;
  actions?: readonly LandingAction[];
  stats?: readonly LandingStat[];
  imageAlt?: string;
  contained?: boolean;
  titleId?: string;
}

const {
  tone,
  eyebrow,
  mark,
  markLabel,
  title,
  description,
  actions = [],
  stats = [],
  contained = false,
  titleId,
} = Astro.props;
---

<header
  class:list={["ui5-landing-hero", `ui5-landing-hero--${tone}`, { "ui5-landing-hero--contained": contained }]}
  data-v5-landing-hero
>
  <div class="ui5-landing-hero__copy">
    <p class="ui5-kicker ui5-landing-hero__identity">
      <span class="ui5-landing-hero__mark" aria-hidden="true">{mark}</span>
      <span>{eyebrow}</span>
      <span class="sr-only">{markLabel}</span>
    </p>
    <h1 class="ui5-title" id={titleId}>{title}</h1>
    <p class="ui5-lead">{description}</p>

    {actions.length > 0 && (
      <nav class="ui5-landing-hero__actions" aria-label={`Accès rapides - ${title}`}>
        {actions.map((action) => (
          <a class:list={["ui5-button", { "ui5-button--primary": action.variant !== "secondary" }]} href={action.href}>
            {action.label}
          </a>
        ))}
      </nav>
    )}

    {stats.length > 0 && (
      <dl class="ui5-landing-hero__stats" aria-label={`Repères - ${title}`}>
        {stats.map((stat) => (
          <div>
            <dt>{stat.value}</dt>
            <dd>{stat.label}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</header>
