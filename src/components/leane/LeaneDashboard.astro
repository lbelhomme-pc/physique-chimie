---
import { leaneCoursePracticeEntries, leaneFlashcards, leaneLevels } from "../../data/leane";
import LeaneIcon from "./LeaneIcon.astro";
import LeaneShell from "./LeaneShell.astro";

const exerciseCount = leaneCoursePracticeEntries.reduce((total, entry) => total + entry.exercises.length, 0);
---

<LeaneShell
  active="accueil"
  title="Tableau de bord de révision"
  subtitle="Une arborescence courte pour reprendre les acquis avant la première."
>
  <section class="leane-stat-grid" aria-label="Synthèse">
    <article class="leane-stat">
      <span class="leane-stat__icon" style="color: #16a887"><LeaneIcon name="check" /></span>
      <div>
        <span>Parcours structuré</span>
        <strong>3</strong>
        <small>niveaux à consolider</small>
      </div>
    </article>
    <article class="leane-stat">
      <span class="leane-stat__icon" style="color: #1f6feb"><LeaneIcon name="book" /></span>
      <div>
        <span>Cours courts</span>
        <strong>9</strong>
        <small>notions prioritaires</small>
      </div>
    </article>
    <article class="leane-stat">
      <span class="leane-stat__icon" style="color: #ff7a1a"><LeaneIcon name="exercises" /></span>
      <div>
        <span>Exercices corrigés</span>
        <strong>{exerciseCount}</strong>
        <small>aides progressives</small>
      </div>
    </article>
    <article class="leane-stat">
      <span class="leane-stat__icon" style="color: #7c5cff"><LeaneIcon name="cards" /></span>
      <div>
        <span>Mémorisation</span>
        <strong>{leaneFlashcards.length}</strong>
        <small>cartes globales</small>
      </div>
    </article>
  </section>

  <section class="leane-grid">
    <article class="leane-panel">
      <h2>Accès par niveau</h2>
      <div class="leane-card-grid">
        {leaneLevels.map((level) => (
          <section class="leane-level-card" style={`--level-accent: ${level.accent}`}>
            <h2>{level.title}</h2>
            <div class="leane-progress-row">
              <span>Progression</span>
              <strong>0%</strong>
            </div>
            <div class="leane-progress" aria-label={`Progression ${level.title}`}>
              <span style="width: 0%"></span>
            </div>
            <div class="leane-level-card__actions">
              <a class="leane-action-tile" href={`/leane/cours#${level.id}`}>
                <LeaneIcon name="book" />
                Cours
              </a>
              <a class="leane-action-tile" href={`/leane/exercices#${level.id}`}>
                <LeaneIcon name="exercises" />
                Exercices
              </a>
              <a class="leane-action-tile" href={`/leane/qcm/${level.id}`}>
                <LeaneIcon name="quiz" />
                QCM
              </a>
              <a class="leane-action-tile" href={`/leane/flashcards#${level.id}`}>
                <LeaneIcon name="cards" />
                Flashcards
              </a>
            </div>
          </section>
        ))}
      </div>
    </article>
  </section>
</LeaneShell>
