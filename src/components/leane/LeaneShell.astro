---
import LeaneIcon from "./LeaneIcon.astro";

interface Props {
  active: "accueil" | "cours" | "exercices" | "qcm" | "flashcards";
  title: string;
  subtitle?: string;
  hideHeading?: boolean;
}

const { active, title, subtitle = "Plan de révision personnalisé", hideHeading = false } = Astro.props;

const navItems = [
  { id: "accueil", label: "Accueil", href: "/leane", icon: "home" },
  { id: "cours", label: "Cours", href: "/leane/cours", icon: "book" },
  { id: "exercices", label: "Exercices", href: "/leane/exercices", icon: "exercises" },
  { id: "qcm", label: "QCM", href: "/leane/qcm", icon: "quiz" },
  { id: "flashcards", label: "Flashcards", href: "/leane/flashcards", icon: "cards" },
] as const;
---

<section class="leane-app" aria-labelledby="leane-page-title">
  <aside class="leane-sidebar" aria-label="Navigation Léane">
    <a class="leane-brand" href="/leane" aria-label="Accueil Léane">
      <span class="leane-brand__mark">L</span>
      <span>
        <strong>Léane</strong>
        <small>Maths · Première</small>
      </span>
    </a>

    <nav class="leane-side-nav" aria-label="Sous-onglets Léane">
      {navItems.map((item) => (
        <a class:list={["leane-side-nav__link", { active: item.id === active }]} href={item.href}>
          <span class="leane-side-nav__icon"><LeaneIcon name={item.icon} /></span>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="leane-week-card" aria-label="Objectif hebdomadaire">
      <div class="leane-week-card__top">
        <span>Objectif hebdomadaire</span>
        <strong>0%</strong>
      </div>
      <div class="leane-week-card__meter" aria-hidden="true">
        <span style="width: 0%"></span>
      </div>
      <div class="leane-week-card__meta">
        <span>0 h / 1 h</span>
        <small>Progression initiale</small>
      </div>
    </div>
  </aside>

  <div class="leane-workspace">
    <header class="leane-topbar">
      <label class="leane-search">
        <LeaneIcon name="search" />
        <span class="sr-only">Rechercher</span>
        <input type="search" placeholder="Rechercher un cours, un exercice..." />
      </label>
      <a class="leane-topbar__pill" href="/leane/flashcards">
        <LeaneIcon name="clock" />
        0 carte maîtrisée
      </a>
    </header>

    <main class="leane-main" id="leane-content">
      {!hideHeading && (
        <div class="leane-page-heading">
          <div>
            <p class="leane-eyebrow">Espace personnel</p>
            <h1 id="leane-page-title">{title}</h1>
            <p>{subtitle}</p>
          </div>
          <a class="leane-action" href="/leane/qcm">
            <LeaneIcon name="quiz" />
            QCM global
          </a>
        </div>
      )}

      <slot />
    </main>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-flashcard]").forEach((card) => {
    if (card.dataset.leaneReady === "true") return;
    card.dataset.leaneReady = "true";
    card.addEventListener("click", () => {
      const pressed = card.getAttribute("aria-pressed") === "true";
      card.setAttribute("aria-pressed", String(!pressed));
      card.classList.toggle("is-flipped", !pressed);
    });
  });

  document.querySelectorAll<HTMLElement>("[data-leane-exercises]").forEach((runner) => {
    if (runner.dataset.leaneReady === "true") return;
    runner.dataset.leaneReady = "true";

    const steps = Array.from(runner.querySelectorAll<HTMLElement>("[data-leane-exercise]"));
    const progress = runner.querySelector<HTMLElement>("[data-leane-exercise-progress]");
    const previous = runner.querySelector<HTMLButtonElement>("[data-leane-exercise-prev]");
    const next = runner.querySelector<HTMLButtonElement>("[data-leane-exercise-next]");
    const reset = runner.querySelector<HTMLButtonElement>("[data-leane-exercise-reset]");
    let index = 0;

    function showStep(nextIndex: number) {
      index = Math.max(0, Math.min(nextIndex, steps.length - 1));
      steps.forEach((step, stepIndex) => {
        step.hidden = stepIndex !== index;
        if (step.hidden) {
          step.querySelectorAll("details").forEach((details) => details.removeAttribute("open"));
        }
      });
      if (progress) progress.textContent = `${index + 1} / ${steps.length}`;
      if (previous) previous.disabled = index === 0;
      if (next) next.disabled = index === steps.length - 1;
    }

    previous?.addEventListener("click", () => showStep(index - 1));
    next?.addEventListener("click", () => showStep(index + 1));
    reset?.addEventListener("click", () => showStep(0));
    showStep(0);
  });

  document.querySelectorAll<HTMLElement>("[data-leane-step-quiz]").forEach((quizRoot) => {
    if (quizRoot.dataset.leaneStepReady === "true") return;
    quizRoot.dataset.leaneStepReady = "true";

    const questions = Array.from(quizRoot.querySelectorAll<HTMLElement>("[data-answer]"));
    const progress = quizRoot.querySelector<HTMLElement>("[data-leane-step-progress]");
    const previous = quizRoot.querySelector<HTMLButtonElement>("[data-leane-step-prev]");
    const next = quizRoot.querySelector<HTMLButtonElement>("[data-leane-step-next]");
    const submit = quizRoot.querySelector<HTMLButtonElement>("[data-leane-step-submit]");
    const reset = quizRoot.querySelector<HTMLButtonElement>("[data-leane-step-reset]");
    const result = quizRoot.querySelector<HTMLElement>("[data-leane-quiz-result]");
    let index = 0;

    function showQuestion(nextIndex: number) {
      index = Math.max(0, Math.min(nextIndex, questions.length - 1));
      questions.forEach((question, questionIndex) => {
        question.hidden = questionIndex !== index;
      });
      if (progress) progress.textContent = `Question ${index + 1} / ${questions.length}`;
      if (previous) previous.disabled = index === 0;
      if (next) next.hidden = index === questions.length - 1;
      if (submit) submit.hidden = index !== questions.length - 1;
    }

    previous?.addEventListener("click", () => showQuestion(index - 1));
    next?.addEventListener("click", () => showQuestion(index + 1));
    reset?.addEventListener("click", () => {
      quizRoot.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((input) => {
        input.checked = false;
      });
      questions.forEach((question) => question.classList.remove("is-correct", "is-wrong"));
      if (result) result.hidden = true;
      showQuestion(0);
    });
    showQuestion(0);
  });

  document.querySelectorAll<HTMLElement>("[data-leane-quiz]").forEach((quizRoot) => {
    const quizResult = quizRoot.querySelector<HTMLElement>("[data-leane-quiz-result]");
    if (!quizResult || quizRoot.dataset.leaneReady === "true") return;

    quizRoot.dataset.leaneReady = "true";
    quizRoot.addEventListener("submit", (event) => {
      event.preventDefault();
      const questions = Array.from(quizRoot.querySelectorAll<HTMLElement>("[data-answer]"));
      let score = 0;

      questions.forEach((question) => {
        const expected = question.dataset.answer;
        const selected = question.querySelector<HTMLInputElement>('input[type="radio"]:checked');
        question.classList.remove("is-correct", "is-wrong");

        if (selected?.value === expected) {
          score += 1;
          question.classList.add("is-correct");
        } else {
          question.classList.add("is-wrong");
        }
      });

      quizResult.textContent = `Score : ${score} / ${questions.length}`;
      quizResult.hidden = false;
    });
  });
</script>

<style is:global>
  .page-container:has(.leane-app) {
    margin: 0;
    max-width: none;
    padding: 0;
  }

  .page-container:has(.leane-app) + footer,
  .site-footer:has(+ .leane-app) {
    display: none;
  }

  body:has(.leane-app) {
    background: #f6f9fe;
  }

  body:has(.leane-app) .public-nav {
    display: none;
  }

  .leane-app .sr-only {
    border: 0;
    clip: rect(0 0 0 0);
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  .leane-app [hidden] {
    display: none !important;
  }

  .leane-app {
    --leane-navy: var(--text-primary, #1a2332);
    --leane-navy-soft: #1e293b;
    --leane-blue: var(--accent-primary, #4f46e5);
    --leane-text: var(--text-primary, #1a2332);
    --leane-muted: var(--text-secondary, #4a5568);
    --leane-border: var(--border-color, #e2e8f0);
    --leane-surface: var(--bg-card, #ffffff);
    color: var(--leane-text);
    display: grid;
    font-family: var(--font-family, "Plus Jakarta Sans", Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
    grid-template-columns: 248px minmax(0, 1fr);
    min-height: 100vh;
  }

  .leane-sidebar {
    background:
      radial-gradient(circle at 24% 10%, rgba(129, 140, 248, 0.22), transparent 34%),
      linear-gradient(180deg, #111827 0%, #1e293b 100%);
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    height: 100vh;
    padding: 1.5rem 0.85rem;
    position: sticky;
    top: 0;
  }

  .leane-brand {
    align-items: center;
    color: inherit;
    display: inline-flex;
    gap: 0.8rem;
    padding: 0 0.7rem;
    text-decoration: none;
  }

  .leane-brand__mark {
    align-items: center;
    background: linear-gradient(135deg, #eef2ff, #c7d2fe);
    border-radius: var(--radius-md, 12px);
    color: var(--accent-primary, #4f46e5);
    display: inline-flex;
    font-size: 1.1rem;
    font-weight: 950;
    height: 42px;
    justify-content: center;
    width: 42px;
  }

  .leane-brand strong,
  .leane-brand small {
    display: block;
  }

  .leane-brand strong {
    font-size: 1.28rem;
    letter-spacing: 0;
  }

  .leane-brand small {
    color: #b9cff0;
    font-size: 0.78rem;
    margin-top: 0.15rem;
  }

  .leane-side-nav {
    display: grid;
    gap: 0.35rem;
  }

  .leane-side-nav__link {
    align-items: center;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #e7f0ff;
    display: flex;
    font-weight: 760;
    gap: 0.75rem;
    min-height: 48px;
    padding: 0.72rem 0.8rem;
    text-decoration: none;
  }

  .leane-side-nav__link:hover,
  .leane-side-nav__link:focus-visible,
  .leane-side-nav__link.active {
    background: linear-gradient(90deg, var(--accent-primary, #4f46e5), var(--accent-secondary, #6366f1));
    box-shadow: 0 12px 26px rgba(0, 20, 60, 0.18);
    color: #ffffff;
  }

  .leane-side-nav__icon {
    align-items: center;
    display: inline-flex;
    height: 24px;
    justify-content: center;
    width: 24px;
  }

  .leane-svg-icon {
    height: 1.25em;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.9;
    width: 1.25em;
  }

  .leane-week-card {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md, 12px);
    display: grid;
    gap: 0.85rem;
    margin-bottom: 4.75rem;
    margin-top: auto;
    min-height: 0;
    overflow: hidden;
    padding: 1rem;
    position: relative;
  }

  .leane-week-card__top {
    align-items: center;
    display: flex;
    gap: 0.75rem;
    justify-content: space-between;
  }

  .leane-week-card__meta {
    display: grid;
    gap: 0.2rem;
  }

  .leane-week-card span,
  .leane-week-card small {
    color: #d8e7ff;
    font-weight: 760;
  }

  .leane-week-card strong {
    color: #ffffff;
    font-size: 2rem;
    line-height: 1;
  }

  .leane-week-card__meta span {
    color: #ffffff;
    white-space: nowrap;
  }

  .leane-week-card__meter {
    background: rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-pill, 999px);
    height: 9px;
    overflow: hidden;
  }

  .leane-week-card__meter span {
    background: linear-gradient(90deg, var(--accent-primary, #4f46e5), var(--accent-success, #10b981));
    display: block;
    height: 100%;
  }

  .leane-workspace {
    min-width: 0;
  }

  .leane-topbar {
    align-items: center;
    background: rgba(255, 255, 255, 0.86);
    border-bottom: 1px solid var(--leane-border);
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding: 1.1rem clamp(1rem, 3vw, 2.8rem);
  }

  .leane-search {
    align-items: center;
    border: 1px solid #cad8ec;
    border-radius: var(--radius-md, 12px);
    color: #55709c;
    display: flex;
    gap: 0.75rem;
    max-width: 720px;
    min-height: 48px;
    padding: 0 1rem;
    width: min(100%, 720px);
  }

  .leane-search input {
    border: 0;
    color: var(--leane-text);
    flex: 1;
    font: inherit;
    min-width: 0;
    outline: 0;
  }

  .leane-topbar__pill,
  .leane-action {
    align-items: center;
    border: 1px solid #cddbef;
    border-radius: var(--radius-md, 12px);
    color: #123d7f;
    display: inline-flex;
    flex: 0 0 auto;
    font-weight: 800;
    gap: 0.55rem;
    min-height: 44px;
    padding: 0.7rem 0.95rem;
    text-decoration: none;
  }

  .leane-main {
    display: grid;
    gap: 1.15rem;
    padding: clamp(1rem, 3vw, 2rem) clamp(1rem, 3vw, 2.8rem) 2.4rem;
  }

  .leane-page-heading {
    align-items: end;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
  }

  .leane-eyebrow {
    color: var(--leane-muted);
    font-size: 0.82rem;
    font-weight: 820;
    margin: 0 0 0.25rem;
    text-transform: uppercase;
  }

  .leane-page-heading h1 {
    color: var(--leane-text);
    font-size: clamp(1.65rem, 3vw, 2.35rem);
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0;
  }

  .leane-page-heading p {
    color: var(--leane-muted);
    margin: 0.35rem 0 0;
  }

  .leane-grid,
  .leane-two-col,
  .leane-stat-grid,
  .leane-card-grid {
    display: grid;
    gap: 1rem;
  }

  .leane-stat-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .leane-two-col {
    align-items: start;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.42fr);
  }

  .leane-card-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .leane-card-grid--courses {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .leane-panel,
  .leane-stat,
  .leane-level-card,
  .leane-course-card,
  .leane-exercise-card,
  .leane-flashcard,
  .leane-question {
    background: var(--leane-surface);
    border: 1px solid var(--leane-border);
    border-radius: var(--radius-md, 12px);
    box-shadow: var(--shadow-card, 0 2px 8px rgba(0, 0, 0, 0.04));
  }

  .leane-question[hidden] {
    display: none;
  }

  .leane-panel,
  .leane-level-card,
  .leane-course-card,
  .leane-exercise-card,
  .leane-question {
    padding: 1.1rem;
  }

  .leane-stat {
    align-items: center;
    display: flex;
    gap: 0.9rem;
    min-height: 112px;
    padding: 1rem;
  }

  .leane-stat__icon {
    align-items: center;
    border: 2px solid currentColor;
    border-radius: 50%;
    display: inline-flex;
    height: 44px;
    justify-content: center;
    width: 44px;
  }

  .leane-stat strong {
    color: var(--leane-text);
    display: block;
    font-size: 1.75rem;
    line-height: 1;
    margin-top: 0.3rem;
  }

  .leane-stat span,
  .leane-stat small,
  .leane-card-muted,
  .leane-panel p,
  .leane-course-card p,
  .leane-exercise-card p {
    color: var(--leane-muted);
  }

  .leane-panel h2,
  .leane-level-card h2,
  .leane-course-card h2,
  .leane-exercise-card h2 {
    font-size: 1.05rem;
    letter-spacing: 0;
    margin: 0 0 0.75rem;
  }

  .leane-level-card {
    border-top: 4px solid var(--level-accent, var(--leane-blue));
    display: grid;
    gap: 0.7rem;
  }

  .leane-level-card > p:not(.leane-card-muted) {
    line-height: 1.42;
    margin: 0;
  }

  .leane-level-card__actions,
  .leane-inline-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .leane-chip {
    align-items: center;
    background: #f4f7fc;
    border: 1px solid #e5edf7;
    border-radius: 6px;
    color: #526b96;
    display: inline-flex;
    font-size: 0.82rem;
    font-weight: 760;
    min-height: 0;
    padding: 0.32rem 0.58rem;
    text-decoration: none;
  }

  .leane-outline-link {
    align-items: center;
    background: #ffffff;
    border: 1px solid #cddbef;
    border-radius: 8px;
    color: #102a5c;
    display: inline-flex;
    font-size: 0.88rem;
    font-weight: 760;
    justify-content: center;
    min-height: 42px;
    padding: 0.62rem 0.95rem;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      box-shadow 160ms ease;
  }

  .leane-primary-link {
    align-items: center;
    background: #2672ff;
    border: 1px solid #2672ff;
    border-radius: 8px;
    color: #ffffff;
    display: inline-flex;
    font-weight: 760;
    justify-content: center;
    min-height: 42px;
    padding: 0.62rem 0.95rem;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .leane-outline-link:hover,
  .leane-outline-link:focus-visible {
    background: #eef5ff;
    border-color: #2672ff;
    color: #2672ff;
    box-shadow: 0 8px 18px rgba(16, 42, 92, 0.06);
  }

  .leane-primary-link:hover,
  .leane-primary-link:focus-visible {
    background: #155ee8;
    border-color: #155ee8;
    box-shadow: 0 10px 22px rgba(38, 114, 255, 0.18);
    transform: translateY(-1px);
  }

  .leane-action-tile {
    align-items: center;
    background: var(--accent-primary-light, #eef2ff);
    border: 1px solid color-mix(in srgb, var(--accent-primary, #4f46e5) 24%, var(--border-color, #e2e8f0));
    border-radius: var(--radius-md, 12px);
    color: var(--accent-primary, #4f46e5);
    display: inline-flex;
    font-size: 0.9rem;
    font-weight: 850;
    gap: 0.45rem;
    justify-content: center;
    min-height: 42px;
    padding: 0.55rem 0.7rem;
    text-decoration: none;
  }

  .leane-action-tile:hover,
  .leane-action-tile:focus-visible {
    background: var(--accent-primary, #4f46e5);
    color: #ffffff;
  }

  .leane-level-card__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .leane-progress {
    background: #e4ebf6;
    border-radius: 999px;
    height: 8px;
    overflow: hidden;
  }

  .leane-progress span {
    background: linear-gradient(90deg, #1aa889, #66dfd3);
    display: block;
    height: 100%;
  }

  .leane-list {
    display: grid;
    gap: 0.7rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .leane-list li {
    border-top: 1px solid #dde7f5;
    display: flex;
    gap: 0.7rem;
    justify-content: space-between;
    padding-top: 0.7rem;
  }

  .leane-course-card ul {
    margin: 0.85rem 0;
    padding-left: 1.2rem;
  }

  .leane-course-card,
  .leane-exercise-card {
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--accent-primary-light, #eef2ff) 42%, #ffffff), #ffffff 34%),
      var(--bg-card, #ffffff);
  }

  .leane-course-card h2,
  .leane-exercise-card h2 {
    font-size: 1.12rem;
  }

  .leane-progress-row {
    align-items: center;
    color: var(--leane-muted);
    display: flex;
    font-size: 0.88rem;
    font-weight: 780;
    justify-content: space-between;
  }

  .leane-progress-row strong {
    color: var(--leane-text);
  }

  .leane-course-practice {
    border-top: 1px solid #dde7f5;
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 1rem;
  }

  .leane-course-practice h3 {
    font-size: 0.92rem;
    letter-spacing: 0;
    margin: 0;
  }

  .leane-practice-grid {
    display: grid;
    gap: 0.65rem;
  }

  .leane-exercise-runner {
    align-content: start;
  }

  .leane-exercise-runner__meta {
    align-items: center;
    color: var(--leane-muted);
    display: flex;
    font-weight: 780;
    justify-content: space-between;
  }

  .leane-exercise-runner__meta small {
    color: var(--leane-muted);
    font-weight: 760;
  }

  .leane-exercise-runner__stack {
    min-height: 15rem;
  }

  .leane-exercise-step {
    display: grid;
    gap: 0.65rem;
  }

  .leane-exercise-step[hidden] {
    display: none;
  }

  .leane-exercise-step h3,
  .leane-exercise-step p {
    margin: 0;
  }

