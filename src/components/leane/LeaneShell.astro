---
import "../../ui-v5/leane.css";
import LeaneIcon from "./LeaneIcon.astro";

interface Props {
  active: "accueil" | "cours" | "exercices" | "qcm" | "flashcards";
  title: string;
  subtitle?: string;
  hideHeading?: boolean;
}

const { active, title, subtitle = "Plan de révision personnalisé", hideHeading = false } = Astro.props;

const navItems = [
  { id: "accueil", label: "Accueil", href: "/leane", icon: "home" },
  { id: "cours", label: "Cours", href: "/leane/cours", icon: "book" },
  { id: "exercices", label: "Exercices", href: "/leane/exercices", icon: "exercises" },
  { id: "qcm", label: "QCM", href: "/leane/qcm", icon: "quiz" },
  { id: "flashcards", label: "Flashcards", href: "/leane/flashcards", icon: "cards" },
] as const;

const activeItem = navItems.find((item) => item.id === active) ?? navItems[0];
---

<section class="ui5-page ui5-leane-page" data-subject="mathematiques" aria-labelledby="leane-page-title">
  <nav class="ui5-breadcrumb" aria-label="Fil d’Ariane">
    <a href="/">Accueil</a><span aria-hidden="true">/</span>
    <a href="/mathematiques">Mathématiques</a><span aria-hidden="true">/</span>
    <a href="/leane">Espace Léane</a>
    {active !== "accueil" && <><span aria-hidden="true">/</span><strong>{activeItem.label}</strong></>}
  </nav>

  {!hideHeading && (
    <header class="ui5-page-header">
      <div class="ui5-page-header__copy">
        <p class="ui5-kicker">Mathématiques · Révisions personnalisées</p>
        <h1 id="leane-page-title" class="ui5-title">{title}</h1>
        <p class="ui5-lead">{subtitle}</p>
      </div>
      <div class="ui5-page-header__aside">
        <a class="ui5-button ui5-button--primary" href="/leane/qcm/global">
          <LeaneIcon name="quiz" />
          QCM global
        </a>
      </div>
    </header>
  )}

  <nav class="ui5-filter-row ui5-leane-nav" aria-label="Navigation Léane">
    {navItems.map((item) => (
      <a
        class="ui5-filter"
        href={item.href}
        aria-current={item.id === active ? "true" : undefined}
      >
        <LeaneIcon name={item.icon} />
        {item.label}
      </a>
    ))}
  </nav>

  <section class="ui5-section ui5-leane-toolbar" aria-label="Recherche et progression">
    <label class="ui5-search">
      <span class="sr-only">Rechercher</span>
      <input type="search" placeholder="Rechercher un cours, un exercice..." />
    </label>
    <a class="ui5-chip ui5-leane-memory" href="/leane/flashcards">
      <LeaneIcon name="clock" />
      0 carte maîtrisée
    </a>
  </section>

  <main class="ui5-section ui5-leane-content" id="leane-content">
    <slot />
  </main>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-flashcard]").forEach((card) => {
    if (card.dataset.leaneReady === "true") return;
    card.dataset.leaneReady = "true";
    card.addEventListener("click", () => {
      const pressed = card.getAttribute("aria-pressed") === "true";
      card.setAttribute("aria-pressed", String(!pressed));
      card.classList.toggle("is-flipped", !pressed);
    });
  });

  document.querySelectorAll<HTMLElement>("[data-leane-exercises]").forEach((runner) => {
    if (runner.dataset.leaneReady === "true") return;
    runner.dataset.leaneReady = "true";

    const steps = Array.from(runner.querySelectorAll<HTMLElement>("[data-leane-exercise]"));
    const progress = runner.querySelector<HTMLElement>("[data-leane-exercise-progress]");
    const previous = runner.querySelector<HTMLButtonElement>("[data-leane-exercise-prev]");
    const next = runner.querySelector<HTMLButtonElement>("[data-leane-exercise-next]");
    const reset = runner.querySelector<HTMLButtonElement>("[data-leane-exercise-reset]");
    let index = 0;

    function showStep(nextIndex: number) {
      index = Math.max(0, Math.min(nextIndex, steps.length - 1));
      steps.forEach((step, stepIndex) => {
        step.hidden = stepIndex !== index;
        if (step.hidden) {
          step.querySelectorAll("details").forEach((details) => details.removeAttribute("open"));
        }
      });
      if (progress) progress.textContent = `${index + 1} / ${steps.length}`;
      if (previous) previous.disabled = index === 0;
      if (next) next.disabled = index === steps.length - 1;
    }

    previous?.addEventListener("click", () => showStep(index - 1));
    next?.addEventListener("click", () => showStep(index + 1));
    reset?.addEventListener("click", () => showStep(0));
    showStep(0);
  });

  document.querySelectorAll<HTMLElement>("[data-leane-step-quiz]").forEach((quizRoot) => {
    if (quizRoot.dataset.leaneStepReady === "true") return;
    quizRoot.dataset.leaneStepReady = "true";

    const questions = Array.from(quizRoot.querySelectorAll<HTMLElement>("[data-answer]"));
    const progress = quizRoot.querySelector<HTMLElement>("[data-leane-step-progress]");
    const previous = quizRoot.querySelector<HTMLButtonElement>("[data-leane-step-prev]");
    const next = quizRoot.querySelector<HTMLButtonElement>("[data-leane-step-next]");
    const submit = quizRoot.querySelector<HTMLButtonElement>("[data-leane-step-submit]");
    const reset = quizRoot.querySelector<HTMLButtonElement>("[data-leane-step-reset]");
    const result = quizRoot.querySelector<HTMLElement>("[data-leane-quiz-result]");
    let index = 0;

    function showQuestion(nextIndex: number) {
      index = Math.max(0, Math.min(nextIndex, questions.length - 1));
      questions.forEach((question, questionIndex) => {
        question.hidden = questionIndex !== index;
      });
      if (progress) progress.textContent = `Question ${index + 1} / ${questions.length}`;
      if (previous) previous.disabled = index === 0;
      if (next) next.hidden = index === questions.length - 1;
      if (submit) submit.hidden = index !== questions.length - 1;
    }

    previous?.addEventListener("click", () => showQuestion(index - 1));
    next?.addEventListener("click", () => showQuestion(index + 1));
    reset?.addEventListener("click", () => {
      quizRoot.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((input) => {
        input.checked = false;
      });
      questions.forEach((question) => question.classList.remove("is-correct", "is-wrong"));
      if (result) result.hidden = true;
      showQuestion(0);
    });
    showQuestion(0);
  });

  document.querySelectorAll<HTMLElement>("[data-leane-quiz]").forEach((quizRoot) => {
    const quizResult = quizRoot.querySelector<HTMLElement>("[data-leane-quiz-result]");
    if (!quizResult || quizRoot.dataset.leaneReady === "true") return;

    quizRoot.dataset.leaneReady = "true";
    quizRoot.addEventListener("submit", (event) => {
      event.preventDefault();
      const questions = Array.from(quizRoot.querySelectorAll<HTMLElement>("[data-answer]"));
      let score = 0;

      questions.forEach((question) => {
        const expected = question.dataset.answer;
        const selected = question.querySelector<HTMLInputElement>('input[type="radio"]:checked');
        question.classList.remove("is-correct", "is-wrong");

        if (selected?.value === expected) {
          score += 1;
          question.classList.add("is-correct");
        } else {
          question.classList.add("is-wrong");
        }
      });

      quizResult.textContent = `Score : ${score} / ${questions.length}`;
      quizResult.hidden = false;
    });
  });
</script>
