{"exercices":[{"id":"relatifs-n1-1","chapterId":"college/5eme/nombres-relatifs","title":"Comparer des relatifs","statement":"Comparer -7,4 et -3,9.","consigne":"Écrire le signe < ou > et justifier avec la droite graduée.","difficulty":1,"difficultyLabel":"N1 — application directe","level":"N1","skills":["comparaison"],"prerequisites":["droite graduée"],"estimatedTime":4,"answerType":"text","hints":{"clue":"Le plus grand est le plus à droite.","method":"Imagine ou trace une droite graduée.","reminder":"Parmi deux négatifs, celui qui est le plus proche de zéro est le plus grand.","commonMistake":"Comparer seulement 7,4 et 3,9."},"correction":["-7,4 est plus à gauche que -3,9.","Donc -7,4 < -3,9."],"commonMistakes":["Oublier le signe négatif."],"access":{"tier":"free","preview":true,"requiresAccount":false},"competences":["représenter","raisonner"],"accessibility":{},"tags":["5eme","N1"]},{"id":"relatifs-n1-2","chapterId":"college/5eme/nombres-relatifs","title":"Addition de relatifs","statement":"Calculer -8 + 13.","consigne":"Calculer en expliquant le signe du résultat.","difficulty":1,"difficultyLabel":"N1 — application directe","level":"N1","skills":["addition"],"prerequisites":["valeur absolue"],"estimatedTime":4,"answerType":"number","hints":{"clue":"Les signes sont différents.","method":"Calcule 13-8.","reminder":"Le nombre de plus grande valeur absolue est positif.","commonMistake":"Additionner 8+13."},"correction":["13-8=5 et 13 a la plus grande valeur absolue.","Donc -8+13=5."],"commonMistakes":["Additionner les valeurs absolues."],"access":{"tier":"free","preview":true,"requiresAccount":false},"competences":["calculer"],"accessibility":{},"tags":["5eme","N1"]},{"id":"relatifs-n2-1","chapterId":"college/5eme/nombres-relatifs","title":"Évolution de température","statement":"La température est -2,5 °C. Elle baisse de 4 °C puis augmente de 7,5 °C. Quelle est la température finale ?","consigne":"Modéliser les deux évolutions par un calcul.","difficulty":2,"difficu