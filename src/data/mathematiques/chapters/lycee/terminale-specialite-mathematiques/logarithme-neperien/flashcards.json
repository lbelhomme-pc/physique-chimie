{
  "cards": [
    {
      "id": "tle-ln-f1",
      "front": "Définition de $\\ln$",
      "back": "$\\ln x=y\\Longleftrightarrow e^y=x$ pour $x>0$."
    },
    {
      "id": "tle-ln-f2",
      "front": "Valeur de $\\ln 1$",
      "back": "$\\ln 1=0$."
    },
    {
      "id": "tle-ln-f3",
      "front": "Valeur de $\\ln e$",
      "back": "$\\ln e=1$."
    },
    {
      "id": "tle-ln-f4",
      "front": "Produit",
      "back": "$\\ln(ab)=\\ln a+\\ln b$ pour $a,b>0$."
    },
    {
      "id": "tle-ln-f5",
      "front": "Quotient",
      "back": "$\\ln(a/b)=\\ln a-\\ln b$ pour $a,b>0$."
    },
    {
      "id": "tle-ln-f6",
      "front": "Puissance",
      "back": "$\\ln(a^n)=n\\ln a$ pour $a>0$."
    },
    {
      "id": "tle-ln-f7",
      "front": "Dérivée",
      "back": "$(\\ln x)'=1/x$ sur $]0,+\\infty[$."
    },
    {
      "id": "tle-ln-f8",
      "front": "Composée",
      "back": "$(\\ln u)'=u'/u$ lorsque $u>0$."
    },
    {
      "id": "tle-ln-f9",
      "front": "Limite en zéro",
      "back": "$\\lim_{x\\to0^+}\\ln x=-\\infty$."
    },
    {
      "id": "tle-ln-f10",
      "front": "Limite en l’infini",
      "back": "$\\lim_{x\\to+\\infty}\\ln x=+\\infty$."
    },
    {
      "id": "tle-ln-f11",
      "front": "Croissance comparée",
      "back": "$\\ln x/x\\to0$ lorsque $x\\to+\\infty$."
    },
    {
      "id": "tle-ln-f12",
      "front": "Inégalité fondamentale",
      "back": "$\\ln x\\leq x-1$ pour tout $x>0$."
    }
  ]
}
