    {
      "id": "tle-trig-f4",
      "front": "Parité de sinus",
      "back": "$\\sin(-x)=-\\sin x$."
    },
    {
      "id": "tle-trig-f5",
      "front": "Parité de cosinus",
      "back": "$\\cos(-x)=\\cos x$."
    },
    {
      "id": "tle-trig-f6",
      "front": "Dérivée de sinus",
      "back": "$(\\sin x)'=\\cos x$."
    },
    {
      "id": "tle-trig-f7",
      "front": "Dérivée de cosinus",
      "back": "$(\\cos x)'=-\\sin x$."
    },
    {
      "id": "tle-trig-f8",
      "front": "Identité fondamentale",
      "back": "$\\cos^2x+\\sin^2x=1$."
    },
    {
      "id": "tle-trig-f9",
      "front": "Équation cosinus",
      "back": "$\\cos x=\\cos a\\Longleftrightarrow x=2k\\pi\\pm a$."
    },
    {
      "id": "tle-trig-f10",
      "front": "Équation sinus",
      "back": "$\\sin x=\\sin a\\Longleftrightarrow x=2k\\pi+a$ ou $x=(2k+1)\\pi-a$."
    },
    {
      "id": "tle-trig-f11",
