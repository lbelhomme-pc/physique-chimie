[
  {
    "id": "eqab-f01",
    "recto": "Définition d’un acide fort",
    "verso": "Un acide fort réagit totalement avec l’eau pour former sa base conjuguée et des ions oxonium."
  },
  {
    "id": "eqab-f02",
    "recto": "Définition d’un acide faible",
    "verso": "Un acide faible réagit partiellement avec l’eau : l’état final est un équilibre."
  },
  {
    "id": "eqab-f03",
    "recto": "Expression de $K_a$ pour $AH/A^-$",
    "verso": "$K_a=\\dfrac{[A^-][H_3O^+]}{[AH]}$"
  },
  {
    "id": "eqab-f04",
    "recto": "Lien entre $K_a$ et $\\mathrm{p}K_a$",
    "verso": "$\\mathrm{p}K_a=-\\log(K_a)$ et $K_a=10^{-\\mathrm{p}K_a}$."
  },
  {
    "id": "eqab-f05",
    "recto": "Effet d’un petit pKa",
    "verso": "Plus le pKa est petit, plus l’acide est fort."
  },
  {
    "id": "eqab-f06",
    "recto": "Produit ionique de l’eau à $25\\ ^\\circ\\mathrm{C}$",
    "verso": "$K_e=[H_3O^+][HO^-]=1,0\\times10^{-14}$ et $\\mathrm{p}K_e=14,0$."
  },
  {
    "id": "eqab-f07",
    "recto": "Critère de prédominance si $\\mathrm{pH}<\\mathrm{p}K_a$",
    "verso": "La forme acide $AH$ prédomine."
  },
  {
    "id": "eqab-f08",
    "recto": "Critère de prédominance si $\\mathrm{pH}>\\mathrm{p}K_a$",
    "verso": "La forme basique $A^-$ prédomine."
  },
  {
    "id": "eqab-f09",
    "recto": "Relation de Henderson-Hasselbalch",
    "verso": "$\\mathrm{pH}=\\mathrm{p}K_a+\\log\\left(\\dfrac{[A^-]}{[AH]}\\right)$."
  },
  {
    "id": "eqab-f10",
    "recto": "Espèce amphotère",
    "verso": "Espèce qui peut se comporter comme un acide dans un couple et comme une base dans un autre."
  },
  {
    "id": "eqab-f11",
    "recto": "Zone de virage d’un indicateur",
    "verso": "Intervalle de pH dans lequel les deux formes colorées coexistent et la couleur observée change."
  },
  {
    "id": "eqab-f12",
    "recto": "Taux de dissociation d’un acide faible",
    "verso": "Pour un acide faible de concentration $C$, on peut écrire $\\tau=h/C$ avec $h=[H_3O^+]$ si l’eau est négligée."
  }
]