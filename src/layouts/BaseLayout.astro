---
// src/layouts/BaseLayout.astro
// Layout principal - SEO complet, navigation, footer, accessibilite

import A11yHeadBootstrap from "../components/accessibility/A11yHeadBootstrap.astro";
import GlobalClientTools from "../components/ui/GlobalClientTools.astro";
import PublicNavigationV3 from "../components/navigation/PublicNavigationV3.astro";
import {
  getSubjectContextFromPath,
  type CycleContext,
  type SubjectId,
} from "../components/navigation/SubjectContext";
import { absoluteSiteUrl, buildPageJsonLd, pageDescription, resolveRobotsContent, siteConfig } from "../config/site";
import "katex/dist/katex.min.css";
import "../styles/design-system.css";
import "../styles/landing-v3.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schemaType?: string;
  noindex?: boolean;
  subject?: SubjectId;
  cycle?: CycleContext;
  level?: string;
  resourceType?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = siteConfig.assets.ogImage,
  schemaType,
  noindex = false,
  subject,
  cycle,
  level,
  resourceType,
} = Astro.props;

const currentPath = Astro.url.pathname;
const inferredContext = getSubjectContextFromPath(currentPath);
const layoutContext = {
  subject: subject ?? inferredContext.subject,
  cycle: cycle ?? inferredContext.cycle,
  level: level ?? inferredContext.level,
  resourceType: resourceType ?? inferredContext.resourceType,
};
const resolvedDescription = pageDescription(description, title, currentPath);
const fullUrl = absoluteSiteUrl(canonical ?? currentPath);
const ogImageUrl = absoluteSiteUrl(ogImage);
const robotsContent = resolveRobotsContent(noindex);

const structuredData = buildPageJsonLd({
  title,
  description: resolvedDescription,
  canonicalUrl: fullUrl,
  schemaType,
  subject: layoutContext.subject,
  cycle: layoutContext.cycle,
  level: layoutContext.level,
  resourceType: layoutContext.resourceType,
  imageUrl: ogImageUrl,
});
---
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="y44vuLGgCaC335VInOitEnR_kM2BXXqStiPExqDUNyw" />
  
  <!-- SEO de base -->
  <title>{title}</title>
  <meta name="description" content={resolvedDescription}>
  <link rel="canonical" href={fullUrl}>
  <meta name="robots" content={robotsContent}>

  <!-- Open Graph (Facebook, LinkedIn, WhatsApp) -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={resolvedDescription}>
  <meta property="og:url" content={fullUrl}>
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:site_name" content={siteConfig.name}>
  <meta property="og:locale" content="fr_FR">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={resolvedDescription}>
  <meta name="twitter:image" content={ogImageUrl}> 

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href={siteConfig.assets.faviconSvg}>
  <link rel="icon" href={siteConfig.assets.faviconIco} sizes="any">
  <link rel="apple-touch-icon" sizes="192x192" href={siteConfig.assets.appleTouchIcon}>

  <!-- Theme color (barre d'adresse mobile) -->
  <meta name="theme-color" content={siteConfig.pwa.themeColor}>
  <meta name="apple-mobile-web-app-status-bar-style" content="default">

  <!-- Schema.org JSON-LD -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <A11yHeadBootstrap />

  <link rel="manifest" href={siteConfig.assets.manifest}>
  <style>
    .analytics-consent {
      position: fixed;
      right: 1rem;
      bottom: 1rem;
      z-index: 1000;
      display: grid;
      gap: 0.75rem;
      width: min(28rem, calc(100vw - 2rem));
      padding: 1rem;
      border: 1px solid color-mix(in srgb, var(--accent-primary) 22%, transparent);
      border-radius: var(--radius-md);
      background: var(--surface-elevated, #fff);
      box-shadow: var(--shadow-lg, 0 18px 40px rgba(15, 23, 42, 0.16));
      color: var(--text-primary, #111827);
      font-size: 0.92rem;
    }

    .analytics-consent[hidden] {
      display: none;
    }

    .analytics-consent p {
      margin: 0;
    }

    .analytics-consent__actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.5rem;
    }

    .analytics-consent button {
      border: 1px solid var(--accent-primary);
      border-radius: var(--radius-sm);
      padding: 0.45rem 0.75rem;
      background: #fff;
      color: var(--accent-primary);
      font-weight: 700;
      cursor: pointer;
    }

    .analytics-consent button[data-analytics-consent="granted"] {
      background: var(--accent-primary);
      color: #fff;
    }

    @media (max-width: 420px) {
      .analytics-consent {
        bottom: 0.75rem;
        left: 0.75rem;
        right: 0.75rem;
        width: auto;
      }

      .analytics-consent__actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }

      .analytics-consent button {
        min-height: 44px;
        min-width: 0;
      }
    }

    .site-header {
      background: color-mix(in srgb, var(--bg-card) 94%, transparent);
      border-bottom: 1px solid var(--border-color);
      position: sticky;
      top: 0;
      z-index: 90;
    }

    .site-header__inner {
      align-items: center;
      display: grid;
      gap: 0.8rem;
      grid-template-columns: auto minmax(0, 1fr) auto;
      margin: 0 auto;
      max-width: 1180px;
      padding: 0.7rem 1rem;
    }

    .site-brand {
      align-items: center;
      color: var(--text-primary);
      display: inline-flex;
      font-weight: 950;
      gap: 0.55rem;
      min-height: 44px;
      text-decoration: none;
      white-space: nowrap;
    }

    .site-brand__mark {
      align-items: center;
      background: var(--accent-primary);
      border-radius: 50%;
      color: #fff;
      display: inline-flex;
      font-size: 0.9rem;
      font-weight: 950;
      height: 34px;
      justify-content: center;
      width: 34px;
    }

    .site-header__nav {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      justify-content: flex-end;
    }

    .site-header__link {
      align-items: center;
      border-radius: var(--radius-pill);
      color: var(--text-secondary);
      display: inline-flex;
      font-size: 0.86rem;
      font-weight: 850;
      min-height: 44px;
      padding: 0.48rem 0.72rem;
      text-decoration: none;
    }

    .site-header__link.active {
      background: var(--bg-secondary);
      color: var(--accent-primary);
    }

    .site-header__link:hover,
    .site-header__link:focus-visible,
    .site-brand:focus-visible {
      box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--accent-primary) 48%, transparent);
      outline: none;
    }

    .site-context {
      background: var(--bg-secondary);
      border-top: 1px solid var(--border-color);
      color: var(--text-secondary);
      font-size: 0.82rem;
      font-weight: 750;
      padding: 0.35rem 1rem;
      text-align: center;
    }

    .site-context strong {
      color: var(--text-primary);
    }

    .skip-link {
      background: var(--accent-primary);
      color: #fff;
      left: 1rem;
      padding: 0.6rem 0.85rem;
      position: fixed;
      top: 0.75rem;
      transform: translateY(-160%);
      z-index: 1001;
    }

    .skip-link:focus {
      transform: translateY(0);
    }

    @media (max-width: 860px) {
      .site-header__inner {
        grid-template-columns: 1fr;
      }

      .site-header__nav {
        justify-content: flex-start;
      }

      .site-header__link {
        flex: 1 1 auto;
        justify-content: center;
      }
    }

    .site-footer {
      background: #061d59;
      border-top: 4px solid transparent;
      border-image: linear-gradient(90deg, #1765ff 0 32%, #7050ee 32% 54%, #08a88a 54% 76%, #ff7a1a 76%) 1;
      color: #ffffff;
      margin-top: 0;
      padding: 0;
      text-align: left;
    }

    .site-footer__inner {
      display: grid;
      gap: 2.5rem;
      grid-template-columns: minmax(240px, 1.35fr) repeat(3, minmax(150px, 0.75fr));
      margin: 0 auto;
      max-width: 1180px;
      padding: 3rem 1.25rem 2.25rem;
    }

    .site-footer__intro {
      align-content: start;
      display: grid;
      gap: 1rem;
      max-width: 32ch;
    }

    .site-footer__brand {
      align-items: center;
      color: #ffffff;
      display: inline-flex;
      font-size: 1rem;
      font-weight: 950;
      gap: 0.65rem;
      margin: 0;
      padding: 0;
      text-decoration: none;
    }

    .site-footer__brand-mark {
      align-items: center;
      background: #1765ff;
      border-radius: 50%;
      display: inline-flex;
      flex: 0 0 auto;
      height: 38px;
      justify-content: center;
      width: 38px;
    }

    .site-footer__intro p {
      color: #cdd8f0;
      font-size: 0.88rem;
      line-height: 1.65;
      margin: 0;
    }

    .site-footer nav {
      align-content: start;
      display: grid;
      gap: 0.85rem;
    }

    .site-footer h2 {
      color: #ffffff;
      font-size: 0.78rem;
      font-weight: 900;
      letter-spacing: 0;
      margin: 0;
      text-transform: uppercase;
    }

    .site-footer ul {
      display: grid;
      gap: 0.45rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .site-footer a {
      background: transparent;
      border: 0;
      border-radius: 0;
      color: #dbe5f8;
      font-size: 0.86rem;
      font-weight: 700;
      margin: 0;
      padding: 0.25rem 0;
      text-decoration: none;
    }

    .site-footer a:hover {
      color: #ffffff;
      text-decoration: underline;
      text-decoration-color: #65d9c4;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }

    .site-footer a:focus-visible {
      border-radius: 4px;
      box-shadow: 0 0 0 3px rgba(101, 217, 196, 0.42);
      outline: none;
    }

    .site-footer__bottom {
      align-items: center;
      border-top: 1px solid rgba(219, 229, 248, 0.18);
      display: flex;
      gap: 1rem;
      justify-content: space-between;
      margin: 0 auto;
      max-width: 1180px;
      padding: 1.1rem 1.25rem 1.35rem;
    }

    .site-footer__bottom p {
      color: #aebddd;
      font-size: 0.78rem;
      margin: 0;
    }

    .site-footer__bottom strong {
      color: #ffffff;
    }

    @media (max-width: 820px) {
      .site-footer__inner {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 520px) {
      .site-footer__inner {
        gap: 2rem;
        grid-template-columns: 1fr;
        padding: 2.25rem 1.25rem 1.75rem 4.75rem;
      }

      .site-footer__bottom {
        align-items: flex-start;
        flex-direction: column;
        gap: 0.35rem;
        padding-left: 4.75rem;
      }
    }
  </style>
</head>
<body>

  <PublicNavigationV3
    currentPath={currentPath}
    subject={layoutContext.subject}
    cycle={layoutContext.cycle}
    level={layoutContext.level}
    resourceType={layoutContext.resourceType}
  />
  <!-- Contenu principal -->
  <main id="main-content" class="page-container">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="site-footer" id="apropos">
    <div class="site-footer__inner">
      <div class="site-footer__intro">
        <a class="site-footer__brand" href="/" aria-label="Retour à l'accueil">
          <span class="site-footer__brand-mark" aria-hidden="true">R</span>
          <span>Révisions PC Maths</span>
        </a>
        <p>Révisions scientifiques du collège au lycée.</p>
      </div>

      <nav aria-label="Disciplines">
        <h2>Disciplines</h2>
        <ul>
          <li><a href="/mathematiques">Mathématiques</a></li>
          <li><a href="/college">Physique-Chimie</a></li>
          <li><a href="/lycee/1ere-ens-scientifique">Enseignement scientifique</a></li>
        </ul>
      </nav>

      <nav aria-label="Ressources">
        <h2>Ressources</h2>
        <ul>
          <li><a href="/memorisation/mega-quiz">QCM et quiz</a></li>
          <li><a href="/memorisation/mega-flashcards">Flashcards</a></li>
          <li><a href="/laboratoire">Laboratoire virtuel</a></li>
          <li><a href="/outils-methodes">Méthodes et outils</a></li>
        </ul>
      </nav>

      <nav aria-label="Espace personnel et contact">
        <h2>Espace personnel</h2>
        <ul>
          <li><a href="/profil">Compte</a></li>
          <li><a href={`mailto:${siteConfig.author.email}`}>Nous contacter</a></li>
        </ul>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p>&copy; 2024 - 2026 <strong>{siteConfig.author.name}</strong></p>
      <p>Tous droits réservés</p>
    </div>
  </footer>

  <div id="analytics-consent" class="analytics-consent" hidden>
    <p>
      Mesure d'audience anonyme : accepter permet de charger Google Analytics. Le refus n'empêche aucune fonctionnalité.
    </p>
    <div class="analytics-consent__actions">
      <button type="button" data-analytics-consent="denied">Refuser</button>
      <button type="button" data-analytics-consent="granted">Accepter</button>
    </div>
  </div>

  <!-- Outils globaux C16 : natifs, panneau accessibilité chargé à la demande -->
  <GlobalClientTools />

  <script
    is:inline
    define:vars={{
      measurementId: siteConfig.analytics.googleMeasurementId,
      consentStorageKey: siteConfig.analytics.consentStorageKey,
      grantedValue: siteConfig.analytics.consentGrantedValue,
      deniedValue: siteConfig.analytics.consentDeniedValue,
    }}
  >
    (() => {
      const banner = document.getElementById("analytics-consent");
      const hasStorage = (() => {
        try {
          localStorage.setItem("__analytics_probe__", "1");
          localStorage.removeItem("__analytics_probe__");
          return true;
        } catch {
          return false;
        }
      })();

      const readConsent = () => {
        if (!hasStorage) return deniedValue;
        return localStorage.getItem(consentStorageKey);
      };

      const writeConsent = (value) => {
        if (hasStorage) localStorage.setItem(consentStorageKey, value);
      };

      const loadAnalytics = () => {
        if (!measurementId || window.__siteAnalyticsLoaded) return;
        window.__siteAnalyticsLoaded = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function gtag(...args) {
          window.dataLayer.push(args);
        };
        window.gtag("js", new Date());
        window.gtag("config", measurementId, { anonymize_ip: true });

        const script = document.createElement("script");
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
        document.head.appendChild(script);
      };

      const consent = readConsent();
      if (consent === grantedValue) {
        loadAnalytics();
        return;
      }
      if (consent !== deniedValue && banner) {
        banner.hidden = false;
      }

      banner?.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        const value = target.dataset.analyticsConsent;
        if (value !== grantedValue && value !== deniedValue) return;
        writeConsent(value);
        banner.hidden = true;
        if (value === grantedValue) loadAnalytics();
      });
    })();
  </script>

</body>
</html>
