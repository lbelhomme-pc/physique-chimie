---
// src/layouts/BaseLayout.astro
// Layout principal - SEO complet, navigation, footer, accessibilite

import A11yHeadBootstrap from "../components/accessibility/A11yHeadBootstrap.astro";
import GlobalClientTools from "../components/ui/GlobalClientTools.astro";
import PublicNavigationV3 from "../components/navigation/PublicNavigationV3.astro";
import {
  getSubjectContextFromPath,
  type CycleContext,
  type SubjectId,
} from "../components/navigation/SubjectContext";
import { absoluteSiteUrl, buildPageJsonLd, pageDescription, resolveRobotsContent, siteConfig } from "../config/site";
import "katex/dist/katex.min.css";
import "../ui-v5/index.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schemaType?: string;
  noindex?: boolean;
  subject?: SubjectId;
  cycle?: CycleContext;
  level?: string;
  resourceType?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = siteConfig.assets.ogImage,
  schemaType,
  noindex = false,
  subject,
  cycle,
  level,
  resourceType,
} = Astro.props;

const currentPath = Astro.url.pathname;
const inferredContext = getSubjectContextFromPath(currentPath);
const layoutContext = {
  subject: subject ?? inferredContext.subject,
  cycle: cycle ?? inferredContext.cycle,
  level: level ?? inferredContext.level,
  resourceType: resourceType ?? inferredContext.resourceType,
};
const resolvedDescription = pageDescription(description, title, currentPath);
const fullUrl = absoluteSiteUrl(canonical ?? currentPath);
const ogImageUrl = absoluteSiteUrl(ogImage);
const robotsContent = resolveRobotsContent(noindex);

const structuredData = buildPageJsonLd({
  title,
  description: resolvedDescription,
  canonicalUrl: fullUrl,
  schemaType,
  subject: layoutContext.subject,
  cycle: layoutContext.cycle,
  level: layoutContext.level,
  resourceType: layoutContext.resourceType,
  imageUrl: ogImageUrl,
});
---
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="y44vuLGgCaC335VInOitEnR_kM2BXXqStiPExqDUNyw" />

  <!-- SEO de base -->
  <title>{title}</title>
  <meta name="description" content={resolvedDescription}>
  <link rel="canonical" href={fullUrl}>
  <meta name="robots" content={robotsContent}>

  <!-- Open Graph (Facebook, LinkedIn, WhatsApp) -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={resolvedDescription}>
  <meta property="og:url" content={fullUrl}>
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:site_name" content={siteConfig.name}>
  <meta property="og:locale" content="fr_FR">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={resolvedDescription}>
  <meta name="twitter:image" content={ogImageUrl}>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href={siteConfig.assets.faviconSvg}>
  <link rel="icon" href={siteConfig.assets.faviconIco} sizes="any">
  <link rel="apple-touch-icon" sizes="192x192" href={siteConfig.assets.appleTouchIcon}>

  <!-- Theme color (barre d'adresse mobile) -->
  <meta name="theme-color" content={siteConfig.pwa.themeColor}>
  <meta name="apple-mobile-web-app-status-bar-style" content="default">

  <!-- Schema.org JSON-LD -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <A11yHeadBootstrap />

  <link rel="manifest" href={siteConfig.assets.manifest}>
</head>
<body>

  <PublicNavigationV3
    currentPath={currentPath}
    subject={layoutContext.subject}
    cycle={layoutContext.cycle}
    level={layoutContext.level}
    resourceType={layoutContext.resourceType}
  />
  <!-- Contenu principal -->
  <main id="main-content" class="page-container">
    <slot />
  </main>

  <!-- Footer V5 -->
  <footer class="ui5-footer" id="apropos">
    <div class="ui5-footer__inner">
      <div class="ui5-footer__intro">
        <a class="ui5-footer__brand" href="/" aria-label="Retour à l'accueil">
          <span class="ui5-nav__mark" aria-hidden="true">R</span>
          <span><strong>Révisions PC Maths</strong><small>Sciences et mathématiques</small></span>
        </a>
        <p>Une interface unique pour apprendre, s’entraîner et réviser du collège au lycée.</p>
      </div>

      <nav aria-label="Disciplines">
        <h2>Disciplines</h2>
        <a href="/mathematiques">Mathématiques</a>
        <a href="/physique-chimie">Physique-Chimie</a>
        <a href="/lycee/1ere-ens-scientifique">Enseignement scientifique</a>
      </nav>

      <nav aria-label="Ressources">
        <h2>Ressources</h2>
        <a href="/memorisation/mega-quiz">QCM et quiz</a>
        <a href="/memorisation/mega-flashcards">Flashcards</a>
        <a href="/laboratoire">Laboratoire</a>
        <a href="/outils-methodes">Outils et méthodes</a>
      </nav>

      <nav aria-label="Espace personnel">
        <h2>Espace personnel</h2>
        <a href="/profil">Compte</a>
        <a href={`mailto:${siteConfig.author.email}`}>Nous contacter</a>
      </nav>
    </div>
    <div class="ui5-footer__bottom">
      <span>© 2024–2026 {siteConfig.author.name}</span>
      <span>Tous droits réservés</span>
    </div>
  </footer>

  <div id="analytics-consent" class="analytics-consent" hidden>
    <p>
      Mesure d'audience anonyme : accepter permet de charger Google Analytics. Le refus n'empêche aucune fonctionnalité.
    </p>
    <div class="analytics-consent__actions">
      <button type="button" data-analytics-consent="denied">Refuser</button>
      <button type="button" data-analytics-consent="granted">Accepter</button>
    </div>
  </div>

  <!-- Outils globaux C16 : natifs, panneau accessibilité chargé à la demande -->
  <GlobalClientTools />

  <script
    is:inline
    define:vars={{
      measurementId: siteConfig.analytics.googleMeasurementId,
      consentStorageKey: siteConfig.analytics.consentStorageKey,
      grantedValue: siteConfig.analytics.consentGrantedValue,
      deniedValue: siteConfig.analytics.consentDeniedValue,
    }}
  >
    (() => {
      const banner = document.getElementById("analytics-consent");
      const hasStorage = (() => {
        try {
          localStorage.setItem("__analytics_probe__", "1");
          localStorage.removeItem("__analytics_probe__");
          return true;
        } catch {
          return false;
        }
      })();

      const readConsent = () => {
        if (!hasStorage) return deniedValue;
        return localStorage.getItem(consentStorageKey);
      };

      const writeConsent = (value) => {
        if (hasStorage) localStorage.setItem(consentStorageKey, value);
      };

      const loadAnalytics = () => {
        if (!measurementId || window.__siteAnalyticsLoaded) return;
        window.__siteAnalyticsLoaded = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function gtag(...args) {
          window.dataLayer.push(args);
        };
        window.gtag("js", new Date());
        window.gtag("config", measurementId, { anonymize_ip: true });

        const script = document.createElement("script");
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
        document.head.appendChild(script);
      };

      const consent = readConsent();
      if (consent === grantedValue) {
        loadAnalytics();
        return;
      }
      if (consent !== deniedValue && banner) {
        banner.hidden = false;
      }

      banner?.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        const value = target.dataset.analyticsConsent;
        if (value !== grantedValue && value !== deniedValue) return;
        writeConsent(value);
        banner.hidden = true;
        if (value === grantedValue) loadAnalytics();
      });
    })();
  </script>

</body>
</html>
